Dialogue: 1,0:18:09.39,0:18:11.11,Default,,0,0,0,,O quê? Mãe, essa criança não vai entrar aqui!
Dialogue: 0,0:18:11.07,0:18:13.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:11.19,0:18:12.91,Default,,0,0,0,,O pai dele... veja como ele reagiu!
Dialogue: 0,0:18:12.87,0:18:14.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:12.99,0:18:14.31,Default,,0,0,0,,Ele não pode ver o pai nesse estado.
Dialogue: 0,0:18:14.27,0:18:15.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:14.39,0:18:15.83,Default,,0,0,0,,Mãe, não faça isso!
Dialogue: 0,0:18:15.79,0:18:18.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:15.91,0:18:18.59,Default,,0,0,0,,Mãe, ele é só uma criança pequena, não faça isso!
Dialogue: 0,0:18:18.55,0:18:21.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:18.67,0:18:20.96,Default,,0,0,0,,Deniz, Deniz, venha cá com a vovó, venha!
Dialogue: 0,0:18:20.92,0:18:22.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:21.04,0:18:22.68,Default,,0,0,0,,Venha falar com o seu pai.
Dialogue: 0,0:18:22.64,0:18:24.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:22.76,0:18:24.80,Default,,0,0,0,,Não tem nada a ver, juro que isso não tem nada a ver!
Dialogue: 0,0:18:24.76,0:18:26.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:24.88,0:18:26.08,Default,,0,0,0,,Não pode ser, não vai levar o menino!
Dialogue: 0,0:18:26.04,0:18:27.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:26.16,0:18:27.64,Default,,0,0,0,,Mãe, essa criança não vai entrar aqui!
Dialogue: 0,0:18:27.62,0:18:30.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:27.74,0:18:29.96,Default,,0,0,0,,Ele não pode ver o pai nesse estado!
Dialogue: 0,0:18:31.94,0:18:34.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:32.06,0:18:34.04,Default,,0,0,0,,Ele não vai ver o pai assim!
Dialogue: 0,0:18:34.00,0:18:36.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:34.12,0:18:35.96,Default,,0,0,0,,Ele vai chamar o pai dele!
Dialogue: 0,0:18:36.20,0:18:37.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:36.32,0:18:37.66,Default,,0,0,0,,Vai pedir para ele voltar!
Dialogue: 0,0:18:37.74,0:18:38.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:37.86,0:18:38.48,Default,,0,0,0,,Chame o meu neto!
Dialogue: 0,0:18:38.62,0:18:39.69,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:38.74,0:18:39.54,Default,,0,0,0,,Traga o meu neto aqui!
Dialogue: 0,0:18:39.22,0:18:41.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:39.34,0:18:41.24,Default,,0,0,0,,Não! Ele não pode ver o pai assim! Ficou maluca?!
Dialogue: 0,0:18:41.20,0:18:42.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:41.32,0:18:42.42,Default,,0,0,0,,Eu já disse que não!
Dialogue: 0,0:18:43.40,0:18:44.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:43.52,0:18:44.08,Default,,0,0,0,,Solte-o!
Dialogue: 0,0:18:44.30,0:18:45.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:44.42,0:18:45.31,Default,,0,0,0,,Eu não permito!
Dialogue: 0,0:18:45.63,0:18:47.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:45.75,0:18:47.39,Default,,0,0,0,,Quem é você para não permitir?!
Dialogue: 0,0:18:47.37,0:18:48.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:47.49,0:18:48.17,Default,,0,0,0,,Eu sou a mãe dele!
Dialogue: 0,0:18:48.52,0:18:50.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:48.64,0:18:49.86,Default,,0,0,0,,Deixe de bobagem, não tem nada disso!
Dialogue: 0,0:18:50.04,0:18:50.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:50.16,0:18:50.84,Default,,0,0,0,,Eu vou levar o menino!
Dialogue: 0,0:18:50.84,0:18:51.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:50.96,0:18:51.26,Default,,0,0,0,,Saiam daqui!
Dialogue: 0,0:18:51.50,0:18:52.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:51.62,0:18:52.22,Default,,0,0,0,,Cala a boca!
Dialogue: 0,0:18:52.88,0:18:53.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:53.00,0:18:53.24,Default,,0,0,0,,Calma.
Dialogue: 0,0:18:53.78,0:18:54.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:53.90,0:18:54.40,Default,,0,0,0,,Fique calma.
Dialogue: 0,0:18:54.52,0:18:55.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:54.64,0:18:55.44,Default,,0,0,0,,Tudo bem, tenha calma.
Dialogue: 0,0:18:55.16,0:18:59.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:18:55.28,0:18:59.33,Default,,0,0,0,,Ele mexeu o dedo, mexeu o dedo por causa do meu neto!
Dialogue: 0,0:19:02.18,0:19:03.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:02.30,0:19:03.70,Default,,0,0,0,,Calma, tem gente demais aqui dentro.
Dialogue: 0,0:19:03.66,0:19:04.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:03.78,0:19:04.70,Default,,0,0,0,,Calma, o quarto está muito cheio.
Dialogue: 0,0:19:04.66,0:19:05.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:04.78,0:19:05.70,Default,,0,0,0,,É só um reflexo involuntário.
Dialogue: 0,0:19:05.66,0:19:06.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:05.78,0:19:06.70,Default,,0,0,0,,Kaya...
Dialogue: 0,0:19:06.66,0:19:07.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:06.78,0:19:07.58,Default,,0,0,0,,Kaya, Nare...
Dialogue: 0,0:19:07.16,0:19:08.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:07.28,0:19:08.70,Default,,0,0,0,,Saiam, o que está acontecendo aqui?
Dialogue: 0,0:19:08.66,0:19:10.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:08.78,0:19:10.20,Default,,0,0,0,,Chega, está muito cheio aqui.
Dialogue: 0,0:19:10.16,0:19:11.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:10.28,0:19:11.20,Default,,0,0,0,,Pronto, fechem a porta.
Dialogue: 0,0:19:11.16,0:19:13.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:11.28,0:19:13.20,Default,,0,0,0,,Dursun, ele ouviu a voz dele.
Dialogue: 0,0:19:13.16,0:19:14.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:13.28,0:19:14.20,Default,,0,0,0,,Cihan, Cihan...
Dialogue: 0,0:19:14.16,0:19:15.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:14.28,0:19:15.18,Default,,0,0,0,,Mãe, de jeito nenhum.
Dialogue: 0,0:19:15.14,0:19:17.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:15.26,0:19:17.06,Default,,0,0,0,,Alya...
Dialogue: 0,0:19:25.22,0:19:28.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:25.34,0:19:27.86,Default,,0,0,0,,Diga, fale para o Yalçın também, mande embora!
Dialogue: 0,0:19:27.82,0:19:31.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:27.94,0:19:31.79,Default,,0,0,0,,Meu Deus, ó meu Senhor, acolhei as minhas orações.
Dialogue: 0,0:19:37.16,0:19:40.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:37.28,0:19:40.55,Default,,0,0,0,,Acolhei as minhas preces, que o meu filho se levante e caminhe!
Dialogue: 0,0:19:40.51,0:19:42.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:40.63,0:19:42.75,Default,,0,0,0,,Que ele se levante, o meu menino...
Dialogue: 0,0:19:42.71,0:19:44.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:42.83,0:19:44.63,Default,,0,0,0,,...que se recupere! Que saia por esta porta...
Dialogue: 0,0:19:44.59,0:19:46.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:44.71,0:19:46.71,Default,,0,0,0,,...me chamando de 'Mãe' e saia andando!
Dialogue: 0,0:19:46.69,0:19:48.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:46.81,0:19:48.43,Default,,0,0,0,,Meu Deus, por favor, ó Pai misericordioso...
Dialogue: 0,0:19:48.39,0:19:52.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:48.51,0:19:51.98,Default,,0,0,0,,...atenda à minha oração. Meu irmão... meu irmão...
Dialogue: 0,0:19:53.32,0:19:55.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:53.44,0:19:55.14,Default,,0,0,0,,A reação que o Boran teve...
Dialogue: 0,0:19:55.10,0:19:57.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:55.22,0:19:57.16,Default,,0,0,0,,...foi apenas um reflexo involuntário. Ou seja, não veio...
Dialogue: 0,0:19:57.12,0:19:59.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:57.24,0:19:59.70,Default,,0,0,0,,...de um comando consciente do cérebro, mas sim de um reflexo...
Dialogue: 0,0:19:59.66,0:20:02.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:19:59.78,0:20:02.41,Default,,0,0,0,,...medular ou espasmo muscular involuntário.
Dialogue: 0,0:20:02.37,0:20:04.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:02.49,0:20:04.57,Default,,0,0,0,,Como assim, não teve nenhuma evolução?
Dialogue: 0,0:20:04.87,0:20:06.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:04.99,0:20:06.33,Default,,0,0,0,,Infelizmente não. — O que você está dizendo?! Nós...
Dialogue: 0,0:20:06.29,0:20:08.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:06.41,0:20:08.37,Default,,0,0,0,,...vimos com os nossos próprios olhos! 'Papai'...
Dialogue: 0,0:20:08.33,0:20:10.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:08.45,0:20:10.72,Default,,0,0,0,,...o menino chamou! O filho dele o chamou!
Dialogue: 0,0:20:10.68,0:20:12.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:10.80,0:20:12.64,Default,,0,0,0,,E o dedo dele se mexeu!
Dialogue: 0,0:20:13.18,0:20:17.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:13.30,0:20:17.47,Default,,0,0,0,,Dona Sadakat, isso não aconteceu porque ele ouviu. O Boran não tem capacidade de ouvir.
Dialogue: 0,0:20:17.43,0:20:20.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:17.55,0:20:20.50,Default,,0,0,0,,Como assim não pode ouvir?! É essa mulher que está te mandando dizer isso, não é?!
Dialogue: 0,0:20:20.46,0:20:22.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:20.58,0:20:22.42,Default,,0,0,0,,Essa mulher está manipulando você! Vocês todos viram, não viram?!
Dialogue: 0,0:20:22.38,0:20:25.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:22.50,0:20:25.50,Default,,0,0,0,,Dona Sadakat, eu sinto muito, mas esta é a realidade clínica.
Dialogue: 0,0:20:25.46,0:20:28.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:25.58,0:20:28.64,Default,,0,0,0,,A realidade é essa?! Eu vou te mostrar, Yalçın!
Dialogue: 0,0:20:28.60,0:20:32.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:28.72,0:20:32.18,Default,,0,0,0,,A realidade nós vimos com os nossos olhos! A mão dele se mexeu!
Dialogue: 0,0:20:32.14,0:20:35.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:32.26,0:20:35.64,Default,,0,0,0,,Ele ouviu a voz do filho dele, a mão do meu menino se mexeu!
Dialogue: 0,0:20:35.60,0:20:37.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:35.72,0:20:37.46,Default,,0,0,0,,Eu vou provar para vocês! Cihan!
Dialogue: 0,0:20:37.42,0:20:38.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:37.54,0:20:38.70,Default,,0,0,0,,Eu vou provar para todos vocês!
Dialogue: 0,0:20:38.66,0:20:40.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:38.78,0:20:40.51,Default,,0,0,0,,Onde você está, Cihan?!
Dialogue: 0,0:20:40.47,0:20:41.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:40.59,0:20:41.39,Default,,0,0,0,,Não grite!
Dialogue: 0,0:20:41.35,0:20:42.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:41.47,0:20:42.27,Default,,0,0,0,,Mãe!
Dialogue: 0,0:20:41.91,0:20:43.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:42.03,0:20:43.15,Default,,0,0,0,,Mamãe!
Dialogue: 0,0:20:43.11,0:20:44.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:43.23,0:20:44.61,Default,,0,0,0,,Venha com a vovó, venha...
Dialogue: 0,0:20:44.57,0:20:46.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:44.69,0:20:46.25,Default,,0,0,0,,Socorro!
Dialogue: 0,0:20:46.21,0:20:47.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:46.33,0:20:47.73,Default,,0,0,0,,Solte-o! Venha cá!
Dialogue: 0,0:20:47.69,0:20:49.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:47.81,0:20:49.49,Default,,0,0,0,,Não faça isso, ele é só uma criança pequena!
Dialogue: 0,0:20:49.45,0:20:50.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:49.57,0:20:50.37,Default,,0,0,0,,Venha, meu amor.
Dialogue: 0,0:20:50.31,0:20:51.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:50.43,0:20:51.77,Default,,0,0,0,,Mamãe, o que está acontecendo?
Dialogue: 0,0:20:51.73,0:20:53.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:51.85,0:20:53.45,Default,,0,0,0,,Vocês também viram, a mão dele se mexeu!
Dialogue: 0,0:20:53.41,0:20:54.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:53.53,0:20:54.65,Default,,0,0,0,,Venha, vamos para o nosso quarto.
Dialogue: 0,0:20:54.61,0:20:56.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:54.73,0:20:55.85,Default,,0,0,0,,O que está havendo?
Dialogue: 0,0:20:55.81,0:20:58.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:55.93,0:20:58.67,Default,,0,0,0,,Ele vai saber! Ele tem que ouvir!
Dialogue: 0,0:20:58.87,0:21:01.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:20:58.99,0:21:01.73,Default,,0,0,0,,A vovó quer me dizer alguma coisa.
Dialogue: 0,0:21:01.69,0:21:03.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:01.81,0:21:03.19,Default,,0,0,0,,O que foi, vovó?
Dialogue: 0,0:21:03.15,0:21:05.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:03.27,0:21:05.73,Default,,0,0,0,,Vovó... O que o Cihan disse? Traga o menino aqui!
Dialogue: 0,0:21:05.69,0:21:06.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:05.81,0:21:06.80,Default,,0,0,0,,Você vai calar a boca!
Dialogue: 0,0:21:06.76,0:21:08.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:06.88,0:21:08.53,Default,,0,0,0,,Então vai ter que se divorciar!
Dialogue: 0,0:21:08.49,0:21:10.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:08.61,0:21:10.41,Default,,0,0,0,,Divorciar?
Dialogue: 0,0:21:25.57,0:21:26.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:25.69,0:21:26.53,Default,,0,0,0,,Vamos conversar no quarto.
Dialogue: 0,0:21:26.49,0:21:28.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:26.61,0:21:28.49,Default,,0,0,0,,Mãe, cala a boca, chega, pare!
Dialogue: 0,0:21:28.45,0:21:30.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:28.57,0:21:29.97,Default,,0,0,0,,Por que você está fazendo isso?!
Dialogue: 0,0:21:30.07,0:21:30.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:30.19,0:21:30.57,Default,,0,0,0,,Chega!
Dialogue: 0,0:21:31.00,0:21:32.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:31.12,0:21:32.04,Default,,0,0,0,,Você vai se divorciar dessa mulher!
Dialogue: 0,0:21:32.00,0:21:33.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:32.12,0:21:33.56,Default,,0,0,0,,Mas o que você quer afinal?!
Dialogue: 0,0:21:33.81,0:21:36.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:33.93,0:21:36.13,Default,,0,0,0,,Todo mundo tem que fazer as coisas do seu jeito por acaso?!
Dialogue: 0,0:21:36.43,0:21:38.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:36.55,0:21:38.11,Default,,0,0,0,,Você vai se divorciar dessa mulher!
Dialogue: 0,0:21:38.13,0:21:39.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:38.25,0:21:39.39,Default,,0,0,0,,Ele ouviu a voz do filho!
Dialogue: 0,0:21:39.35,0:21:40.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:39.47,0:21:39.87,Default,,0,0,0,,Vocês viram!
Dialogue: 0,0:21:40.19,0:21:41.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:40.31,0:21:41.21,Default,,0,0,0,,Todos vocês viram!
Dialogue: 0,0:21:41.21,0:21:42.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:41.33,0:21:42.13,Default,,0,0,0,,Vocês viram com os próprios olhos!
Dialogue: 0,0:21:42.05,0:21:43.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:42.17,0:21:43.61,Default,,0,0,0,,Mãe, você não ouviu o que o médico disse?!
Dialogue: 0,0:21:43.59,0:21:45.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:43.71,0:21:45.17,Default,,0,0,0,,Nem o médico você vai escutar, mãe?!
Dialogue: 0,0:21:45.31,0:21:47.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:45.43,0:21:46.99,Default,,0,0,0,,Ele mexeu o dedo, vocês não viram?!
Dialogue: 0,0:21:46.95,0:21:50.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:47.07,0:21:49.99,Default,,0,0,0,,Mãe, você não tem o direito de fazer isso com uma criança pequena!
Dialogue: 0,0:21:50.01,0:21:51.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:50.13,0:21:50.93,Default,,0,0,0,,Não tem mesmo!
Dialogue: 0,0:21:50.81,0:21:53.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:50.93,0:21:53.41,Default,,0,0,0,,Chega! Você vai levar esse menino até ele!
Dialogue: 0,0:21:53.43,0:21:55.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:53.55,0:21:55.67,Default,,0,0,0,,Ele vai ver o pai e ouvir a voz dele!
Dialogue: 0,0:21:55.71,0:21:57.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:55.83,0:21:57.83,Default,,0,0,0,,O seu irmão vai melhorar, o seu irmão!
Dialogue: 0,0:21:58.23,0:22:00.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:21:58.35,0:22:00.17,Default,,0,0,0,,E se não melhorar, você vai se divorciar!
Dialogue: 0,0:22:00.21,0:22:01.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:00.33,0:22:01.75,Default,,0,0,0,,Você vai levar a criança até o pai!
Dialogue: 0,0:22:04.20,0:22:05.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:04.32,0:22:04.96,Default,,0,0,0,,Você vai se divorciar!
Dialogue: 0,0:22:05.10,0:22:05.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:05.22,0:22:05.52,Default,,0,0,0,,Mãe...
Dialogue: 0,0:22:06.04,0:22:07.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:06.16,0:22:06.98,Default,,0,0,0,,Mãe, não faça isso...
Dialogue: 0,0:22:06.94,0:22:08.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:07.06,0:22:08.42,Default,,0,0,0,,Pelo amor de Deus, que culpa eles têm nisso?!
Dialogue: 0,0:22:08.38,0:22:09.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:08.50,0:22:09.60,Default,,0,0,0,,Pense um pouco neles!
Dialogue: 0,0:22:10.23,0:22:11.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:10.35,0:22:11.01,Default,,0,0,0,,Pensar neles?!
Dialogue: 0,0:22:11.26,0:22:12.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:11.38,0:22:12.31,Default,,0,0,0,,E em mim, quem pensa?!
Dialogue: 0,0:22:12.66,0:22:13.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:12.78,0:22:13.06,Default,,0,0,0,,Quem pensa em mim?!
Dialogue: 0,0:22:13.17,0:22:14.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:13.29,0:22:14.61,Default,,0,0,0,,Quem vai pensar no Boran?!
Dialogue: 0,0:22:14.57,0:22:15.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:14.69,0:22:15.67,Default,,0,0,0,,Quem vai pensar em nós?!
Dialogue: 0,0:22:15.71,0:22:16.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:15.83,0:22:16.35,Default,,0,0,0,,Quem se importa conosco?!
Dialogue: 0,0:22:16.39,0:22:18.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:16.51,0:22:18.13,Default,,0,0,0,,Você não está vendo o que estamos passando?!
Dialogue: 0,0:22:18.15,0:22:18.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:18.27,0:22:18.75,Default,,0,0,0,,Não faça isso!
Dialogue: 0,0:22:18.93,0:22:20.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:19.05,0:22:20.67,Default,,0,0,0,,Não faça isso, eu não aguento mais!
Dialogue: 0,0:22:20.69,0:22:21.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:20.81,0:22:21.71,Default,,0,0,0,,Ninguém aqui aguenta mais!
Dialogue: 0,0:22:21.71,0:22:22.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:21.83,0:22:22.27,Default,,0,0,0,,Não faça isso, pelo amor de Deus!
Dialogue: 0,0:22:22.29,0:22:23.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:22.41,0:22:23.51,Default,,0,0,0,,Vocês não querem que ele melhore!
Dialogue: 0,0:22:23.47,0:22:26.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:23.59,0:22:26.53,Default,,0,0,0,,Então por que vocês não me escutam?!
Dialogue: 0,0:22:27.65,0:22:28.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:27.77,0:22:28.57,Default,,0,0,0,,Vocês não me ouvem!
Dialogue: 0,0:22:28.31,0:22:30.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:28.43,0:22:29.97,Default,,0,0,0,,Não faça isso, eu não suporto mais!
Dialogue: 0,0:22:30.57,0:22:32.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:30.69,0:22:31.95,Default,,0,0,0,,Vocês não querem ouvir.
Dialogue: 0,0:22:34.81,0:22:37.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:34.93,0:22:37.23,Default,,0,0,0,,Deniz, por favor, escuta a mamãe, tá bom?
Dialogue: 0,0:22:37.23,0:22:38.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:37.35,0:22:38.15,Default,,0,0,0,,Venha, meu anjinho.
Dialogue: 0,0:22:38.01,0:22:39.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:38.13,0:22:39.21,Default,,0,0,0,,Olha para mim, meu querido.
Dialogue: 0,0:22:39.17,0:22:40.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:39.29,0:22:40.39,Default,,0,0,0,,Não foi nada, meu amor.
Dialogue: 0,0:22:40.63,0:22:41.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:40.75,0:22:41.11,Default,,0,0,0,,Meu anjo querido.
Dialogue: 0,0:22:41.32,0:22:41.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:41.44,0:22:41.66,Default,,0,0,0,,Levante.
Dialogue: 0,0:22:42.22,0:22:42.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:42.34,0:22:42.62,Default,,0,0,0,,Levante-se.
Dialogue: 0,0:22:43.18,0:22:43.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:43.30,0:22:43.79,Default,,0,0,0,,Vem cá, deixa eu ver.
Dialogue: 0,0:22:44.20,0:22:45.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:44.32,0:22:44.90,Default,,0,0,0,,O que aconteceu? Me conta.
Dialogue: 0,0:22:46.34,0:22:47.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:46.46,0:22:47.70,Default,,0,0,0,,Conta pra mim.
Dialogue: 0,0:22:47.89,0:22:49.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:48.01,0:22:49.76,Default,,0,0,0,,Eu não quero isso de jeito nenhum.
Dialogue: 0,0:22:51.85,0:22:54.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:51.97,0:22:53.93,Default,,0,0,0,,Eu já perdi um pai...
Dialogue: 0,0:22:54.69,0:22:56.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:54.81,0:22:56.77,Default,,0,0,0,,...não quero perder o Cihan também.
Dialogue: 0,0:22:56.97,0:22:58.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:57.09,0:22:57.93,Default,,0,0,0,,Não, não, de jeito nenhum.
Dialogue: 0,0:22:57.89,0:22:59.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:58.01,0:22:59.37,Default,,0,0,0,,Você nunca vai perdê-lo, nunca!
Dialogue: 0,0:22:59.64,0:23:01.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:22:59.76,0:23:00.87,Default,,0,0,0,,Você nunca vai perder.
Dialogue: 0,0:23:06.76,0:23:08.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:06.88,0:23:08.68,Default,,0,0,0,,O quê?
Dialogue: 0,0:23:14.28,0:23:14.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:14.40,0:23:14.58,Default,,0,0,0,,Hum?
Dialogue: 0,0:23:14.85,0:23:16.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:14.97,0:23:16.02,Default,,0,0,0,,Vem você também.
Dialogue: 0,0:23:23.63,0:23:24.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:23.75,0:23:24.83,Default,,0,0,0,,Mamãe, papai...
Dialogue: 0,0:23:25.17,0:23:26.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:25.29,0:23:26.13,Default,,0,0,0,,Espera um instante, diga.
Dialogue: 0,0:23:26.09,0:23:28.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:26.21,0:23:28.11,Default,,0,0,0,,Você, eu, o papai...
Dialogue: 0,0:23:28.58,0:23:30.45,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:28.70,0:23:30.30,Default,,0,0,0,,O Deniz vai jogar pão para as gaivotas...
Dialogue: 0,0:23:30.54,0:23:32.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:30.66,0:23:32.76,Default,,0,0,0,,Mas não vai ter mais ninguém além de nós.
Dialogue: 0,0:23:32.85,0:23:34.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:32.97,0:23:33.90,Default,,0,0,0,,Só nós e as gaivotas.
Dialogue: 0,0:23:36.70,0:23:38.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:36.82,0:23:38.43,Default,,0,0,0,,Joga mais alto, lá para cima!
Dialogue: 0,0:23:38.69,0:23:40.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:38.81,0:23:40.13,Default,,0,0,0,,Tem que jogar longe para ela pegar.
Dialogue: 0,0:23:40.51,0:23:42.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:40.63,0:23:42.33,Default,,0,0,0,,Vocês arruinaram a minha vida!
Dialogue: 0,0:23:42.89,0:23:43.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:43.01,0:23:43.71,Default,,0,0,0,,Aonde você vai?
Dialogue: 0,0:23:44.39,0:23:46.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:44.51,0:23:46.44,Default,,0,0,0,,Nem pense em se aproximar, vou chamar a polícia!
Dialogue: 0,0:23:46.46,0:23:47.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:46.58,0:23:47.34,Default,,0,0,0,,Vai chamar a polícia?
Dialogue: 0,0:23:47.59,0:23:48.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:47.71,0:23:48.07,Default,,0,0,0,,Vou sim!
Dialogue: 0,0:23:49.32,0:23:51.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:49.44,0:23:51.69,Default,,0,0,0,,Chamar a polícia para cá não seria uma boa ideia para você.
Dialogue: 0,0:23:51.81,0:23:54.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:51.93,0:23:53.95,Default,,0,0,0,,Afinal de contas, a sua ficha comigo já é bem suja.
Dialogue: 0,0:23:54.32,0:23:56.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:54.44,0:23:56.47,Default,,0,0,0,,Por que você insiste em tentar casamentos assim?
Dialogue: 0,0:23:56.73,0:23:57.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:56.85,0:23:57.51,Default,,0,0,0,,Você não consegue amar?
Dialogue: 0,0:23:57.77,0:23:58.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:23:57.89,0:23:58.77,Default,,0,0,0,,Não consegue se apaixonar?
Dialogue: 0,0:24:00.15,0:24:02.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:00.27,0:24:02.42,Default,,0,0,0,,Apaixonar-se não é uma coisa tão simples assim.
Dialogue: 0,0:24:02.38,0:24:04.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:02.50,0:24:04.13,Default,,0,0,0,,Pelo contrário, é muito fácil.
Dialogue: 0,0:24:04.29,0:24:05.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:04.41,0:24:05.03,Default,,0,0,0,,Cinco segundos.
Dialogue: 0,0:24:05.43,0:24:06.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:05.55,0:24:06.39,Default,,0,0,0,,Cinco segundos?
Dialogue: 0,0:24:06.57,0:24:07.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:06.69,0:24:06.93,Default,,0,0,0,,Sim.
Dialogue: 0,0:24:07.25,0:24:08.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:07.37,0:24:07.97,Default,,0,0,0,,Que absurdo.
Dialogue: 0,0:24:08.29,0:24:11.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:08.41,0:24:11.47,Default,,0,0,0,,São esses cinco segundos que vão decidir se eu devo dedicar a minha vida a uma mulher?!
Dialogue: 0,0:24:12.30,0:24:14.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:12.42,0:24:13.91,Default,,0,0,0,,E você é obrigado a dedicar a sua vida inteira?
Dialogue: 0,0:24:15.01,0:24:18.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:15.13,0:24:18.68,Default,,0,0,0,,Quando eu amo alguém, quero passar a vida toda ao lado dela.
Dialogue: 0,0:24:20.89,0:24:21.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:21.01,0:24:21.49,Default,,0,0,0,,Por favor.
Dialogue: 0,0:24:24.15,0:24:24.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:24.27,0:24:24.57,Default,,0,0,0,,Venha.
Dialogue: 0,0:24:24.82,0:24:25.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:24.94,0:24:25.82,Default,,0,0,0,,Agora não dá.
Dialogue: 0,0:24:26.08,0:24:27.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:26.20,0:24:27.25,Default,,0,0,0,,O que está acontecendo agora?
Dialogue: 0,0:24:27.71,0:24:28.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:27.83,0:24:28.35,Default,,0,0,0,,Agora...
Dialogue: 0,0:24:28.92,0:24:30.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:29.04,0:24:30.81,Default,,0,0,0,,O que está havendo?
Dialogue: 0,0:24:31.15,0:24:31.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:31.27,0:24:31.65,Default,,0,0,0,,Agora...
Dialogue: 0,0:24:31.87,0:24:33.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:31.99,0:24:32.85,Default,,0,0,0,,Olhe bem nos meus olhos.
Dialogue: 0,0:24:33.03,0:24:33.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:33.15,0:24:33.71,Default,,0,0,0,,Nós vamos embora.
Dialogue: 0,0:24:33.81,0:24:34.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:33.93,0:24:34.43,Default,,0,0,0,,Tá bom?
Dialogue: 0,0:24:34.45,0:24:35.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:34.57,0:24:35.37,Default,,0,0,0,,Mas agora não.
Dialogue: 0,0:24:35.56,0:24:36.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:35.68,0:24:36.14,Default,,0,0,0,,Fique calmo.
Dialogue: 0,0:24:36.53,0:24:37.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:36.65,0:24:37.15,Default,,0,0,0,,Segure aqui.
Dialogue: 0,0:24:38.67,0:24:40.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:38.79,0:24:40.59,Default,,0,0,0,,Vão sumir daqui!
Dialogue: 0,0:24:41.53,0:24:42.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:41.65,0:24:42.53,Default,,0,0,0,,Chega!
Dialogue: 0,0:24:42.55,0:24:43.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:42.67,0:24:43.47,Default,,0,0,0,,O que está acontecendo agora?
Dialogue: 0,0:24:43.25,0:24:44.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:43.37,0:24:44.33,Default,,0,0,0,,Não está acontecendo nada.
Dialogue: 0,0:24:44.31,0:24:44.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:44.43,0:24:44.59,Default,,0,0,0,,Venha.
Dialogue: 0,0:24:44.65,0:24:45.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:44.77,0:24:45.43,Default,,0,0,0,,Venha cá comigo.
Dialogue: 0,0:24:45.55,0:24:46.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:45.67,0:24:46.57,Default,,0,0,0,,Abram a porta.
Dialogue: 0,0:24:46.53,0:24:47.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:46.65,0:24:47.09,Default,,0,0,0,,Eu não sei.
Dialogue: 0,0:24:47.07,0:24:47.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:47.19,0:24:47.37,Default,,0,0,0,,Venha.
Dialogue: 0,0:24:47.67,0:24:49.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:47.79,0:24:49.71,Default,,0,0,0,,Não é nada, meu anjinho.
Dialogue: 0,0:24:49.69,0:24:50.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:49.81,0:24:50.05,Default,,0,0,0,,Não!
Dialogue: 0,0:24:50.11,0:24:56.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:50.23,0:24:55.99,Default,,0,0,0,,Não está acontecendo nada, não dê ouvidos a isso. — Por que a vovó está fazendo isso?
Dialogue: 0,0:24:55.95,0:25:02.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:24:56.07,0:25:02.65,Default,,0,0,0,,Ela vai sumir daqui! Daqui! — Mãe, essa é a solução por acaso? Mãe, essa é a solução? Mãe...
Dialogue: 0,0:25:06.41,0:25:13.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:06.53,0:25:13.27,Default,,0,0,0,,...chega, olhe aqui, já chega! Eu cansei, chega! Eu não aguento mais isso, você vai passar mal! Eu não...
Dialogue: 0,0:25:13.23,0:25:18.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:13.35,0:25:18.69,Default,,0,0,0,,...vou mais tolerar isso! Ela vai embora daqui! É assim que vai ser, mãe!
Dialogue: 0,0:25:21.94,0:25:24.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:22.06,0:25:23.98,Default,,0,0,0,,Mãe, não faça isso, por favor, mãezinha.
Dialogue: 0,0:25:23.94,0:25:26.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:24.06,0:25:26.41,Default,,0,0,0,,Vai para o inferno! Para o inferno!
Dialogue: 0,0:25:26.37,0:25:28.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:26.49,0:25:28.01,Default,,0,0,0,,Vai sumir daqui!
Dialogue: 0,0:25:27.97,0:25:29.25,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:28.09,0:25:29.10,Default,,0,0,0,,Não vai ficar!
Dialogue: 0,0:25:29.06,0:25:31.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:29.18,0:25:31.34,Default,,0,0,0,,Não vai ficar mais aqui!
Dialogue: 0,0:25:33.99,0:25:37.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:34.11,0:25:37.12,Default,,0,0,0,,Vai sumir para o quinto dos infernos!
Dialogue: 0,0:25:44.81,0:25:47.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:44.93,0:25:46.85,Default,,0,0,0,,Irmão, não dá, a nossa mãe perdeu o controle.
Dialogue: 0,0:25:46.81,0:25:49.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:46.93,0:25:49.20,Default,,0,0,0,,Não encostem nela. Deixem quebrar tudo, uma hora ela se acalma.
Dialogue: 0,0:25:49.16,0:25:52.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:49.28,0:25:52.35,Default,,0,0,0,,Deixem-na. Depois arrumamos isso aqui.
Dialogue: 0,0:25:57.52,0:26:01.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:25:57.64,0:26:01.56,Default,,0,0,0,,Não substitui o mar, mas eu conheço um lugar lindo.
Dialogue: 0,0:26:27.70,0:26:29.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:26:27.82,0:26:29.22,Default,,0,0,0,,É sério?
Dialogue: 0,0:26:29.18,0:26:31.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:26:29.30,0:26:31.13,Default,,0,0,0,,Tem até um castelo.
Dialogue: 0,0:26:31.21,0:26:33.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:26:31.33,0:26:33.13,Default,,0,0,0,,Vamos até lá?
Dialogue: 0,0:26:33.37,0:26:34.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:26:33.49,0:26:34.41,Default,,0,0,0,,Sim, vamos!
Dialogue: 0,0:26:34.37,0:26:36.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:26:34.49,0:26:36.29,Default,,0,0,0,,Vamos lá.
Dialogue: 0,0:26:46.59,0:26:47.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:26:46.71,0:26:47.63,Default,,0,0,0,,Vai sumir daqui!
Dialogue: 0,0:26:47.59,0:26:49.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:26:47.71,0:26:49.51,Default,,0,0,0,,Ela vai embora!
Dialogue: 0,0:27:05.38,0:27:07.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:05.50,0:27:07.12,Default,,0,0,0,,Cihan!
Dialogue: 0,0:27:07.08,0:27:08.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:07.20,0:27:08.63,Default,,0,0,0,,Cihan, aonde você vai?!
Dialogue: 0,0:27:08.59,0:27:09.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:08.71,0:27:09.78,Default,,0,0,0,,Mãe!
Dialogue: 0,0:27:09.74,0:27:11.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:09.86,0:27:11.24,Default,,0,0,0,,Cihan, aonde você está levando o menino?!
Dialogue: 0,0:27:11.58,0:27:14.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:11.70,0:27:13.88,Default,,0,0,0,,Aonde você está levando essa criança, Cihan?!
Dialogue: 0,0:27:13.84,0:27:14.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:13.96,0:27:14.22,Default,,0,0,0,,Mãe...
Dialogue: 0,0:27:14.60,0:27:15.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:14.72,0:27:15.12,Default,,0,0,0,,Cihan!
Dialogue: 0,0:27:15.16,0:27:15.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:15.28,0:27:15.70,Default,,0,0,0,,Pare com isso!
Dialogue: 0,0:27:15.82,0:27:16.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:15.94,0:27:16.74,Default,,0,0,0,,Você não pode levá-lo!
Dialogue: 0,0:27:16.54,0:27:17.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:16.66,0:27:16.98,Default,,0,0,0,,Calma, fique quieta.
Dialogue: 0,0:27:17.36,0:27:18.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:17.48,0:27:18.23,Default,,0,0,0,,Cihan, pare!
Dialogue: 0,0:27:18.46,0:27:19.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:18.58,0:27:19.53,Default,,0,0,0,,Eles não estão fugindo para lugar nenhum.
Dialogue: 0,0:27:19.80,0:27:22.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:19.92,0:27:22.35,Default,,0,0,0,,Não faça isso, não leve o menino! Não leve a criança, olhe bem...
Dialogue: 0,0:27:22.31,0:27:23.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:22.43,0:27:23.23,Default,,0,0,0,,Eles não vão fugir para lugar nenhum.
Dialogue: 0,0:27:23.17,0:27:28.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:23.29,0:27:28.41,Default,,0,0,0,,Se você levar o meu neto embora, eu nunca vou te perdoar! Não lhe dou a minha bênção de mãe, que vire veneno!
Dialogue: 0,0:27:28.57,0:27:32.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:28.69,0:27:32.63,Default,,0,0,0,,Por sua culpa! É tudo culpa sua! Eu vou fazer você pagar caro por isso!
Dialogue: 0,0:27:33.01,0:27:34.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:33.13,0:27:34.33,Default,,0,0,0,,Vou fazer você pagar por isso!
Dialogue: 0,0:27:34.86,0:27:36.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:34.98,0:27:36.70,Default,,0,0,0,,Cihan, traga o menino de volta aqui!
Dialogue: 0,0:27:37.59,0:27:38.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:37.71,0:27:38.79,Default,,0,0,0,,Cihan, não leve o meu neto!
Dialogue: 0,0:27:38.75,0:27:39.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:38.87,0:27:39.35,Default,,0,0,0,,Mãe, chega.
Dialogue: 0,0:27:39.77,0:27:40.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:39.89,0:27:40.49,Default,,0,0,0,,Você não pode levá-lo!
Dialogue: 0,0:27:40.67,0:27:41.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:40.79,0:27:41.59,Default,,0,0,0,,Mãe...
Dialogue: 0,0:27:41.01,0:27:42.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:41.13,0:27:42.77,Default,,0,0,0,,Chega, basta!
Dialogue: 0,0:27:42.73,0:27:46.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:42.85,0:27:46.63,Default,,0,0,0,,Mãe, chega, deixe as pessoas respirarem um pouco!
Dialogue: 0,0:27:47.94,0:27:49.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:48.06,0:27:49.26,Default,,0,0,0,,Ele não pode me abandonar!
Dialogue: 0,0:27:49.22,0:27:50.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:49.34,0:27:50.78,Default,,0,0,0,,Não pode abandonar o Boran!
Dialogue: 0,0:27:50.74,0:27:52.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:50.86,0:27:51.94,Default,,0,0,0,,O que você esperava, mãe?!
Dialogue: 0,0:27:51.90,0:27:54.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:52.02,0:27:53.96,Default,,0,0,0,,O que esperava que as pessoas fizessem?!
Dialogue: 0,0:27:53.92,0:27:56.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:54.04,0:27:56.81,Default,,0,0,0,,Você transformou a casa em um campo de batalha! Que culpa eles têm?!
Dialogue: 0,0:27:56.77,0:27:58.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:56.89,0:27:58.76,Default,,0,0,0,,Quem iria querer que as coisas fossem assim? Já chega!
Dialogue: 0,0:27:58.72,0:28:00.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:27:58.84,0:28:00.35,Default,,0,0,0,,O que você está falando?!
Dialogue: 0,0:28:00.31,0:28:01.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:00.43,0:28:01.29,Default,,0,0,0,,Como tem coragem de falar assim?!
Dialogue: 0,0:28:01.25,0:28:02.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:01.37,0:28:02.33,Default,,0,0,0,,Por que eu estou te ouvindo?!
Dialogue: 0,0:28:02.29,0:28:04.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:02.41,0:28:04.27,Default,,0,0,0,,Por que tenho que ouvir você?!
Dialogue: 0,0:28:04.23,0:28:06.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:04.35,0:28:06.45,Default,,0,0,0,,Você vai se deitar na cama do filho do homem...
Dialogue: 0,0:28:06.41,0:28:08.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:06.53,0:28:08.58,Default,,0,0,0,,...que deixou o Boran nesse estado!
Dialogue: 0,0:28:08.54,0:28:10.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:08.66,0:28:10.24,Default,,0,0,0,,A culpa é minha! Por que fui te chamar?!
Dialogue: 0,0:28:10.20,0:28:11.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:10.32,0:28:11.12,Default,,0,0,0,,Por que eu tenho que te escutar?!
Dialogue: 0,0:28:11.06,0:28:13.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:11.18,0:28:12.86,Default,,0,0,0,,Saia da minha casa! Vaza daqui, vamos!
Dialogue: 0,0:28:12.82,0:28:14.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:12.94,0:28:14.06,Default,,0,0,0,,Vá embora daqui agora!
Dialogue: 0,0:28:14.02,0:28:15.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:14.14,0:28:15.58,Default,,0,0,0,,Mãe, eu vim ver o meu irmão Boran!
Dialogue: 0,0:28:15.54,0:28:18.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:15.66,0:28:18.80,Default,,0,0,0,,Você não vai ver o Boran! Você não pode vir ver o Boran!
Dialogue: 0,0:28:18.76,0:28:22.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:18.88,0:28:22.33,Default,,0,0,0,,Só quando o Cihan se divorciar dessa mulher é que você vai poder vir aqui!
Dialogue: 0,0:28:22.29,0:28:25.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:22.41,0:28:25.46,Default,,0,0,0,,Mãe, deixe-a ver o irmão nesse estado, é pecado fazer isso!
Dialogue: 0,0:28:25.42,0:28:28.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:25.54,0:28:28.17,Default,,0,0,0,,Que pecado o quê?! Não fale como se o seu irmão fosse morrer!
Dialogue: 0,0:28:28.13,0:28:29.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:28.25,0:28:29.63,Default,,0,0,0,,Ele vai viver! O Boran vai sobreviver!
Dialogue: 0,0:28:29.59,0:28:35.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:29.71,0:28:35.19,Default,,0,0,0,,Olhe só, por causa dessa mulher o Cihan não me deixa mostrar o neto ao Boran!
Dialogue: 0,0:28:35.15,0:28:37.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:35.27,0:28:37.03,Default,,0,0,0,,Se ele ouvisse a voz do filho, se levantaria na mesma hora!
Dialogue: 0,0:28:36.99,0:28:38.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:37.11,0:28:38.81,Default,,0,0,0,,Mãe, não existe nada disso, pare!
Dialogue: 0,0:28:38.77,0:28:40.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:38.89,0:28:40.38,Default,,0,0,0,,Não existe, cai na real de uma vez!
Dialogue: 0,0:28:40.34,0:28:42.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:40.46,0:28:42.61,Default,,0,0,0,,Ele pegou o menino e levou embora!
Dialogue: 0,0:28:42.57,0:28:44.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:42.69,0:28:44.03,Default,,0,0,0,,E o que você ainda está fazendo aqui?!
Dialogue: 0,0:28:43.99,0:28:46.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:44.11,0:28:45.97,Default,,0,0,0,,Por que continua parada aí?! Some daqui!
Dialogue: 0,0:28:45.93,0:28:48.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:46.05,0:28:48.09,Default,,0,0,0,,Saia da minha casa e nunca mais volte!
Dialogue: 0,0:28:48.05,0:28:53.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:48.17,0:28:52.87,Default,,0,0,0,,A culpa foi minha de ter te chamado! E ainda fica me encarando!
Dialogue: 0,0:28:58.69,0:29:01.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:28:58.81,0:29:01.75,Default,,0,0,0,,E vocês, estão olhando o quê, hein?!
Dialogue: 0,0:29:04.73,0:29:07.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:04.85,0:29:07.05,Default,,0,0,0,,Estão olhando o quê?! Acha que isso aqui é uma peça de teatro por acaso?!
Dialogue: 0,0:29:07.01,0:29:09.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:07.13,0:29:09.13,Default,,0,0,0,,Vão cuidar do trabalho de vocês, vamos!
Dialogue: 0,0:29:09.09,0:29:13.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:09.21,0:29:13.06,Default,,0,0,0,,Nenhum amor é tão verdadeiro quanto o amor de mãe.
Dialogue: 0,0:29:26.00,0:29:28.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:26.12,0:29:27.95,Default,,0,0,0,,Inclusive a paixão.
Dialogue: 0,0:29:30.56,0:29:35.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:30.68,0:29:34.99,Default,,0,0,0,,É a mais pura verdade: tudo o que fiz foi pelo meu filho.
Dialogue: 0,0:29:36.44,0:29:38.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:36.56,0:29:38.18,Default,,0,0,0,,Para que ele abra os olhos e viva.
Dialogue: 0,0:29:38.14,0:29:40.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:38.26,0:29:40.16,Default,,0,0,0,,Mas aquela víbora...
Dialogue: 0,0:29:40.43,0:29:43.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:40.55,0:29:43.20,Default,,0,0,0,,...colocou a paixão na frente da maternidade.
Dialogue: 0,0:29:43.16,0:29:45.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:43.28,0:29:45.02,Default,,0,0,0,,Para impedir que o meu Boran abra os olhos...
Dialogue: 0,0:29:44.98,0:29:46.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:45.10,0:29:46.34,Default,,0,0,0,,...ela esconde o meu neto dele.
Dialogue: 0,0:29:46.30,0:29:51.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:46.42,0:29:51.08,Default,,0,0,0,,A Dona Alya também é mãe, Dona Sadakat. Tudo o que ela faz é para proteger a criança.
Dialogue: 0,0:29:51.45,0:29:57.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:51.57,0:29:57.56,Default,,0,0,0,,Então que aprenda a ser mãe! Nenhuma mãe de verdade esconde o filho do próprio pai!
Dialogue: 0,0:29:58.10,0:30:01.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:29:58.22,0:30:00.86,Default,,0,0,0,,O que é certo pode não ser igual para todo mundo, Dona Sadakat.
Dialogue: 0,0:30:03.06,0:30:08.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:03.18,0:30:08.08,Default,,0,0,0,,Às vezes, para proteger um filho, a mãe precisa afastar até as pessoas mais próximas.
Dialogue: 0,0:30:09.91,0:30:16.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:10.03,0:30:16.48,Default,,0,0,0,,Qual é a sua afinal? Não estava do lado do Boran? A Dona Alya fez a sua cabeça também, é?!
Dialogue: 0,0:30:17.91,0:30:19.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:18.03,0:30:19.41,Default,,0,0,0,,Eu só estou dizendo aquilo que vejo.
Dialogue: 0,0:30:22.20,0:30:25.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:22.32,0:30:25.02,Default,,0,0,0,,Deixa eu te fazer uma pergunta: você tem filhos?
Dialogue: 0,0:30:27.03,0:30:28.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:27.15,0:30:28.14,Default,,0,0,0,,Não.
Dialogue: 0,0:30:28.10,0:30:32.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:28.22,0:30:32.45,Default,,0,0,0,,Não tem... Então veja bem: nem tudo se aprende nos livros...
Dialogue: 0,0:30:32.97,0:30:33.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:33.09,0:30:33.57,Default,,0,0,0,,...Senhor Dursun.
Dialogue: 0,0:30:37.20,0:30:39.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:37.32,0:30:38.90,Default,,0,0,0,,Não venha dar lição sobre assuntos que você desconhece.
Dialogue: 0,0:30:43.31,0:30:49.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:30:43.43,0:30:49.36,Default,,0,0,0,,Às vezes quem não vive a situação é quem melhor enxerga a realidade, Dona Sadakat.
Dialogue: 0,0:31:13.35,0:31:15.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:13.47,0:31:15.27,Default,,0,0,0,,Foi muito lindo.
Dialogue: 0,0:31:22.20,0:31:24.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:22.32,0:31:24.48,Default,,0,0,0,,Você me trouxe até aqui.
Dialogue: 0,0:31:28.36,0:31:30.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:28.48,0:31:29.90,Default,,0,0,0,,Parece até um filme de magia.
Dialogue: 0,0:31:30.79,0:31:34.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:30.91,0:31:33.97,Default,,0,0,0,,Mas veja, você vai trazer pão para elas, tá bom?
Dialogue: 0,0:31:34.79,0:31:36.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:34.91,0:31:36.25,Default,,0,0,0,,Tá bom.
Dialogue: 0,0:31:39.21,0:31:42.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:39.33,0:31:41.88,Default,,0,0,0,,Elas não vão te morder, não é?
Dialogue: 0,0:31:47.00,0:31:49.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:47.12,0:31:49.73,Default,,0,0,0,,Podemos assistir mais um pouco?
Dialogue: 0,0:31:50.94,0:31:53.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:51.06,0:31:53.35,Default,,0,0,0,,Vamos, deem as mãos agora.
Dialogue: 0,0:31:53.86,0:31:54.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:53.98,0:31:54.44,Default,,0,0,0,,Deniz...
Dialogue: 0,0:31:56.31,0:31:57.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:56.43,0:31:57.53,Default,,0,0,0,,Meu filho.
Dialogue: 0,0:31:58.42,0:31:59.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:31:58.54,0:31:59.66,Default,,0,0,0,,Vamos, deem as mãos...
Dialogue: 0,0:32:00.06,0:32:02.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:00.18,0:32:02.11,Default,,0,0,0,,...vamos, peguem na mão um do outro.
Dialogue: 0,0:32:02.07,0:32:03.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:02.19,0:32:03.45,Default,,0,0,0,,Está bem.
Dialogue: 0,0:32:03.55,0:32:04.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:03.67,0:32:04.11,Default,,0,0,0,,Deniz...
Dialogue: 0,0:32:12.41,0:32:14.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:12.53,0:32:14.62,Default,,0,0,0,,Pode brincar à vontade.
Dialogue: 0,0:32:20.26,0:32:23.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:20.38,0:32:23.78,Default,,0,0,0,,Pequeno rapazinho, vem cá comigo, venha cá.
Dialogue: 0,0:32:24.29,0:32:25.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:24.41,0:32:25.23,Default,,0,0,0,,Vem aqui do meu lado.
Dialogue: 0,0:32:25.97,0:32:27.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:26.09,0:32:27.31,Default,,0,0,0,,Senta aqui um minutinho.
Dialogue: 0,0:32:49.01,0:32:55.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:49.13,0:32:55.52,Default,,0,0,0,,Eu não me apaixonei por você quando tudo ia bem, mas sim quando tudo estava desmoronando.
Dialogue: 0,0:33:09.39,0:33:12.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:09.51,0:33:11.97,Default,,0,0,0,,E é exatamente isso que torna esse amor tão precioso para mim.
Dialogue: 0,0:33:12.72,0:33:16.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:12.84,0:33:16.37,Default,,0,0,0,,Alya, se algum dia você soltar a minha mão...
Dialogue: 0,0:33:18.42,0:33:20.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:18.54,0:33:20.20,Default,,0,0,0,,...o meu caminho não chegará a lugar nenhum, acredite nisso.
Dialogue: 0,0:33:20.16,0:33:22.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:20.28,0:33:22.70,Default,,0,0,0,,[Canção tradicional de amor]
Dialogue: 0,0:33:33.66,0:33:37.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:33.78,0:33:37.17,Default,,0,0,0,,Rouxinóis e rosas cantam para o seu amor...
Dialogue: 0,0:33:38.52,0:33:40.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:38.64,0:33:40.47,Default,,0,0,0,,Você é alguém muito especial, Alya.
Dialogue: 0,0:33:41.47,0:33:42.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:41.59,0:33:42.61,Default,,0,0,0,,Você é diferente de todas.
Dialogue: 0,0:33:42.95,0:33:44.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:43.07,0:33:44.25,Default,,0,0,0,,Você é corajosa, justa.
Dialogue: 0,0:33:44.79,0:33:46.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:44.91,0:33:46.77,Default,,0,0,0,,Tem tantas qualidades que eu nem conseguiria listar.
Dialogue: 0,0:33:48.21,0:33:50.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:48.33,0:33:50.51,Default,,0,0,0,,Tudo o que existe de bom dentro de você...
Dialogue: 0,0:33:51.77,0:33:53.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:51.89,0:33:53.81,Default,,0,0,0,,...cada traço seu me fez me apaixonar.
Dialogue: 0,0:33:58.21,0:34:01.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:58.33,0:34:01.27,Default,,0,0,0,,Me perdoe, mas... eu amo você, Alya.
Dialogue: 0,0:34:06.67,0:34:09.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:06.79,0:34:09.01,Default,,0,0,0,,Eu me apaixonei por você.
Dialogue: 0,0:34:09.48,0:34:12.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:09.60,0:34:12.09,Default,,0,0,0,,[Canção tradicional ao fundo]
Dialogue: 0,0:34:14.16,0:34:16.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:14.28,0:34:16.18,Default,,0,0,0,,[Melodia folclórica]
Dialogue: 0,0:34:20.29,0:34:23.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:20.41,0:34:22.89,Default,,0,0,0,,[Acordes de violão e bağlama]
Dialogue: 0,0:34:25.14,0:34:27.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:25.26,0:34:27.06,Default,,0,0,0,,[Poesia cantada]
Dialogue: 0,0:34:31.65,0:34:34.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:31.77,0:34:33.86,Default,,0,0,0,,Viu como ela mergulhou?
Dialogue: 0,0:34:36.79,0:34:38.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:36.91,0:34:38.71,Default,,0,0,0,,Que lindo!
Dialogue: 0,0:34:41.40,0:34:43.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:41.52,0:34:43.32,Default,,0,0,0,,Espera.
Dialogue: 0,0:34:59.00,0:35:02.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:59.12,0:35:02.26,Default,,0,0,0,,Vamos colocar o seu chapeuzinho também.
Dialogue: 0,0:35:04.36,0:35:07.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:04.48,0:35:07.62,Default,,0,0,0,,Vamos, capitão, segure o binóculo aqui.
Dialogue: 0,0:35:10.65,0:35:12.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:10.77,0:35:12.57,Default,,0,0,0,,E aí?
Dialogue: 0,0:35:13.72,0:35:16.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:13.84,0:35:16.65,Default,,0,0,0,,Você ama muito a sua mãe e o seu pai, nunca se esqueça disso.
Dialogue: 0,0:35:16.61,0:35:18.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:16.73,0:35:18.32,Default,,0,0,0,,Pim pim çup!
Dialogue: 0,0:35:18.28,0:35:20.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:18.40,0:35:20.20,Default,,0,0,0,,Papai!
Dialogue: 0,0:35:23.72,0:35:25.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:23.84,0:35:25.38,Default,,0,0,0,,Que lugar é este aqui?
Dialogue: 0,0:35:25.80,0:35:27.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:25.92,0:35:27.27,Default,,0,0,0,,É um rio, o Tigre.
Dialogue: 0,0:35:30.06,0:35:33.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:30.18,0:35:33.38,Default,,0,0,0,,Não se engane vendo ele assim tão calmo.
Dialogue: 0,0:35:35.64,0:35:38.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:35.76,0:35:38.80,Default,,0,0,0,,Esse rio tem uma história de amor tão bonita...
Dialogue: 0,0:35:39.79,0:35:41.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:39.91,0:35:41.11,Default,,0,0,0,,...que supera até os contos de fadas.
Dialogue: 0,0:35:41.61,0:35:43.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:41.73,0:35:43.13,Default,,0,0,0,,Gostaria de ouvir?
Dialogue: 0,0:35:45.01,0:35:47.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:45.13,0:35:47.70,Default,,0,0,0,,Este rio que você vê aqui é o Tigre.
Dialogue: 0,0:35:48.60,0:35:51.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:48.72,0:35:51.47,Default,,0,0,0,,Ele nasce lá nas montanhas mais distantes.
Dialogue: 0,0:35:52.19,0:35:54.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:52.31,0:35:54.68,Default,,0,0,0,,A sua correnteza é muito rápida.
Dialogue: 0,0:35:59.41,0:36:02.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:59.53,0:36:02.11,Default,,0,0,0,,E também existe o Eufrates, que vem lá...
Dialogue: 0,0:36:02.69,0:36:03.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:02.81,0:36:03.63,Default,,0,0,0,,...de outras montanhas distantes.
Dialogue: 0,0:36:04.25,0:36:07.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:04.37,0:36:07.01,Default,,0,0,0,,Os dois nascem por caminhos diferentes.
Dialogue: 0,0:36:08.05,0:36:10.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:08.17,0:36:10.70,Default,,0,0,0,,Mas vivem sempre procurando um pelo outro.
Dialogue: 0,0:36:12.96,0:36:17.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:13.08,0:36:16.86,Default,,0,0,0,,Às vezes montanhas imensas se colocam entre eles.
Dialogue: 0,0:36:18.13,0:36:21.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:18.25,0:36:21.06,Default,,0,0,0,,Às vezes os seus rumos se separam.
Dialogue: 0,0:36:24.77,0:36:27.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:24.89,0:36:27.38,Default,,0,0,0,,E os anos vão passando assim.
Dialogue: 0,0:36:29.29,0:36:32.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:29.41,0:36:32.35,Default,,0,0,0,,Mas eles nunca desistem um do outro.
Dialogue: 0,0:36:32.68,0:36:34.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:32.80,0:36:34.60,Default,,0,0,0,,E...
Dialogue: 0,0:36:40.46,0:36:42.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:40.58,0:36:42.77,Default,,0,0,0,,...depois de longas jornadas...
Dialogue: 0,0:36:42.73,0:36:45.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:42.85,0:36:45.39,Default,,0,0,0,,...eles finalmente se encontram antes de chegar ao mar.
Dialogue: 0,0:36:45.35,0:36:47.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:45.47,0:36:47.82,Default,,0,0,0,,E quando os dois se unem...
Dialogue: 0,0:36:52.23,0:36:55.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:52.35,0:36:55.15,Default,,0,0,0,,...trazem fartura e bênçãos para toda esta terra.
Dialogue: 0,0:36:55.11,0:36:57.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:55.23,0:36:57.49,Default,,0,0,0,,E a vida se torna muito mais bonita.
Dialogue: 0,0:36:57.45,0:36:59.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:57.57,0:36:59.47,Default,,0,0,0,,[Canção tradicional]
Dialogue: 0,0:37:04.84,0:37:07.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:04.96,0:37:06.86,Default,,0,0,0,,[Música melancólica]
Dialogue: 0,0:37:07.24,0:37:09.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:07.36,0:37:09.16,Default,,0,0,0,,[Cantoria poética]
Dialogue: 0,0:37:09.45,0:37:11.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:09.57,0:37:11.47,Default,,0,0,0,,[Canção tradicional]
Dialogue: 0,0:37:11.85,0:37:14.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:11.97,0:37:14.04,Default,,0,0,0,,[Poema lírico em canção]
Dialogue: 0,0:37:14.00,0:37:16.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:14.12,0:37:16.45,Default,,0,0,0,,[Canção folclórica tradicional]
Dialogue: 0,0:37:16.58,0:37:19.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:16.70,0:37:19.05,Default,,0,0,0,,Ficou muito bem assado, né?
Dialogue: 0,0:37:47.34,0:37:48.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:47.46,0:37:48.26,Default,,0,0,0,,Sim.
Dialogue: 0,0:37:47.88,0:37:48.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:48.00,0:37:48.80,Default,,0,0,0,,Ficou bem gostoso, não ficou?
Dialogue: 0,0:37:47.88,0:37:49.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:48.00,0:37:49.70,Default,,0,0,0,,Ficou ótimo, no ponto certinho.
Dialogue: 0,0:38:00.30,0:38:02.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:00.42,0:38:02.40,Default,,0,0,0,,Quando voltarmos, tudo já estará mais calmo e no seu devido lugar.
Dialogue: 0,0:38:08.52,0:38:09.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:08.64,0:38:08.92,Default,,0,0,0,,Tenho medo.
Dialogue: 0,0:38:15.40,0:38:23.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:15.52,0:38:23.02,Default,,0,0,0,,Se o Deniz tivesse visto o Boran, o que teria acontecido? Como ele se sentiria, em que estado ficaria? Só de pensar nisso eu fico desesperada.
Dialogue: 0,0:38:28.00,0:38:30.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:28.12,0:38:30.32,Default,,0,0,0,,E se a sua mãe mostrar o Boran para ele escondida de nós?
Dialogue: 0,0:38:30.58,0:38:31.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:30.70,0:38:31.82,Default,,0,0,0,,Não, não, de jeito nenhum.
Dialogue: 0,0:38:32.09,0:38:34.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:32.21,0:38:34.79,Default,,0,0,0,,Assim que voltarmos eu vou falar com ela. Ela não vai fazer nada disso, não se preocupe.
Dialogue: 0,0:38:34.75,0:38:36.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:34.87,0:38:35.91,Default,,0,0,0,,E ela vai escutar por acaso?
Dialogue: 0,0:38:36.64,0:38:38.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:36.76,0:38:38.78,Default,,0,0,0,,Você não conhece a Dona Sadakat por acaso?
Dialogue: 0,0:38:38.74,0:38:40.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:38.86,0:38:40.28,Default,,0,0,0,,Quando foi que ela ouviu alguém? Não vai ouvir!
Dialogue: 0,0:38:40.30,0:38:41.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:40.42,0:38:41.76,Default,,0,0,0,,Está bem, então diga: o que nós fazemos?
Dialogue: 0,0:38:41.87,0:38:42.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:41.99,0:38:42.42,Default,,0,0,0,,O que devemos fazer?
Dialogue: 0,0:38:42.65,0:38:43.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:42.77,0:38:43.73,Default,,0,0,0,,Diga o que você quer fazer.
Dialogue: 0,0:38:44.11,0:38:44.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:44.23,0:38:44.79,Default,,0,0,0,,Eu não quero isso...
Dialogue: 0,0:38:44.87,0:38:45.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:44.99,0:38:45.77,Default,,0,0,0,,...não é porque eu tenha vontade.
Dialogue: 0,0:38:47.44,0:38:49.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:47.56,0:38:49.32,Default,,0,0,0,,Mas vamos embora daqui.
Dialogue: 0,0:38:50.04,0:38:51.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:50.16,0:38:51.14,Default,,0,0,0,,Deixe o Deniz e eu irmos embora.
Dialogue: 0,0:38:51.10,0:38:53.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:51.22,0:38:53.00,Default,,0,0,0,,Já começou de novo...
Dialogue: 0,0:38:52.96,0:38:59.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:53.08,0:38:59.06,Default,,0,0,0,,Cihan, pelo menos até o Boran se recuperar, até ficar de pé, nós não podemos ficar na mansão.
Dialogue: 0,0:38:59.02,0:39:02.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:38:59.14,0:39:02.70,Default,,0,0,0,,Vamos sair da mansão. Não para longe, vamos para outra casa, outro lugar.
Dialogue: 0,0:39:02.66,0:39:03.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:02.78,0:39:03.66,Default,,0,0,0,,Com o Boran nesse estado?
Dialogue: 0,0:39:03.62,0:39:07.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:03.74,0:39:07.77,Default,,0,0,0,,Sim! É exatamente para ele não ver o pai nesse estado que estou indo!
Dialogue: 0,0:39:07.73,0:39:13.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:07.85,0:39:12.89,Default,,0,0,0,,Com o Boran assim eu não posso fazer nada por ele, só fico monitorando o quadro clínico.
Dialogue: 0,0:39:12.85,0:39:16.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:12.97,0:39:15.93,Default,,0,0,0,,E eu posso continuar monitorando o estado dele mesmo ficando em outra casa.
Dialogue: 0,0:39:15.89,0:39:18.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:16.01,0:39:17.95,Default,,0,0,0,,Não posso fazer mais nada pelo Boran.
Dialogue: 0,0:39:17.91,0:39:20.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:18.03,0:39:20.80,Default,,0,0,0,,Mas pelo meu filho, há muito o que posso fazer.
Dialogue: 0,0:39:20.76,0:39:23.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:20.88,0:39:23.56,Default,,0,0,0,,Eu preciso proteger o meu filho.
Dialogue: 0,0:39:24.37,0:39:26.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:24.49,0:39:26.19,Default,,0,0,0,,Eu também preciso protegê-lo, Alya.
Dialogue: 0,0:39:26.79,0:39:28.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:26.91,0:39:28.40,Default,,0,0,0,,Eu também preciso proteger.
Dialogue: 0,0:39:28.36,0:39:30.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:28.48,0:39:30.44,Default,,0,0,0,,É por isso que digo que lá fora é perigoso.
Dialogue: 0,0:39:30.40,0:39:31.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:30.52,0:39:31.66,Default,,0,0,0,,Fora da mansão é perigoso.
Dialogue: 0,0:39:31.70,0:39:32.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:31.82,0:39:32.62,Default,,0,0,0,,Não faz assim.
Dialogue: 0,0:39:32.77,0:39:34.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:32.89,0:39:34.74,Default,,0,0,0,,E eu te dou a minha palavra.
Dialogue: 0,0:39:34.72,0:39:38.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:34.84,0:39:38.67,Default,,0,0,0,,Até o Boran acordar, minha mãe não vai mostrar o Boran para o Deniz.
Dialogue: 0,0:39:40.82,0:39:43.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:40.94,0:39:43.47,Default,,0,0,0,,Eu não quero que vocês saiam da mansão.
Dialogue: 0,0:39:43.47,0:39:45.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:43.59,0:39:45.45,Default,,0,0,0,,Eu não quero que você vá embora da mansão.
Dialogue: 0,0:39:45.87,0:39:47.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:45.99,0:39:47.53,Default,,0,0,0,,Eu também não quero, Cihan.
Dialogue: 0,0:39:50.69,0:39:53.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:50.81,0:39:52.99,Default,,0,0,0,,Olha, aquele menino se apegou muito a mim.
Dialogue: 0,0:39:53.77,0:39:54.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:53.89,0:39:54.81,Default,,0,0,0,,Aquele menino me amou.
Dialogue: 0,0:39:54.77,0:39:55.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:54.89,0:39:55.83,Default,,0,0,0,,E eu também passei a amá-lo muito.
Dialogue: 0,0:39:55.79,0:39:56.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:55.91,0:39:56.79,Default,,0,0,0,,Eu também me apeguei a ele.
Dialogue: 0,0:39:58.80,0:40:02.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:39:58.92,0:40:02.61,Default,,0,0,0,,Com esse garoto tão apegado a mim, o que vai acontecer se o Boran acordar?
Dialogue: 0,0:40:02.57,0:40:10.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:02.69,0:40:10.19,Default,,0,0,0,,Quando o Boran acordar, esse menino não vai ficar muito abalado? Isso não vai afetar a cabeça dele? O que nós vamos fazer?
Dialogue: 0,0:40:13.58,0:40:21.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:13.70,0:40:21.20,Default,,0,0,0,,O que você sugere, então? Agora há pouco você me disse para não ir embora, e agora? Quer que eu o afaste de você? Quer que a gente se afaste para ele se acostumar? Quer fazer um teste?
Dialogue: 0,0:40:30.74,0:40:38.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:30.86,0:40:38.36,Default,,0,0,0,,Não sei, Alya, não sei! Não sei de nada. Só estou desabafando com você, porque a minha cabeça está uma confusão só.
Dialogue: 0,0:40:39.01,0:40:43.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:39.13,0:40:43.63,Default,,0,0,0,,Eu também não sei, Cihan. Eu também não sei o que fazer nem o que pensar.
Dialogue: 0,0:40:43.59,0:40:46.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:43.71,0:40:45.93,Default,,0,0,0,,Quando o Boran acordar...
Dialogue: 0,0:40:52.32,0:40:54.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:52.44,0:40:54.72,Default,,0,0,0,,Quando o Deniz quiser ficar com o pai dele...
Dialogue: 0,0:40:54.68,0:40:56.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:54.80,0:40:56.24,Default,,0,0,0,,Quando ele escolher o pai, eu não poderei dizer nada.
Dialogue: 0,0:40:56.20,0:40:57.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:56.32,0:40:57.46,Default,,0,0,0,,Afinal, é o pai dele.
Dialogue: 0,0:40:57.42,0:40:58.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:57.54,0:40:58.79,Default,,0,0,0,,Claro que vai escolhê-lo.
Dialogue: 0,0:40:58.75,0:41:01.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:40:58.87,0:41:00.93,Default,,0,0,0,,Mas eu não sei o que faremos.
Dialogue: 0,0:41:00.89,0:41:02.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:01.01,0:41:02.71,Default,,0,0,0,,Não sei o que vai ser de mim.
Dialogue: 0,0:41:02.67,0:41:06.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:02.79,0:41:05.86,Default,,0,0,0,,E se o Boran quiser você? O que vai acontecer?
Dialogue: 0,0:41:05.82,0:41:09.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:05.94,0:41:08.95,Default,,0,0,0,,Legalmente, você ainda é mulher dele.
Dialogue: 0,0:41:12.33,0:41:16.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:12.45,0:41:16.62,Default,,0,0,0,,Não sou! Eu não sou mulher do Boran, eu sou sua esposa!
Dialogue: 0,0:41:19.34,0:41:21.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:19.46,0:41:21.26,Default,,0,0,0,,Você é.
Dialogue: 0,0:41:21.25,0:41:24.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:21.37,0:41:23.85,Default,,0,0,0,,Você disse isso na frente da sua mãe.
Dialogue: 0,0:41:23.81,0:41:27.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:23.93,0:41:27.60,Default,,0,0,0,,Eu disse, e se precisar digo de novo. Direi sempre, direi a todo mundo!
Dialogue: 0,0:41:27.56,0:41:29.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:27.68,0:41:28.86,Default,,0,0,0,,Eu também digo.
Dialogue: 0,0:41:28.82,0:41:31.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:28.94,0:41:31.45,Default,,0,0,0,,E repito: eu não sou a esposa do Boran.
Dialogue: 0,0:41:31.41,0:41:32.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:31.53,0:41:32.43,Default,,0,0,0,,Sou a sua mulher.
Dialogue: 0,0:41:32.39,0:41:39.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:32.51,0:41:39.03,Default,,0,0,0,,Quando o Boran acordar, como você é legalmente esposa dele, o nosso casamento será anulado.
Dialogue: 0,0:41:45.73,0:41:48.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:45.85,0:41:48.14,Default,,0,0,0,,Teremos que nos divorciar.
Dialogue: 0,0:41:51.20,0:41:52.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:51.32,0:41:52.00,Default,,0,0,0,,Você vai se divorciar dele?
Dialogue: 0,0:41:52.64,0:41:53.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:52.76,0:41:53.58,Default,,0,0,0,,Vou me divorciar.
Dialogue: 0,0:41:55.74,0:41:58.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:41:55.86,0:41:57.92,Default,,0,0,0,,Se o Boran acordar, eu vou me divorciar dele, Cihan.
Dialogue: 0,0:42:01.98,0:42:04.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:02.10,0:42:04.71,Default,,0,0,0,,E se ele quiser ficar com você?
Dialogue: 0,0:42:12.44,0:42:13.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:12.56,0:42:13.60,Default,,0,0,0,,Eu não quero!
Dialogue: 0,0:42:14.65,0:42:16.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:14.77,0:42:16.75,Default,,0,0,0,,Por que ninguém pergunta o que EU quero?!
Dialogue: 0,0:42:16.91,0:42:18.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:17.03,0:42:18.33,Default,,0,0,0,,Eu não o quero.
Dialogue: 0,0:42:19.91,0:42:22.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:20.03,0:42:22.19,Default,,0,0,0,,Eu quero ficar ao lado do homem que eu amo.
Dialogue: 0,0:42:30.47,0:42:32.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:30.59,0:42:32.09,Default,,0,0,0,,Não sei se isso significa alguma coisa para você.
Dialogue: 0,0:42:34.06,0:42:36.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:34.18,0:42:35.89,Default,,0,0,0,,Significa muita coisa.
Dialogue: 0,0:42:36.20,0:42:37.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:36.32,0:42:36.91,Default,,0,0,0,,É mesmo?
Dialogue: 0,0:42:40.32,0:42:42.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:40.44,0:42:42.48,Default,,0,0,0,,Do que você tem medo, Cihan?
Dialogue: 0,0:42:42.87,0:42:44.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:42.99,0:42:43.91,Default,,0,0,0,,O que você está enrolando para dizer?
Dialogue: 0,0:42:44.72,0:42:46.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:44.84,0:42:46.20,Default,,0,0,0,,Onde você quer chegar?
Dialogue: 0,0:42:46.16,0:42:49.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:46.28,0:42:49.55,Default,,0,0,0,,Quer que eu te diga do que você tem medo?
Dialogue: 0,0:42:50.02,0:42:53.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:50.14,0:42:53.09,Default,,0,0,0,,Você tem medo de não poder ficar ao meu lado quando o Boran acordar.
Dialogue: 0,0:42:54.55,0:42:56.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:54.67,0:42:56.55,Default,,0,0,0,,Tem medo de não ter coragem para isso.
Dialogue: 0,0:42:57.36,0:42:59.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:42:57.48,0:42:59.64,Default,,0,0,0,,Tem medo de se aproximar de mim.
Dialogue: 0,0:43:01.46,0:43:03.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:01.58,0:43:03.32,Default,,0,0,0,,Você tem medo de encarar o Boran.
Dialogue: 0,0:43:08.92,0:43:13.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:09.04,0:43:13.12,Default,,0,0,0,,Mas só porque você não tem coragem de ficar ao meu lado, eu não vou ficar com o Boran.
Dialogue: 0,0:43:17.11,0:43:18.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:17.23,0:43:18.59,Default,,0,0,0,,Eu não vou voltar para o Boran.
Dialogue: 0,0:43:20.23,0:43:22.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:20.35,0:43:22.75,Default,,0,0,0,,Se você não tiver coragem, eu pego o meu filho e vou embora daqui!
Dialogue: 0,0:43:32.84,0:43:37.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:32.96,0:43:37.07,Default,,0,0,0,,Aqui está, rapazinho. Cuidado que o fundo está quente.
Dialogue: 0,0:43:37.91,0:43:38.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:38.03,0:43:38.83,Default,,0,0,0,,Tá bom, tá bom.
Dialogue: 0,0:43:38.67,0:43:40.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:38.79,0:43:40.03,Default,,0,0,0,,Muito bem, olhe para a frente.
Dialogue: 0,0:43:40.30,0:43:41.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:40.42,0:43:41.62,Default,,0,0,0,,Olha só o meu campeão!
Dialogue: 0,0:43:42.14,0:43:44.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:42.26,0:43:43.98,Default,,0,0,0,,A comida ficou linda.
Dialogue: 0,0:43:45.88,0:43:48.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:46.00,0:43:48.14,Default,,0,0,0,,O patrãozinho preparou com as próprias mãos.
Dialogue: 0,0:43:49.08,0:43:51.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:49.20,0:43:50.86,Default,,0,0,0,,Vocês estão brigando?
Dialogue: 0,0:43:52.25,0:43:53.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:52.37,0:43:53.35,Default,,0,0,0,,Não.
Dialogue: 0,0:43:54.15,0:43:56.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:54.27,0:43:56.36,Default,,0,0,0,,Vocês mal comeram nada.
Dialogue: 0,0:43:56.41,0:43:58.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:56.53,0:43:57.93,Default,,0,0,0,,Não deviam ficar tristes assim.
Dialogue: 0,0:43:58.31,0:44:01.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:43:58.43,0:44:00.93,Default,,0,0,0,,De onde você tirou isso, meu filho?
Dialogue: 0,0:44:00.89,0:44:01.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:01.01,0:44:01.79,Default,,0,0,0,,Nós estamos só aqui sentados.
Dialogue: 0,0:44:01.81,0:44:03.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:01.93,0:44:03.11,Default,,0,0,0,,Esperando a nossa comida.
Dialogue: 0,0:44:03.35,0:44:04.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:03.47,0:44:04.61,Default,,0,0,0,,Não tem nada a ver.
Dialogue: 0,0:44:05.09,0:44:06.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:05.21,0:44:06.45,Default,,0,0,0,,Venha cá, estamos com muita fome.
Dialogue: 0,0:44:06.41,0:44:07.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:06.53,0:44:07.45,Default,,0,0,0,,Venha, vamos comer.
Dialogue: 0,0:44:07.79,0:44:09.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:07.91,0:44:08.93,Default,,0,0,0,,Não, eu não vou comer.
Dialogue: 0,0:44:08.95,0:44:10.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:09.07,0:44:10.81,Default,,0,0,0,,Por favor, não faz isso, meu amor.
Dialogue: 0,0:44:10.93,0:44:11.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:11.05,0:44:11.41,Default,,0,0,0,,Venha cá.
Dialogue: 0,0:44:11.67,0:44:12.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:11.79,0:44:11.97,Default,,0,0,0,,Vem.
Dialogue: 0,0:44:12.64,0:44:13.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:12.76,0:44:12.98,Default,,0,0,0,,Senta aqui.
Dialogue: 0,0:44:13.35,0:44:14.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:13.47,0:44:14.27,Default,,0,0,0,,Eu já estava impaciente.
Dialogue: 0,0:44:14.17,0:44:14.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:14.29,0:44:14.75,Default,,0,0,0,,Senta aqui, deixa eu ver.
Dialogue: 0,0:44:14.85,0:44:15.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:14.97,0:44:15.13,Default,,0,0,0,,Vem.
Dialogue: 0,0:44:15.25,0:44:15.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:15.37,0:44:15.59,Default,,0,0,0,,Por aqui.
Dialogue: 0,0:44:15.87,0:44:16.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:15.99,0:44:16.23,Default,,0,0,0,,Senta.
Dialogue: 0,0:44:16.68,0:44:17.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:16.80,0:44:17.28,Default,,0,0,0,,Vem cá.
Dialogue: 0,0:44:17.48,0:44:19.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:17.60,0:44:19.27,Default,,0,0,0,,Você vai comer os melhores pedaços.
Dialogue: 0,0:44:19.52,0:44:20.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:19.64,0:44:20.84,Default,,0,0,0,,Vamos destampar os pratos.
Dialogue: 0,0:44:20.82,0:44:21.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:20.94,0:44:21.22,Default,,0,0,0,,Pronto.
Dialogue: 0,0:44:21.48,0:44:23.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:21.60,0:44:22.90,Default,,0,0,0,,A comida tá pelando de quente, né?
Dialogue: 0,0:44:23.05,0:44:26.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:23.17,0:44:26.76,Default,,0,0,0,,Qual ficou mais gostoso? Qual carne? O frango?
Dialogue: 0,0:44:27.08,0:44:27.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:27.20,0:44:27.50,Default,,0,0,0,,Sim.
Dialogue: 0,0:44:27.71,0:44:29.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:27.83,0:44:29.36,Default,,0,0,0,,Asinha! Então uma asinha para você.
Dialogue: 0,0:44:29.52,0:44:30.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:29.64,0:44:30.78,Default,,0,0,0,,Vai ter que comer tudinho, então.
Dialogue: 0,0:44:30.94,0:44:31.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:31.06,0:44:31.80,Default,,0,0,0,,Mais uma asinha...
Dialogue: 0,0:44:32.31,0:44:33.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:32.43,0:44:32.90,Default,,0,0,0,,Pra você.
Dialogue: 0,0:44:33.08,0:44:33.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:33.20,0:44:33.50,Default,,0,0,0,,Pra mim.
Dialogue: 0,0:44:33.82,0:44:35.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:33.94,0:44:34.94,Default,,0,0,0,,Mais uma para a mamãe.
Dialogue: 0,0:44:34.90,0:44:35.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:35.02,0:44:35.70,Default,,0,0,0,,Para a mamãe.
Dialogue: 0,0:44:35.72,0:44:39.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:35.84,0:44:39.72,Default,,0,0,0,,E você não vai comer só carne. Tem que comer legumes também. Olha que berinjelas deliciosas você preparou.
Dialogue: 0,0:44:39.89,0:44:40.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:40.01,0:44:40.62,Default,,0,0,0,,Corte aí, vamos ver.
Dialogue: 0,0:44:41.13,0:44:42.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:41.25,0:44:41.91,Default,,0,0,0,,Isso, corta daquele lado.
Dialogue: 0,0:44:42.03,0:44:42.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:42.15,0:44:42.47,Default,,0,0,0,,Ajuda.
Dialogue: 0,0:44:42.49,0:44:44.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:42.61,0:44:44.15,Default,,0,0,0,,Quer ajuda para cortar?
Dialogue: 0,0:44:44.38,0:44:45.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:44:44.50,0:44:45.01,Default,,0,0,0,,Não.
Dialogue: 0,0:45:12.37,0:45:14.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:45:12.49,0:45:14.29,Default,,0,0,0,,Bem-vindo, patrão.
Dialogue: 0,0:45:31.02,0:45:31.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:45:31.14,0:45:31.46,Default,,0,0,0,,Obrigado.
Dialogue: 0,0:45:45.59,0:45:46.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:45:45.71,0:45:46.07,Default,,0,0,0,,Que maravilha.
Dialogue: 0,0:45:46.65,0:45:49.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:45:46.77,0:45:49.51,Default,,0,0,0,,Até que enfim conseguiram chegar.
Dialogue: 0,0:45:49.66,0:45:51.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:45:49.78,0:45:51.35,Default,,0,0,0,,Mãe, fica quieta.
Dialogue: 0,0:45:51.31,0:45:54.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:45:51.43,0:45:54.24,Default,,0,0,0,,Eles estão se movimentando por lá.
Dialogue: 0,0:45:58.81,0:46:01.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:45:58.93,0:46:01.61,Default,,0,0,0,,Minha irmã está furiosa de novo.
Dialogue: 0,0:46:45.70,0:46:47.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:46:45.82,0:46:47.14,Default,,0,0,0,,Eu perguntei, mas ela não me disse nada.
Dialogue: 0,0:46:47.10,0:46:49.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:46:47.22,0:46:49.77,Default,,0,0,0,,Se Ecmel e Demir combinarem...
Dialogue: 0,0:46:50.47,0:46:52.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:46:50.59,0:46:51.99,Default,,0,0,0,,Eles vão agir esta noite.
Dialogue: 0,0:46:51.95,0:46:54.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:46:52.07,0:46:54.03,Default,,0,0,0,,Eu já avisei a polícia florestal.
Dialogue: 0,0:46:53.99,0:46:57.69,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:46:54.11,0:46:57.54,Default,,0,0,0,,Eles vão montar uma operação e pegar os mandantes.
Dialogue: 0,0:46:57.50,0:47:00.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:46:57.62,0:47:00.17,Default,,0,0,0,,Eu, o Muzaffer e o Kadir estaremos lá.
Dialogue: 0,0:47:00.13,0:47:02.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:00.25,0:47:02.13,Default,,0,0,0,,Certo, eu também vou.
Dialogue: 0,0:47:02.09,0:47:04.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:02.21,0:47:03.97,Default,,0,0,0,,E o Şahin?
Dialogue: 0,0:47:03.93,0:47:06.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:04.05,0:47:05.86,Default,,0,0,0,,Irmão, não vai acontecer nada com o Şahin, né?
Dialogue: 0,0:47:05.82,0:47:08.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:05.94,0:47:08.75,Default,,0,0,0,,Ele vai ficar esperando na colina.
Dialogue: 0,0:47:08.97,0:47:11.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:09.09,0:47:11.39,Default,,0,0,0,,Com o Ecmel não vai acontecer nada mesmo.
Dialogue: 0,0:47:11.35,0:47:13.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:11.47,0:47:13.39,Default,,0,0,0,,Se sobrar para alguém, vai ser para o motorista.
Dialogue: 0,0:47:13.35,0:47:14.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:13.47,0:47:14.53,Default,,0,0,0,,Tem mais alguém?
Dialogue: 0,0:47:14.81,0:47:18.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:14.93,0:47:18.02,Default,,0,0,0,,Olha, o que importa para mim é que essa droga não passe dali.
Dialogue: 0,0:47:18.38,0:47:20.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:18.50,0:47:20.38,Default,,0,0,0,,Se Deus quiser, não vai passar. Fique tranquilo.
Dialogue: 0,0:47:20.78,0:47:21.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:20.90,0:47:21.70,Default,,0,0,0,,Olha só o que ele diz.
Dialogue: 0,0:47:22.83,0:47:23.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:22.95,0:47:23.55,Default,,0,0,0,,Nem pense nisso.
Dialogue: 0,0:47:23.73,0:47:24.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:23.85,0:47:24.27,Default,,0,0,0,,Vão em frente.
Dialogue: 0,0:47:33.98,0:47:36.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:34.10,0:47:36.84,Default,,0,0,0,,Deixa que eu resolvo isso, vamos.
Dialogue: 0,0:47:42.34,0:47:43.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:42.46,0:47:43.35,Default,,0,0,0,,O que houve?
Dialogue: 0,0:47:44.86,0:47:46.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:44.98,0:47:46.84,Default,,0,0,0,,Tiveram que levar o caminhoneiro para o hospital.
Dialogue: 0,0:47:47.84,0:47:49.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:47.96,0:47:49.42,Default,,0,0,0,,E o motorista reserva não conhece o trajeto.
Dialogue: 0,0:47:49.72,0:47:51.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:49.84,0:47:51.26,Default,,0,0,0,,Esta noite eu preciso estar naquele caminhão.
Dialogue: 0,0:47:55.10,0:47:58.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:55.22,0:47:57.90,Default,,0,0,0,,Meu filho, arranje outra pessoa!
Dialogue: 0,0:47:58.45,0:48:00.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:47:58.57,0:47:59.91,Default,,0,0,0,,Por que você tem que se arriscar desse jeito?
Dialogue: 0,0:48:01.99,0:48:04.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:02.11,0:48:03.91,Default,,0,0,0,,Deus nos livre, se houver uma batida policial, o que faremos?
Dialogue: 0,0:48:04.03,0:48:05.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:04.15,0:48:05.49,Default,,0,0,0,,Şahin, sua mãe tem razão, é preciso mesmo?
Dialogue: 0,0:48:05.96,0:48:06.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:06.08,0:48:06.76,Default,,0,0,0,,É inevitável!
Dialogue: 0,0:48:07.12,0:48:09.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:07.24,0:48:09.44,Default,,0,0,0,,A rota da fronteira é traiçoeira, ninguém conhece aquele caminho além de mim.
Dialogue: 0,0:48:09.40,0:48:13.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:09.52,0:48:13.37,Default,,0,0,0,,Se houver um único erro, tudo vai por água abaixo.
Dialogue: 0,0:48:15.18,0:48:18.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:15.30,0:48:17.90,Default,,0,0,0,,Tome muito cuidado, meu filho. Fique com o rádio comunicador o tempo todo.
Dialogue: 0,0:48:18.37,0:48:19.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:18.49,0:48:19.67,Default,,0,0,0,,Tá bom, já estou indo.
Dialogue: 0,0:48:19.63,0:48:25.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:19.75,0:48:25.16,Default,,0,0,0,,Şahin, fique de olhos bem abertos. Vamos manter contato. Ao menor sinal de problema, me avise.
Dialogue: 0,0:48:27.67,0:48:30.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:27.79,0:48:29.88,Default,,0,0,0,,Bom apetite para vocês.
Dialogue: 0,0:48:32.05,0:48:33.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:32.17,0:48:33.71,Default,,0,0,0,,Vá com Deus, meu filho. Que Ele te proteja.
Dialogue: 0,0:48:33.85,0:48:34.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:33.97,0:48:34.43,Default,,0,0,0,,Obrigado, mãe.
Dialogue: 0,0:48:39.84,0:48:43.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:39.96,0:48:43.55,Default,,0,0,0,,Ecmel, não tem drogas naquele caminhão, não é?
Dialogue: 0,0:48:51.47,0:48:53.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:51.59,0:48:53.78,Default,,0,0,0,,Do que você está falando, mulher? Não tem nada disso!
Dialogue: 0,0:48:54.10,0:48:55.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:54.22,0:48:55.37,Default,,0,0,0,,Deus me perdoe!
Dialogue: 0,0:48:56.39,0:48:58.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:56.51,0:48:58.60,Default,,0,0,0,,O meu filho está dentro daquele caminhão, ouviu bem?!
Dialogue: 0,0:48:59.48,0:49:04.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:48:59.60,0:49:03.90,Default,,0,0,0,,Se acontecer alguma coisa com ele, eu destruo a sua vida!
Dialogue: 0,0:49:04.97,0:49:07.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:05.09,0:49:07.84,Default,,0,0,0,,Já disse que não tem nada, droga!
Dialogue: 0,0:49:08.69,0:49:10.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:08.81,0:49:10.29,Default,,0,0,0,,Assim espero! E você ainda tem coragem de falar.
Dialogue: 0,0:49:10.39,0:49:11.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:10.51,0:49:11.58,Default,,0,0,0,,E mesmo que tivesse, o que você faria?
Dialogue: 0,0:49:11.60,0:49:15.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:11.72,0:49:15.58,Default,,0,0,0,,Olhe para o seu tamanho antes de falar essas bobagens.
Dialogue: 0,0:49:15.54,0:49:17.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:15.66,0:49:17.75,Default,,0,0,0,,Deus me livre e guarde!
Dialogue: 0,0:49:18.24,0:49:21.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:18.36,0:49:21.04,Default,,0,0,0,,Você não chega nem aos meus pés!
Dialogue: 0,0:49:23.06,0:49:26.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:23.18,0:49:26.77,Default,,0,0,0,,Olha aqui, panela pequena também ferve rápido!
Dialogue: 0,0:49:30.94,0:49:33.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:31.06,0:49:33.35,Default,,0,0,0,,A água ferve num instante!
Dialogue: 0,0:49:34.39,0:49:37.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:34.51,0:49:37.06,Default,,0,0,0,,Você me tira do sério, mulher.
Dialogue: 0,0:49:44.02,0:49:46.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:44.14,0:49:45.94,Default,,0,0,0,,Eu já vou embora.
Dialogue: 0,0:49:48.16,0:49:50.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:48.28,0:49:50.09,Default,,0,0,0,,Se ao menos o Şahin não tivesse ido...
Dialogue: 0,0:49:50.05,0:49:52.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:50.17,0:49:52.40,Default,,0,0,0,,Não se preocupe com isso, não vai acontecer nada.
Dialogue: 0,0:49:52.36,0:49:56.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:52.48,0:49:56.39,Default,,0,0,0,,Não gostei nem um pouco dessa história do caminhão.
Dialogue: 0,0:49:59.69,0:50:02.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:49:59.81,0:50:02.62,Default,,0,0,0,,Não tem nada errado lá dentro, né?
Dialogue: 0,0:50:04.75,0:50:08.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:50:04.87,0:50:08.46,Default,,0,0,0,,Você sabe muito bem o que eu transporto e o que não transporto.
Dialogue: 0,0:50:08.42,0:50:11.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:50:08.54,0:50:11.09,Default,,0,0,0,,E sabe da promessa que eu fiz.
Dialogue: 0,0:50:14.12,0:50:17.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:50:14.24,0:50:16.98,Default,,0,0,0,,Então tome muito cuidado, tá bom?
Dialogue: 0,0:50:18.95,0:50:21.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:50:19.07,0:50:20.87,Default,,0,0,0,,A gente se vê.
Dialogue: 0,0:50:25.96,0:50:32.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:50:26.08,0:50:32.01,Default,,0,0,0,,Daqui a pouco vou para a empresa. Ao menor sinal de problema, me ligue, meu filho.
Dialogue: 0,0:51:10.04,0:51:14.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:51:10.16,0:51:14.14,Default,,0,0,0,,Com certeza, meu irmão. Vá em paz, eu cuido de tudo.
Dialogue: 0,0:51:16.22,0:51:20.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:51:16.34,0:51:20.52,Default,,0,0,0,,Aquele demônio do Ecmel está traficando drogas, é isso?
Dialogue: 0,0:51:52.53,0:51:54.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:51:52.65,0:51:54.55,Default,,0,0,0,,Não posso acreditar.
Dialogue: 0,0:51:56.46,0:51:58.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:51:56.58,0:51:58.61,Default,,0,0,0,,Já se acalmou, não já?
Dialogue: 0,0:52:04.26,0:52:06.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:04.38,0:52:06.16,Default,,0,0,0,,Está zombando de mim?
Dialogue: 0,0:52:06.12,0:52:10.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:06.24,0:52:10.00,Default,,0,0,0,,Não, não estou zombando. Você quebrou tudo lá dentro.
Dialogue: 0,0:52:09.96,0:52:12.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:10.08,0:52:11.88,Default,,0,0,0,,Já se acalmou?
Dialogue: 0,0:52:12.77,0:52:16.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:12.89,0:52:15.96,Default,,0,0,0,,Se eu soubesse que adiantaria, botaria essa mansão abaixo!
Dialogue: 0,0:52:15.92,0:52:19.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:16.04,0:52:19.18,Default,,0,0,0,,E tudo o que fiz foi pelos meus filhos!
Dialogue: 0,0:52:20.09,0:52:22.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:20.21,0:52:22.76,Default,,0,0,0,,Mãe, se é pelos seus filhos...
Dialogue: 0,0:52:24.37,0:52:28.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:24.49,0:52:28.48,Default,,0,0,0,,Esse menino também é de sua carne e sangue! É o seu neto!
Dialogue: 0,0:52:28.44,0:52:31.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:28.56,0:52:31.34,Default,,0,0,0,,Mãe, por que você está agindo assim, pelo amor de Deus?
Dialogue: 0,0:52:31.30,0:52:34.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:31.42,0:52:34.38,Default,,0,0,0,,O menino não pode ver o Boran nesse estado, mãe! Não faça isso!
Dialogue: 0,0:52:36.42,0:52:39.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:36.54,0:52:39.34,Default,,0,0,0,,Cihan, você diz 'o Boran', não tem coragem de chamá-lo de pai dele!
Dialogue: 0,0:52:39.52,0:52:41.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:39.64,0:52:41.80,Default,,0,0,0,,Mãe, claro que é o pai dele! O que mais seria?
Dialogue: 0,0:52:42.47,0:52:46.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:42.59,0:52:46.03,Default,,0,0,0,,É o pai dele. Mas nos deixe fazer o que é certo, ter um pouco de compaixão.
Dialogue: 0,0:52:46.48,0:52:50.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:46.60,0:52:50.60,Default,,0,0,0,,Até o Boran se recuperar, deixe que eu seja o pai dele! Mãe, não faça isso, não faça, por favor!
Dialogue: 0,0:52:51.17,0:52:52.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:51.29,0:52:52.81,Default,,0,0,0,,Mande a sua mulher embora daqui, então!
Dialogue: 0,0:52:58.15,0:53:02.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:52:58.27,0:53:02.64,Default,,0,0,0,,O Deniz não vai entrar naquele quarto, mãe! Entendeu bem?!
Dialogue: 0,0:53:06.84,0:53:09.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:06.96,0:53:09.26,Default,,0,0,0,,E se eu puxar pelo braço e colocar ele lá dentro, o que você vai fazer?!
Dialogue: 0,0:53:10.83,0:53:17.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:10.95,0:53:16.89,Default,,0,0,0,,Com o Boran nesse estado, vai arrancar a mãe dele daqui e me jogar no olho da rua?!
Dialogue: 0,0:53:16.85,0:53:24.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:16.97,0:53:24.19,Default,,0,0,0,,Ou vai dar as costas para o seu irmão enfermo, pegar a sua mulher e a criança e sumir no mundo, hein?!
Dialogue: 0,0:53:24.42,0:53:25.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:24.54,0:53:25.63,Default,,0,0,0,,É só isso que passa pela sua cabeça?
Dialogue: 0,0:53:26.74,0:53:27.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:26.86,0:53:27.60,Default,,0,0,0,,Acha que eu faria só isso?
Dialogue: 0,0:53:29.04,0:53:30.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:29.16,0:53:30.52,Default,,0,0,0,,Pois eu vou te dizer o que eu vou fazer!
Dialogue: 0,0:53:32.41,0:53:35.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:32.53,0:53:35.25,Default,,0,0,0,,Vou pegar você pelo braço e te levar direto para a delegacia!
Dialogue: 0,0:53:36.25,0:53:38.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:36.37,0:53:38.41,Default,,0,0,0,,Vou fazer você confessar que matou a Mine, mãe!
Dialogue: 0,0:53:43.36,0:53:48.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:53:43.48,0:53:48.11,Default,,0,0,0,,Por causa dessa mulher você faria isso com a sua própria mãe?!
Dialogue: 0,0:54:03.92,0:54:07.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:54:04.04,0:54:07.28,Default,,0,0,0,,Vai me arrancar de perto do Boran e me trancar na cadeia?!
Dialogue: 0,0:54:08.12,0:54:11.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:54:08.24,0:54:10.85,Default,,0,0,0,,O Deniz não vai entrar lá, mãe!
Dialogue: 0,0:54:11.22,0:54:15.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:54:11.34,0:54:15.26,Default,,0,0,0,,Por essa mulher você traiu o seu irmão e a sua mãe!
Dialogue: 0,0:54:32.82,0:54:36.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:54:32.94,0:54:36.47,Default,,0,0,0,,Preciso agir como a mãe dele, peço desculpas.
Dialogue: 0,0:55:00.55,0:55:05.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:55:00.67,0:55:05.04,Default,,0,0,0,,Daqui a pouco vou para a empresa, preciso trocar de roupa.
Dialogue: 0,0:55:05.48,0:55:08.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:55:05.60,0:55:07.95,Default,,0,0,0,,Você nunca vai me entender.
Dialogue: 0,0:57:12.10,0:57:14.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:12.22,0:57:14.02,Default,,0,0,0,,Diga, Nare.
Dialogue: 0,0:57:26.32,0:57:28.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:26.44,0:57:27.90,Default,,0,0,0,,Como estão as coisas com a mamãe?
Dialogue: 0,0:57:28.16,0:57:30.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:28.28,0:57:29.94,Default,,0,0,0,,A Alya e o meu irmão já voltaram? O que está acontecendo?
Dialogue: 0,0:57:30.16,0:57:33.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:30.28,0:57:33.19,Default,,0,0,0,,A mesma coisa de sempre. Eles já voltaram.
Dialogue: 0,0:57:33.44,0:57:34.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:33.56,0:57:34.33,Default,,0,0,0,,E o meu irmão Boran...
Dialogue: 0,0:57:35.85,0:57:36.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:35.97,0:57:36.45,Default,,0,0,0,,Nós já cuidamos dele.
Dialogue: 0,0:57:37.82,0:57:40.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:37.94,0:57:40.14,Default,,0,0,0,,Nare, preciso desligar agora. O sinal vai cair.
Dialogue: 0,0:57:40.60,0:57:42.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:40.72,0:57:42.04,Default,,0,0,0,,Por quê? Onde você está?
Dialogue: 0,0:57:42.48,0:57:44.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:42.60,0:57:44.81,Default,,0,0,0,,Não importa onde eu estou. Cadê o Şahin?
Dialogue: 0,0:57:45.59,0:57:47.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:45.71,0:57:47.58,Default,,0,0,0,,Na fronteira, fazendo a entrega da carga.
Dialogue: 0,0:57:47.88,0:57:49.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:48.00,0:57:49.01,Default,,0,0,0,,Você também está indo para a fronteira?
Dialogue: 0,0:57:48.97,0:57:50.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:49.09,0:57:50.63,Default,,0,0,0,,Nare, eu preciso desligar.
Dialogue: 0,0:57:50.61,0:57:52.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:50.73,0:57:52.29,Default,,0,0,0,,Kaya, espera um minuto! Não desliga!
Dialogue: 0,0:57:53.04,0:57:55.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:53.16,0:57:55.78,Default,,0,0,0,,Estou preocupada com o Şahin, ele está no caminhão da carga na fronteira!
Dialogue: 0,0:57:56.53,0:57:57.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:56.65,0:57:57.79,Default,,0,0,0,,No caminhão da carga?!
Dialogue: 0,0:57:58.58,0:58:01.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:57:58.70,0:58:01.31,Default,,0,0,0,,Por que diabos aquele idiota foi entrar naquele caminhão?!
Dialogue: 0,0:58:01.47,0:58:02.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:01.59,0:58:02.19,Default,,0,0,0,,Aconteceu alguma coisa?
Dialogue: 0,0:58:02.31,0:58:03.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:02.43,0:58:03.69,Default,,0,0,0,,Kaya, o que foi? Aconteceu alguma coisa?!
Dialogue: 0,0:58:03.69,0:58:05.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:03.81,0:58:05.01,Default,,0,0,0,,O motorista passou mal.
Dialogue: 0,0:58:05.29,0:58:09.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:05.41,0:58:09.43,Default,,0,0,0,,O reserva não sabia o trajeto e ele foi junto. O que foi? Aconteceu alguma coisa?
Dialogue: 0,0:58:09.47,0:58:11.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:09.59,0:58:11.21,Default,,0,0,0,,Tá bom, Nare, eu tenho que desligar agora.
Dialogue: 0,0:58:11.82,0:58:14.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:11.94,0:58:14.29,Default,,0,0,0,,Não desliga! Tem alguma coisa errada?
Dialogue: 0,0:58:15.65,0:58:17.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:15.77,0:58:17.72,Default,,0,0,0,,A polícia vai parar aquele caminhão, Kaya!
Dialogue: 0,0:58:18.08,0:58:20.45,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:18.20,0:58:20.30,Default,,0,0,0,,Tem drogas lá dentro, Nare! Tem drogas!
Dialogue: 0,0:58:20.56,0:58:22.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:20.68,0:58:22.51,Default,,0,0,0,,Ele não faria isso!
Dialogue: 0,0:58:26.97,0:58:28.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:27.09,0:58:28.72,Default,,0,0,0,,Kaya, o Şahin não faria isso, você sabe muito bem!
Dialogue: 0,0:58:28.68,0:58:31.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:28.80,0:58:31.17,Default,,0,0,0,,Kaya, isso é armação do Ecmel, o Şahin nunca faria isso!
Dialogue: 0,0:58:31.30,0:58:33.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:31.42,0:58:32.94,Default,,0,0,0,,Você conhece ele, Kaya, por favor!
Dialogue: 0,0:58:33.21,0:58:34.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:33.33,0:58:34.16,Default,,0,0,0,,Kaya, faz alguma coisa!
Dialogue: 0,0:58:34.45,0:58:37.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:34.57,0:58:36.97,Default,,0,0,0,,Kaya, por favor! Eu te imploro, pelo amor de Deus!
Dialogue: 0,0:58:36.93,0:58:38.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:37.05,0:58:38.83,Default,,0,0,0,,Tá bom, tá bom, Nare. Calma, se acalma.
Dialogue: 0,0:58:38.83,0:58:39.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:38.95,0:58:39.73,Default,,0,0,0,,O sinal vai cortar.
Dialogue: 0,0:58:39.77,0:58:41.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:39.89,0:58:41.01,Default,,0,0,0,,Olha aqui, me escuta.
Dialogue: 0,0:58:41.29,0:58:43.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:41.41,0:58:43.45,Default,,0,0,0,,O Ecmel não pode desconfiar de nada, Nare.
Dialogue: 0,0:58:43.61,0:58:44.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:43.73,0:58:44.27,Default,,0,0,0,,Está me ouvindo?
Dialogue: 0,0:58:44.51,0:58:46.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:44.63,0:58:46.47,Default,,0,0,0,,O Ecmel não pode saber de nada, Nare.
Dialogue: 0,0:58:46.81,0:58:48.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:46.93,0:58:47.91,Default,,0,0,0,,O resto deixa que eu resolvo.
Dialogue: 0,0:58:48.84,0:58:51.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:48.96,0:58:51.00,Default,,0,0,0,,Kaya, me ajuda, por favor!
Dialogue: 0,0:58:51.81,0:58:53.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:51.93,0:58:53.64,Default,,0,0,0,,Kaya, salva o Şahin, por favor!
Dialogue: 0,0:58:54.08,0:58:55.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:58:54.20,0:58:55.62,Default,,0,0,0,,Tá bom, tá bom, Nare. Tchau.
Dialogue: 0,0:59:15.48,0:59:19.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:59:15.60,0:59:18.86,Default,,0,0,0,,O Şahin está dentro do caminhão da carga.
Dialogue: 0,0:59:53.25,0:59:56.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:59:53.37,0:59:55.85,Default,,0,0,0,,Você conhece o Şahin, isso não é coisa dele.
Dialogue: 0,0:59:55.87,0:59:58.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:59:55.99,0:59:58.35,Default,,0,0,0,,Ele caiu na armação do Ecmel e do Demir, com certeza.
Dialogue: 0,0:59:59.45,1:00:01.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:59:59.57,1:00:01.75,Default,,0,0,0,,Irmão, olha só, o garoto vai se ferrar!
Dialogue: 0,1:00:02.33,1:00:05.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:02.45,1:00:04.88,Default,,0,0,0,,Certo. Avise o Şahin antes que a polícia feche a estrada.
Dialogue: 0,1:00:05.31,1:00:07.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:05.43,1:00:07.11,Default,,0,0,0,,Levem o caminhão para o galpão, eu já estou indo.
Dialogue: 0,1:00:07.11,1:00:08.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:07.23,1:00:08.63,Default,,0,0,0,,Vamos nos encontrar lá agora, tá bom?
Dialogue: 0,1:00:08.77,1:00:10.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:08.89,1:00:10.61,Default,,0,0,0,,Tá bom, tá bom, irmão.
Dialogue: 0,1:00:10.76,1:00:13.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:10.88,1:00:13.48,Default,,0,0,0,,E não se esqueça de avisar o Ecmel, vamos chamá-lo para a conversa.
Dialogue: 0,1:00:14.28,1:00:15.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:14.40,1:00:15.05,Default,,0,0,0,,Vamos lá.
Dialogue: 0,1:00:47.42,1:00:50.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:47.54,1:00:50.22,Default,,0,0,0,,Eles fecharam o caminho, patrão.
Dialogue: 0,1:00:57.59,1:00:59.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:57.71,1:00:59.38,Default,,0,0,0,,Pare aí, pare.
Dialogue: 0,1:00:59.49,1:01:02.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:00:59.61,1:01:02.29,Default,,0,0,0,,O que é isso? Qual é a novidade?
Dialogue: 0,1:01:21.29,1:01:22.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:21.41,1:01:22.35,Default,,0,0,0,,Por que fecharam a estrada?
Dialogue: 0,1:01:22.85,1:01:25.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:22.97,1:01:25.11,Default,,0,0,0,,A polícia tem uma bela surpresa para vocês ali na frente, Şahin.
Dialogue: 0,1:01:25.21,1:01:26.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:25.33,1:01:26.01,Default,,0,0,0,,A polícia?
Dialogue: 0,1:01:26.31,1:01:28.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:26.43,1:01:28.52,Default,,0,0,0,,Quem foi que denunciou?
Dialogue: 0,1:01:29.48,1:01:30.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:29.60,1:01:30.06,Default,,0,0,0,,Nós.
Dialogue: 0,1:01:30.67,1:01:32.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:30.79,1:01:31.95,Default,,0,0,0,,O que você disse, desgraçado?!
Dialogue: 0,1:01:33.11,1:01:34.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:33.23,1:01:34.27,Default,,0,0,0,,Vocês me traíram por acaso, idiotas?!
Dialogue: 0,1:01:34.23,1:01:36.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:34.35,1:01:36.08,Default,,0,0,0,,Que traição o quê, Şahin?
Dialogue: 0,1:01:36.56,1:01:37.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:36.68,1:01:37.79,Default,,0,0,0,,Que traição, cara?
Dialogue: 0,1:01:38.63,1:01:40.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:38.75,1:01:40.02,Default,,0,0,0,,Tem drogas no seu caminhão, Şahin!
Dialogue: 0,1:01:39.98,1:01:41.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:40.10,1:01:41.60,Default,,0,0,0,,Que drogas, seu idiota?! Não tem nada disso!
Dialogue: 0,1:01:41.90,1:01:42.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:42.02,1:01:42.82,Default,,0,0,0,,Não tem, Şahin?
Dialogue: 0,1:01:42.28,1:01:43.25,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:42.40,1:01:43.10,Default,,0,0,0,,Não tem nada, porcaria!
Dialogue: 0,1:01:43.08,1:01:44.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:43.20,1:01:44.20,Default,,0,0,0,,Şahin, cara, me escuta...
Dialogue: 0,1:01:44.26,1:01:45.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:44.38,1:01:44.88,Default,,0,0,0,,Confia em mim.
Dialogue: 0,1:01:45.28,1:01:46.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:45.40,1:01:46.41,Default,,0,0,0,,Confia em mim, Şahin.
Dialogue: 0,1:01:46.50,1:01:47.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:46.62,1:01:47.78,Default,,0,0,0,,Tem drogas dentro da sua carreta.
Dialogue: 0,1:01:48.09,1:01:50.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:48.21,1:01:49.90,Default,,0,0,0,,Olha para mim, Şahin...
Dialogue: 0,1:01:50.41,1:01:52.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:50.53,1:01:51.96,Default,,0,0,0,,Eu mentiria para você, cara?
Dialogue: 0,1:01:52.86,1:01:54.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:52.98,1:01:54.06,Default,,0,0,0,,Confia em mim.
Dialogue: 0,1:01:55.31,1:01:56.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:55.43,1:01:56.26,Default,,0,0,0,,Motorista.
Dialogue: 0,1:01:56.71,1:01:57.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:56.83,1:01:57.49,Default,,0,0,0,,Assume o volante.
Dialogue: 0,1:01:57.55,1:01:58.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:01:57.67,1:01:58.19,Default,,0,0,0,,Mostra o caminho.
Dialogue: 0,1:02:00.35,1:02:01.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:00.47,1:02:01.00,Default,,0,0,0,,Vamos logo.
Dialogue: 0,1:02:02.37,1:02:04.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:02.49,1:02:04.76,Default,,0,0,0,,Vamos sair daqui antes que peguem a gente, Şahin.
Dialogue: 0,1:02:05.06,1:02:05.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:05.18,1:02:05.73,Default,,0,0,0,,Cara...
Dialogue: 0,1:02:06.54,1:02:07.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:06.66,1:02:07.36,Default,,0,0,0,,Vamos, Şahin.
Dialogue: 0,1:02:07.52,1:02:08.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:07.64,1:02:08.15,Default,,0,0,0,,Vamos logo, cara.
Dialogue: 0,1:02:08.54,1:02:09.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:08.66,1:02:09.00,Default,,0,0,0,,Şahin!
Dialogue: 0,1:02:32.65,1:02:34.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:32.77,1:02:34.74,Default,,0,0,0,,Tomem cuidado, vamos.
Dialogue: 0,1:02:49.21,1:02:52.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:49.33,1:02:52.72,Default,,0,0,0,,Os seus capangas vão ficar aqui, Sr. Ecmel.
Dialogue: 0,1:02:55.90,1:02:57.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:02:56.02,1:02:57.50,Default,,0,0,0,,E o senhor solte a sua arma.
Dialogue: 0,1:03:19.00,1:03:21.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:03:19.12,1:03:21.02,Default,,0,0,0,,Calma, eu estou bem.
Dialogue: 0,1:03:22.30,1:03:30.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:03:22.42,1:03:29.92,Default,,0,0,0,,Calma, eu estou bem, estou bem... Não se aproxime! Pai, vem cá. Com que direito vocês estão apreendendo o meu caminhão? Viraram bandidos, por acaso?! Dizem que tem drogas no caminhão, pai! Que drogas o quê, não tem nada! Não tem? Abre o caminhão! Arranca tudo e traz para cá! Põe na frente do Şahin para ele ver bem! Espera aí, olha o que veio para você. Kaya, joga aqui! Dizem que é chá, mas que tipo de chá é esse, hein, Şahin? Dá uma olhada!
Dialogue: 0,1:05:00.14,1:05:00.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:00.26,1:05:00.62,Default,,0,0,0,,Dá uma olhada.
Dialogue: 0,1:05:17.06,1:05:19.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:17.18,1:05:19.14,Default,,0,0,0,,Puxem tudo para fora.
Dialogue: 0,1:05:27.83,1:05:29.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:27.95,1:05:29.75,Default,,0,0,0,,Me solta!
Dialogue: 0,1:05:32.04,1:05:32.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:32.16,1:05:32.77,Default,,0,0,0,,Me solta!
Dialogue: 0,1:05:32.89,1:05:33.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:33.01,1:05:33.81,Default,,0,0,0,,Me solta!
Dialogue: 0,1:05:33.44,1:05:34.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:33.56,1:05:34.36,Default,,0,0,0,,Me solta!
Dialogue: 0,1:05:33.60,1:05:34.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:33.72,1:05:34.52,Default,,0,0,0,,Me solta!
Dialogue: 0,1:05:33.82,1:05:34.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:33.94,1:05:34.17,Default,,0,0,0,,Me solta!
Dialogue: 0,1:05:35.41,1:05:37.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:35.53,1:05:37.33,Default,,0,0,0,,Me solta!
Dialogue: 0,1:05:38.85,1:05:39.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:38.97,1:05:39.33,Default,,0,0,0,,Me solta, seu desgraçado!
Dialogue: 0,1:05:39.42,1:05:43.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:39.54,1:05:43.32,Default,,0,0,0,,Como foi que esse veneno veio parar aqui, então?!
Dialogue: 0,1:05:43.78,1:05:46.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:43.90,1:05:46.04,Default,,0,0,0,,Deixa eu te perguntar uma coisa.
Dialogue: 0,1:05:47.71,1:05:49.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:47.83,1:05:49.73,Default,,0,0,0,,Olha só para isso...
Dialogue: 0,1:05:54.41,1:05:55.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:54.53,1:05:54.89,Default,,0,0,0,,Malditos!
Dialogue: 0,1:05:56.28,1:05:58.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:56.40,1:05:58.13,Default,,0,0,0,,Eles esconderam a mercadoria.
Dialogue: 0,1:05:58.77,1:06:01.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:05:58.89,1:06:01.37,Default,,0,0,0,,Foi assim que me denunciaram e me jogaram na cadeia.
Dialogue: 0,1:06:01.91,1:06:03.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:02.03,1:06:03.79,Default,,0,0,0,,E agora iam jogar você.
Dialogue: 0,1:06:05.89,1:06:07.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:06.01,1:06:07.65,Default,,0,0,0,,Por Deus, o Senhor lá em cima é testemunha.
Dialogue: 0,1:06:07.85,1:06:09.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:07.97,1:06:09.21,Default,,0,0,0,,E todo mundo já está vendo.
Dialogue: 0,1:06:09.19,1:06:11.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:09.31,1:06:10.89,Default,,0,0,0,,Muito bem o que você é, Sr. Ecmel.
Dialogue: 0,1:06:14.34,1:06:16.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:14.46,1:06:16.26,Default,,0,0,0,,Şahin.
Dialogue: 0,1:06:16.90,1:06:21.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:17.02,1:06:20.99,Default,,0,0,0,,Você devia agradecer a Deus por termos tirado você de lá antes do flagrante.
Dialogue: 0,1:06:21.31,1:06:23.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:21.43,1:06:23.52,Default,,0,0,0,,Se não fosse o Cihan e os rapazes, você estaria mofando na cadeia agora.
Dialogue: 0,1:06:23.70,1:06:25.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:23.82,1:06:25.62,Default,,0,0,0,,Ecmel!
Dialogue: 0,1:06:30.76,1:06:33.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:30.88,1:06:33.23,Default,,0,0,0,,Só porque fechei negócio com o Demir...
Dialogue: 0,1:06:34.50,1:06:38.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:34.62,1:06:38.43,Default,,0,0,0,,Você fica espumando de raiva porque passo mercadoria por essas terras, né?
Dialogue: 0,1:06:40.83,1:06:44.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:40.95,1:06:44.23,Default,,0,0,0,,Você perde o sono com medo de eu tomar o seu lugar!
Dialogue: 0,1:06:45.71,1:06:49.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:45.83,1:06:49.14,Default,,0,0,0,,Você só sabe armar essas emboscadas covardes!
Dialogue: 0,1:06:51.47,1:06:53.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:51.59,1:06:53.20,Default,,0,0,0,,Quem arma armadilhas é você!
Dialogue: 0,1:06:55.61,1:06:56.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:55.73,1:06:56.81,Default,,0,0,0,,Quem vive de emboscadas é você!
Dialogue: 0,1:06:56.79,1:07:00.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:06:56.91,1:07:00.07,Default,,0,0,0,,Porque você não sabe se manter em pé de outro jeito.
Dialogue: 0,1:07:00.71,1:07:02.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:07:00.83,1:07:02.65,Default,,0,0,0,,Porque você é um covarde traidor!
Dialogue: 0,1:07:03.44,1:07:03.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:07:03.56,1:07:03.78,Default,,0,0,0,,Maldito...
Dialogue: 0,1:07:11.36,1:07:13.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:07:11.48,1:07:13.28,Default,,0,0,0,,Joga gasolina!
Dialogue: 0,1:08:28.36,1:08:36.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:08:28.48,1:08:35.98,Default,,0,0,0,,Na família Albora, nem o meu pai, nem o pai dele, ou seja, o meu avô, jamais permitiram a passagem de veneno!
Dialogue: 0,1:08:55.51,1:08:57.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:08:55.63,1:08:57.66,Default,,0,0,0,,E eu também não vou permitir!
Dialogue: 0,1:08:58.06,1:08:58.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:08:58.18,1:08:58.52,Default,,0,0,0,,Ecmel!
Dialogue: 0,1:08:58.66,1:09:04.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:08:58.78,1:09:04.18,Default,,0,0,0,,Eu não vou permitir que você espalhe a sua sujeira podre por essas terras!
Dialogue: 0,1:09:04.69,1:09:07.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:04.81,1:09:06.97,Default,,0,0,0,,Vou ensinar isso aos meus filhos.
Dialogue: 0,1:09:07.26,1:09:08.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:07.38,1:09:08.70,Default,,0,0,0,,E eles aos filhos deles.
Dialogue: 0,1:09:09.48,1:09:16.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:09.60,1:09:16.39,Default,,0,0,0,,Jamais permitirei que o veneno trazido por você e pelos seus iguais contamine essa terra, Ecmel!
Dialogue: 0,1:09:17.47,1:09:20.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:17.59,1:09:20.05,Default,,0,0,0,,Isso ainda não acabou, Sr. Cihan!
Dialogue: 0,1:09:26.21,1:09:30.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:26.33,1:09:30.11,Default,,0,0,0,,Eu mesmo vou queimar você nesse fogo, ouviu bem?!
Dialogue: 0,1:09:31.87,1:09:36.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:31.99,1:09:36.30,Default,,0,0,0,,Se você queimar alguém, vai queimar esse garoto inocente!
Dialogue: 0,1:09:39.53,1:09:44.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:39.65,1:09:44.21,Default,,0,0,0,,Şahin, abra os olhos para o demônio que você tem ao seu lado!
Dialogue: 0,1:09:45.05,1:09:48.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:45.17,1:09:48.24,Default,,0,0,0,,Eu não vou conseguir te livrar todas as vezes, rapaz.
Dialogue: 0,1:09:48.20,1:09:51.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:48.32,1:09:51.52,Default,,0,0,0,,Escolha o seu lado e tome a sua decisão!
Dialogue: 0,1:09:53.25,1:09:55.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:09:53.37,1:09:55.17,Default,,0,0,0,,Eu avisei...
Dialogue: 0,1:11:20.36,1:11:23.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:20.48,1:11:23.80,Default,,0,0,0,,Eles estão querendo puxar o nosso tapete, você não entende?!
Dialogue: 0,1:11:23.99,1:11:26.45,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:24.11,1:11:26.30,Default,,0,0,0,,Querem fazer a gente de fantoche!
Dialogue: 0,1:11:26.85,1:11:28.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:26.97,1:11:27.87,Default,,0,0,0,,Você não ouviu o meu irmão?
Dialogue: 0,1:11:28.56,1:11:30.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:28.68,1:11:30.04,Default,,0,0,0,,O meu irmão não joga sujo pelas costas!
Dialogue: 0,1:11:30.04,1:11:31.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:30.16,1:11:31.26,Default,,0,0,0,,Trabalho sujo é a especialidade de vocês!
Dialogue: 0,1:11:31.47,1:11:32.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:31.59,1:11:32.39,Default,,0,0,0,,Cala a boca!
Dialogue: 0,1:11:32.23,1:11:33.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:32.35,1:11:33.15,Default,,0,0,0,,Cala a boca por quê?!
Dialogue: 0,1:11:33.03,1:11:33.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:33.15,1:11:33.67,Default,,0,0,0,,Entenda de uma vez, pai!
Dialogue: 0,1:11:33.82,1:11:37.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:33.94,1:11:37.08,Default,,0,0,0,,Se a polícia tivesse chegado antes do meu irmão, o Şahin estaria preso agora!
Dialogue: 0,1:11:37.33,1:11:39.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:37.45,1:11:39.48,Default,,0,0,0,,Foram eles mesmos que chamaram a polícia!
Dialogue: 0,1:11:40.43,1:11:43.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:40.55,1:11:43.12,Default,,0,0,0,,Homem, eles querem nos colocar uns contra os outros!
Dialogue: 0,1:11:43.10,1:11:44.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:43.22,1:11:44.44,Default,,0,0,0,,Entenda isso de uma vez, Şahin!
Dialogue: 0,1:11:44.53,1:11:45.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:44.65,1:11:45.53,Default,,0,0,0,,Você veio até a mansão, mas...
Dialogue: 0,1:11:45.49,1:11:51.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:45.61,1:11:51.02,Default,,0,0,0,,Eu ouvi com os meus próprios ouvidos: vocês não estão trabalhando juntos?!
Dialogue: 0,1:11:52.74,1:11:55.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:52.86,1:11:55.21,Default,,0,0,0,,Não tinha drogas no acordo!
Dialogue: 0,1:11:56.60,1:11:59.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:11:56.72,1:11:59.79,Default,,0,0,0,,Tinha fertilizante, chá e eletrônicos!
Dialogue: 0,1:12:00.24,1:12:02.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:00.36,1:12:02.58,Default,,0,0,0,,Por que você foi se meter em negócios com esse crápula?!
Dialogue: 0,1:12:02.60,1:12:05.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:02.72,1:12:04.98,Default,,0,0,0,,Não sabe que esse desgraçado vive de traficar drogas?!
Dialogue: 0,1:12:05.14,1:12:08.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:05.26,1:12:08.03,Default,,0,0,0,,Deixa disso, cara, não briga com o seu paizinho.
Dialogue: 0,1:12:08.44,1:12:09.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:08.56,1:12:09.53,Default,,0,0,0,,É feio agir assim.
Dialogue: 0,1:12:10.80,1:12:13.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:10.92,1:12:13.38,Default,,0,0,0,,Eu mesmo escondi no fundo falso sem ele saber de nada.
Dialogue: 0,1:12:22.17,1:12:24.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:22.29,1:12:24.39,Default,,0,0,0,,Foi você quem colocou?!
Dialogue: 0,1:12:29.13,1:12:31.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:29.25,1:12:31.19,Default,,0,0,0,,Como você teve coragem de fazer uma coisa dessas, seu canalha?!
Dialogue: 0,1:12:32.50,1:12:34.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:32.62,1:12:34.18,Default,,0,0,0,,Uma coisa dessas...
Dialogue: 0,1:12:34.34,1:12:35.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:34.46,1:12:35.56,Default,,0,0,0,,O que você está dizendo, desgraçado?!
Dialogue: 0,1:12:35.80,1:12:37.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:35.92,1:12:36.92,Default,,0,0,0,,O que foi que você disse?!
Dialogue: 0,1:12:37.06,1:12:38.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:37.18,1:12:38.42,Default,,0,0,0,,O que você disse?!
Dialogue: 0,1:12:38.38,1:12:40.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:38.50,1:12:40.24,Default,,0,0,0,,Eu estava dentro daquele caminhão, desgraçado!
Dialogue: 0,1:12:40.84,1:12:42.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:40.96,1:12:42.32,Default,,0,0,0,,Calma, não faz isso, garoto.
Dialogue: 0,1:12:42.47,1:12:43.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:42.59,1:12:43.49,Default,,0,0,0,,Não tivesse entrado no caminhão.
Dialogue: 0,1:12:43.45,1:12:44.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:43.57,1:12:44.37,Default,,0,0,0,,Por que foi entrar, rapaz?
Dialogue: 0,1:12:44.51,1:12:46.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:44.63,1:12:46.59,Default,,0,0,0,,Como não traficar drogas nestas terras?
Dialogue: 0,1:12:46.55,1:12:49.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:46.67,1:12:49.33,Default,,0,0,0,,Cala a boca, desgraçado! Como você teve a audácia de colocar aquilo lá?!
Dialogue: 0,1:12:49.29,1:12:52.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:49.41,1:12:52.21,Default,,0,0,0,,Coloquei e pronto! Ficasse esperto!
Dialogue: 0,1:12:52.17,1:12:54.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:52.29,1:12:53.99,Default,,0,0,0,,E você ainda deixou queimarem a mercadoria.
Dialogue: 0,1:12:53.95,1:12:56.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:54.07,1:12:56.75,Default,,0,0,0,,Se a mercadoria estivesse na mão agora, eu ia te dar a sua parte.
Dialogue: 0,1:12:56.71,1:12:58.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:56.83,1:12:58.57,Default,,0,0,0,,Ia ficar mais poderoso ainda, hein, Şaho?!
Dialogue: 0,1:12:58.53,1:13:00.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:58.65,1:12:59.87,Default,,0,0,0,,Vem cá!
Dialogue: 0,1:12:59.83,1:13:01.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:12:59.95,1:13:01.03,Default,,0,0,0,,Şahin!
Dialogue: 0,1:13:00.99,1:13:02.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:01.11,1:13:01.91,Default,,0,0,0,,Chega!
Dialogue: 0,1:13:01.76,1:13:03.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:01.88,1:13:03.25,Default,,0,0,0,,Chega, parem!
Dialogue: 0,1:13:03.21,1:13:06.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:03.33,1:13:05.97,Default,,0,0,0,,É só a gente não fazer mais acordos e pronto.
Dialogue: 0,1:13:05.93,1:13:07.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:06.05,1:13:06.85,Default,,0,0,0,,Zerrin!
Dialogue: 0,1:13:06.63,1:13:07.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:06.75,1:13:07.55,Default,,0,0,0,,Pelo amor de Deus!
Dialogue: 0,1:13:07.13,1:13:08.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:07.25,1:13:08.61,Default,,0,0,0,,Nós vamos embora agora.
Dialogue: 0,1:13:08.57,1:13:09.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:08.69,1:13:09.78,Default,,0,0,0,,Zerrin, vem aqui!
Dialogue: 0,1:13:09.74,1:13:11.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:09.86,1:13:10.87,Default,,0,0,0,,Venha, você vai vir com a gente!
Dialogue: 0,1:13:10.83,1:13:11.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:10.95,1:13:11.75,Default,,0,0,0,,Tá bom, meu irmão.
Dialogue: 0,1:13:11.57,1:13:12.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:11.69,1:13:12.49,Default,,0,0,0,,Anda!
Dialogue: 0,1:13:11.87,1:13:13.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:11.99,1:13:13.01,Default,,0,0,0,,Deixa ela ir.
Dialogue: 0,1:13:12.97,1:13:14.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:13.09,1:13:14.42,Default,,0,0,0,,Tá bem.
Dialogue: 0,1:13:14.38,1:13:16.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:14.50,1:13:16.44,Default,,0,0,0,,Ela está carregando o filho dele na barriga.
Dialogue: 0,1:13:16.40,1:13:18.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:16.52,1:13:18.75,Default,,0,0,0,,É a mulher dele, caramba!
Dialogue: 0,1:13:18.95,1:13:20.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:19.07,1:13:20.43,Default,,0,0,0,,Vamos para os carros!
Dialogue: 0,1:13:20.39,1:13:21.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:20.51,1:13:21.47,Default,,0,0,0,,Zerrin, venha.
Dialogue: 0,1:13:43.41,1:13:47.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:13:43.53,1:13:47.38,Default,,0,0,0,,Eu vou varrer vocês da face da terra, desgraçados!
Dialogue: 0,1:14:01.80,1:14:05.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:01.92,1:14:05.16,Default,,0,0,0,,Para onde quer que eu vá, parece que o chão se abre sob os meus pés.
Dialogue: 0,1:14:07.51,1:14:11.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:07.63,1:14:10.96,Default,,0,0,0,,Por uma pessoa pela qual me sacrifiquei...
Dialogue: 0,1:14:13.84,1:14:18.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:13.96,1:14:18.22,Default,,0,0,0,,Por ter te arrastado para essa minha vida sem rumo... Meu peito queima de dor!
Dialogue: 0,1:14:27.50,1:14:31.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:27.62,1:14:31.21,Default,,0,0,0,,O que você está olhando? Anda, desce do carro!
Dialogue: 0,1:14:50.07,1:14:51.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:50.19,1:14:51.33,Default,,0,0,0,,Se prendessem o meu irmão, Demir...
Dialogue: 0,1:14:51.94,1:14:55.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:52.06,1:14:54.92,Default,,0,0,0,,Olha aqui, desta vez eu te mataria com as minhas próprias mãos!
Dialogue: 0,1:14:55.20,1:14:58.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:55.32,1:14:58.18,Default,,0,0,0,,Eu me casei com você para o meu irmão não apodrecer na cadeia!
Dialogue: 0,1:14:58.38,1:15:00.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:14:58.50,1:15:00.46,Default,,0,0,0,,Eu não sabia que ele estava no caminhão, não sabia!
Dialogue: 0,1:15:00.52,1:15:01.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:00.64,1:15:01.64,Default,,0,0,0,,E o que mudaria se soubesse?!
Dialogue: 0,1:15:01.82,1:15:02.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:01.94,1:15:02.74,Default,,0,0,0,,O que mudaria?!
Dialogue: 0,1:15:02.60,1:15:04.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:02.72,1:15:04.70,Default,,0,0,0,,Como se eu não soubesse que você faria a mesma coisa de novo!
Dialogue: 0,1:15:06.00,1:15:07.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:06.12,1:15:06.92,Default,,0,0,0,,Seu homem desprezível!
Dialogue: 0,1:15:07.37,1:15:08.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:07.49,1:15:08.51,Default,,0,0,0,,O desprezível aqui não sou eu!
Dialogue: 0,1:15:09.17,1:15:11.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:09.29,1:15:10.89,Default,,0,0,0,,Desprezíveis são aqueles que me transformaram nisso!
Dialogue: 0,1:15:11.91,1:15:13.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:12.03,1:15:13.39,Default,,0,0,0,,Ninguém teve piedade de mim!
Dialogue: 0,1:15:14.42,1:15:15.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:14.54,1:15:15.38,Default,,0,0,0,,E eu também não terei de ninguém!
Dialogue: 0,1:15:16.69,1:15:17.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:16.81,1:15:17.65,Default,,0,0,0,,O meu próprio pai me vendeu!
Dialogue: 0,1:15:18.45,1:15:19.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:18.57,1:15:19.55,Default,,0,0,0,,O Cihan destruiu a minha vida!
Dialogue: 0,1:15:20.17,1:15:21.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:20.29,1:15:21.57,Default,,0,0,0,,E depois veio me ameaçar dizendo para me divorciar!
Dialogue: 0,1:15:22.24,1:15:23.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:22.36,1:15:22.94,Default,,0,0,0,,Mandou me divorciar!
Dialogue: 0,1:15:24.00,1:15:25.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:24.12,1:15:25.02,Default,,0,0,0,,Eu não vou parar, Zerrin!
Dialogue: 0,1:15:26.06,1:15:26.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:26.18,1:15:26.78,Default,,0,0,0,,Não vou parar!
Dialogue: 0,1:15:28.26,1:15:31.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:28.38,1:15:31.00,Default,,0,0,0,,Até enterrar o Cihan e o Kaya a sete palmos do chão, eu não terei paz!
Dialogue: 0,1:15:30.96,1:15:35.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:31.08,1:15:35.23,Default,,0,0,0,,E até esse dia chegar, vocês não verão diante de si um Demir humano...
Dialogue: 0,1:15:35.71,1:15:38.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:35.83,1:15:38.21,Default,,0,0,0,,Mas sim um monstro que vive exclusivamente para a vingança!
Dialogue: 0,1:15:38.69,1:15:39.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:38.81,1:15:39.29,Default,,0,0,0,,Entendeu bem?!
Dialogue: 0,1:15:40.17,1:15:41.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:15:40.29,1:15:41.18,Default,,0,0,0,,Entendeu bem?!
Dialogue: 0,1:16:07.53,1:16:09.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:07.65,1:16:09.45,Default,,0,0,0,,Demir...
Dialogue: 0,1:16:17.17,1:16:19.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:17.29,1:16:18.99,Default,,0,0,0,,Nem mesmo nessa enrascada você abriu o bico.
Dialogue: 0,1:16:19.68,1:16:21.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:19.80,1:16:21.04,Default,,0,0,0,,Tiro o chapéu para você, Ecmel.
Dialogue: 0,1:16:23.16,1:16:25.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:23.28,1:16:24.96,Default,,0,0,0,,Se você cobrir o prejuízo da perda...
Dialogue: 0,1:16:25.38,1:16:27.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:25.50,1:16:27.47,Default,,0,0,0,,Eu farei você sorrir à toa, Ecmel.
Dialogue: 0,1:16:27.43,1:16:29.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:27.55,1:16:29.13,Default,,0,0,0,,Mas isso não é suficiente!
Dialogue: 0,1:16:29.09,1:16:31.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:29.21,1:16:31.47,Default,,0,0,0,,Estamos perdendo força, Ecmel!
Dialogue: 0,1:16:31.43,1:16:36.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:31.55,1:16:36.44,Default,,0,0,0,,Para dominar tudo, temos que eliminar tanto o Cihan quanto o Kaya!
Dialogue: 0,1:16:43.33,1:16:44.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:43.45,1:16:44.49,Default,,0,0,0,,Você tem toda a razão.
Dialogue: 0,1:16:44.45,1:16:46.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:44.57,1:16:46.47,Default,,0,0,0,,Mas não se preocupe.
Dialogue: 0,1:16:46.44,1:16:48.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:46.56,1:16:48.65,Default,,0,0,0,,Eu já tenho um plano em mente.
Dialogue: 0,1:16:48.61,1:16:51.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:48.73,1:16:51.05,Default,,0,0,0,,Em breve eles não vão conseguir nem ficar de pé.
Dialogue: 0,1:16:51.01,1:16:54.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:51.13,1:16:53.97,Default,,0,0,0,,Vamos conversar pessoalmente sobre isso.
Dialogue: 0,1:16:53.93,1:16:56.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:54.05,1:16:55.85,Default,,0,0,0,,Combinado.
Dialogue: 0,1:16:56.72,1:17:00.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:16:56.84,1:17:00.36,Default,,0,0,0,,Você se acha o guardião destas terras, não é?
Dialogue: 0,1:17:10.60,1:17:14.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:17:10.72,1:17:14.70,Default,,0,0,0,,Pois serei eu a montar guarda em cima do seu túmulo!
Dialogue: 0,1:17:15.05,1:17:17.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:17:15.17,1:17:17.01,Default,,0,0,0,,Descansem um pouco.
Dialogue: 0,1:17:38.18,1:17:40.25,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:17:38.30,1:17:40.10,Default,,0,0,0,,Cihan...
Dialogue: 0,1:17:40.20,1:17:43.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:17:40.32,1:17:43.13,Default,,0,0,0,,Onde é que eu estava com a cabeça?
Dialogue: 0,1:17:47.85,1:17:51.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:17:47.97,1:17:51.37,Default,,0,0,0,,Se está passando veneno por estas terras...
Dialogue: 0,1:18:06.47,1:18:09.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:06.59,1:18:09.49,Default,,0,0,0,,É por sua culpa! Você é o único culpado!
Dialogue: 0,1:18:10.35,1:18:12.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:10.47,1:18:12.07,Default,,0,0,0,,Foi você quem causou tudo isso!
Dialogue: 0,1:18:12.05,1:18:14.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:12.17,1:18:14.37,Default,,0,0,0,,Você foi e entregou as terras de bandeja para o Şahin com as próprias mãos!
Dialogue: 0,1:18:14.39,1:18:15.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:14.51,1:18:15.25,Default,,0,0,0,,Você nos arruinou!
Dialogue: 0,1:18:15.61,1:18:18.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:15.73,1:18:18.25,Default,,0,0,0,,Agora eles vão envenenar todas estas terras!
Dialogue: 0,1:18:19.40,1:18:22.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:19.52,1:18:22.07,Default,,0,0,0,,Vão manchar o nome dos Albora!
Dialogue: 0,1:18:22.35,1:18:25.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:22.47,1:18:25.25,Default,,0,0,0,,Você mesmo entregou a chave desse lamaçal com as próprias mãos!
Dialogue: 0,1:18:25.23,1:18:26.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:25.35,1:18:26.65,Default,,0,0,0,,Foi você quem abriu as portas dessa imundície!
Dialogue: 0,1:18:27.13,1:18:29.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:27.25,1:18:29.29,Default,,0,0,0,,Vão afundar o nome dos Albora na lama!
Dialogue: 0,1:18:29.47,1:18:31.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:29.59,1:18:31.75,Default,,0,0,0,,Não passou nada, mãe! Nenhuma droga passou por estas terras!
Dialogue: 0,1:18:32.03,1:18:35.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:32.15,1:18:35.67,Default,,0,0,0,,Por enquanto! E o que vocês vão fazer, seus soberanos da terra?!
Dialogue: 0,1:18:36.44,1:18:38.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:36.56,1:18:37.88,Default,,0,0,0,,Até quando vão conseguir impedir?!
Dialogue: 0,1:18:37.84,1:18:39.69,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:37.96,1:18:39.54,Default,,0,0,0,,A terra está nas mãos deles!
Dialogue: 0,1:18:39.52,1:18:41.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:39.64,1:18:41.00,Default,,0,0,0,,E você sabe muito bem quando tudo isso começou, não sabe?!
Dialogue: 0,1:18:42.28,1:18:45.45,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:42.40,1:18:45.30,Default,,0,0,0,,Foi no dia em que a Dona Alya pisou os pés aqui!
Dialogue: 0,1:18:45.85,1:18:47.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:45.97,1:18:47.31,Default,,0,0,0,,No momento em que ela pisou nesta terra!
Dialogue: 0,1:18:47.27,1:18:47.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:47.39,1:18:47.65,Default,,0,0,0,,Chega!
Dialogue: 0,1:18:53.49,1:18:55.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:53.61,1:18:55.59,Default,,0,0,0,,Você virou as costas para o Boran!
Dialogue: 0,1:18:56.22,1:18:58.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:56.34,1:18:58.09,Default,,0,0,0,,Mãe, tome cuidado com o que você diz!
Dialogue: 0,1:18:58.23,1:19:02.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:18:58.35,1:19:01.97,Default,,0,0,0,,Você deu as costas para o Boran, eu já não reconheço mais você!
Dialogue: 0,1:19:02.58,1:19:05.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:19:02.70,1:19:05.49,Default,,0,0,0,,Você é mesmo o meu filho, o Cihan que eu dei à luz?!
Dialogue: 0,1:19:07.24,1:19:07.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:19:07.36,1:19:07.70,Default,,0,0,0,,Mãe!
Dialogue: 0,1:19:08.02,1:19:11.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:19:08.14,1:19:11.62,Default,,0,0,0,,Ou você é alguém que esfaqueou esta família pelas costas?!
Dialogue: 0,1:19:12.89,1:19:15.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:19:13.01,1:19:15.08,Default,,0,0,0,,Mãe, vá para o seu quarto!
Dialogue: 0,1:19:33.69,1:19:35.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:19:33.81,1:19:35.61,Default,,0,0,0,,Vá logo.
Dialogue: 0,1:19:51.64,1:19:53.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:19:51.76,1:19:53.60,Default,,0,0,0,,Não olhe para trás.
Dialogue: 0,1:19:57.68,1:20:02.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:19:57.80,1:20:02.82,Default,,0,0,0,,Nem ele nem nós temos mais forças para carregar um fardo tão pesado!
Dialogue: 0,1:20:18.07,1:20:20.69,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:20:18.19,1:20:20.54,Default,,0,0,0,,Não nos restam mais forças.
Dialogue: 0,1:21:10.22,1:21:12.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:10.34,1:21:12.57,Default,,0,0,0,,Posso te ajudar com isso?
Dialogue: 0,1:21:16.71,1:21:17.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:16.83,1:21:17.51,Default,,0,0,0,,Não quero.
Dialogue: 0,1:21:18.38,1:21:19.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:18.50,1:21:19.14,Default,,0,0,0,,Não quer...
Dialogue: 0,1:21:20.62,1:21:23.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:20.74,1:21:22.90,Default,,0,0,0,,A gente brigou por acaso?
Dialogue: 0,1:21:23.36,1:21:25.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:23.48,1:21:25.46,Default,,0,0,0,,Vocês ainda estão brigados, mãe?
Dialogue: 0,1:21:25.73,1:21:26.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:25.85,1:21:26.65,Default,,0,0,0,,Ainda estão de mal, mãe?
Dialogue: 0,1:21:25.73,1:21:26.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:25.85,1:21:26.65,Default,,0,0,0,,Vocês continuam brigados?
Dialogue: 0,1:21:26.18,1:21:27.25,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:26.30,1:21:27.10,Default,,0,0,0,,Ainda estão brigados?
Dialogue: 0,1:21:26.20,1:21:27.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:26.32,1:21:27.12,Default,,0,0,0,,Vocês continuam chateados?
Dialogue: 0,1:21:26.24,1:21:27.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:26.36,1:21:27.16,Default,,0,0,0,,Ainda estão de mal, mãe?
Dialogue: 0,1:21:26.50,1:21:27.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:26.62,1:21:27.50,Default,,0,0,0,,Vocês continuam brigados?
Dialogue: 0,1:21:27.46,1:21:28.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:27.58,1:21:28.38,Default,,0,0,0,,Ainda não estão se falando?
Dialogue: 0,1:21:27.92,1:21:28.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:28.04,1:21:28.84,Default,,0,0,0,,Continuam brigados, mãe?
Dialogue: 0,1:21:28.44,1:21:29.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:28.56,1:21:29.50,Default,,0,0,0,,Vocês ainda estão brigados?
Dialogue: 0,1:21:29.46,1:21:31.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:29.58,1:21:31.42,Default,,0,0,0,,Mas nós estamos mesmo brigados com o seu pai, meu amor?
Dialogue: 0,1:21:31.38,1:21:32.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:31.50,1:21:32.46,Default,,0,0,0,,Diz, vocês ainda estão brigados, mãe?
Dialogue: 0,1:21:32.42,1:21:34.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:32.54,1:21:34.29,Default,,0,0,0,,Pronto, cheguei.
Dialogue: 0,1:21:34.35,1:21:36.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:34.47,1:21:36.21,Default,,0,0,0,,Não precisa fingir para mim, mãe, vai.
Dialogue: 0,1:21:36.39,1:21:38.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:36.51,1:21:38.45,Default,,0,0,0,,Meu filho, agora é hora disso?
Dialogue: 0,1:21:38.41,1:21:40.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:38.53,1:21:40.61,Default,,0,0,0,,Não, nós não estamos brigados! Acredite na gente.
Dialogue: 0,1:21:40.87,1:21:43.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:40.99,1:21:43.21,Default,,0,0,0,,Como se eu não percebesse... Vocês estão brigados, sim!
Dialogue: 0,1:21:43.43,1:21:45.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:43.55,1:21:44.99,Default,,0,0,0,,Cihan, o que está acontecendo com esse menino?
Dialogue: 0,1:21:45.37,1:21:47.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:45.49,1:21:46.98,Default,,0,0,0,,Ele achou vocês dois meio esquisitos.
Dialogue: 0,1:21:48.90,1:21:52.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:49.02,1:21:51.96,Default,,0,0,0,,Venha cá, vamos ajeitar a sua roupa.
Dialogue: 0,1:21:52.92,1:21:54.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:53.04,1:21:54.70,Default,,0,0,0,,O café da manhã está pronto, Dona Alya, Sr. Cihan.
Dialogue: 0,1:21:54.66,1:21:57.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:54.78,1:21:57.28,Default,,0,0,0,,Eu não vou tomar café agora, Pakize.
Dialogue: 0,1:21:58.14,1:22:00.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:21:58.26,1:22:00.16,Default,,0,0,0,,Nós também já vamos.
Dialogue: 0,1:22:00.50,1:22:00.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:00.62,1:22:00.82,Default,,0,0,0,,Tá bom.
Dialogue: 0,1:22:00.86,1:22:01.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:00.98,1:22:01.78,Default,,0,0,0,,Nós também estaremos lá.
Dialogue: 0,1:22:01.68,1:22:02.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:01.80,1:22:02.66,Default,,0,0,0,,Não, não venham até aqui.
Dialogue: 0,1:22:03.10,1:22:04.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:03.22,1:22:04.24,Default,,0,0,0,,Vamos, Pakize.
Dialogue: 0,1:22:04.78,1:22:06.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:04.90,1:22:06.01,Default,,0,0,0,,Então vocês estão bem.
Dialogue: 0,1:22:16.34,1:22:19.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:16.46,1:22:19.07,Default,,0,0,0,,Olha só o que aconteceu aqui...
Dialogue: 0,1:22:33.25,1:22:34.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:33.37,1:22:33.98,Default,,0,0,0,,Deixe que ele entenda.
Dialogue: 0,1:22:40.23,1:22:43.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:40.35,1:22:43.75,Default,,0,0,0,,O Deniz não vai entrar naquele quarto, mãe.
Dialogue: 0,1:22:48.34,1:22:50.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:48.46,1:22:50.48,Default,,0,0,0,,E se eu puxar ele pelo braço e colocar lá dentro, o que você vai fazer?
Dialogue: 0,1:22:50.44,1:22:54.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:50.56,1:22:53.86,Default,,0,0,0,,Vou pegar você pela mão e te levar direto para a delegacia.
Dialogue: 0,1:22:54.23,1:22:56.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:22:54.35,1:22:56.49,Default,,0,0,0,,Vou fazer você confessar que matou a Mine, mãe.
Dialogue: 0,1:23:02.78,1:23:06.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:02.90,1:23:06.03,Default,,0,0,0,,Alô, Fatoş, minha filha, como vai você?
Dialogue: 0,1:23:19.37,1:23:21.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:19.49,1:23:21.11,Default,,0,0,0,,Estou bem, Dona Sadakat, muito obrigada.
Dialogue: 0,1:23:21.64,1:23:22.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:21.76,1:23:22.24,Default,,0,0,0,,Deus lhe abençoe.
Dialogue: 0,1:23:22.75,1:23:24.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:22.87,1:23:24.21,Default,,0,0,0,,Graças à senhora comecei a trabalhar no plantão.
Dialogue: 0,1:23:24.43,1:23:25.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:24.55,1:23:25.59,Default,,0,0,0,,Que Deus lhe recompense por tudo.
Dialogue: 0,1:23:25.81,1:23:27.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:25.93,1:23:27.01,Default,,0,0,0,,Não há de quê, minha filha.
Dialogue: 0,1:23:27.49,1:23:29.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:27.61,1:23:29.77,Default,,0,0,0,,Uma mãe protege e cuida dos seus filhos.
Dialogue: 0,1:23:30.10,1:23:31.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:30.22,1:23:31.22,Default,,0,0,0,,Se passarem fome, ela alimenta.
Dialogue: 0,1:23:32.54,1:23:36.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:32.66,1:23:35.96,Default,,0,0,0,,Nós colocamos você na maternidade do hospital, não foi?
Dialogue: 0,1:23:36.53,1:23:38.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:36.65,1:23:38.00,Default,,0,0,0,,Sim, sim, Dona Sadakat.
Dialogue: 0,1:23:38.16,1:23:40.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:38.28,1:23:39.98,Default,,0,0,0,,Sou a enfermeira da sua nora, Dona Alya.
Dialogue: 0,1:23:41.01,1:23:42.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:41.13,1:23:42.63,Default,,0,0,0,,Muito bem, minha filha.
Dialogue: 0,1:23:42.59,1:23:45.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:42.71,1:23:44.93,Default,,0,0,0,,Muito bem. Eu tenho um favorzinho para te pedir.
Dialogue: 0,1:23:44.89,1:23:48.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:45.01,1:23:48.11,Default,,0,0,0,,Hoje vou dar uma passada aí para te ver pessoalmente, está bem?
Dialogue: 0,1:23:48.07,1:23:50.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:48.19,1:23:50.48,Default,,0,0,0,,Claro, com o maior prazer.
Dialogue: 0,1:23:51.21,1:23:53.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:51.33,1:23:52.97,Default,,0,0,0,,O que a senhora precisar.
Dialogue: 0,1:23:52.93,1:23:55.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:53.05,1:23:54.85,Default,,0,0,0,,Está certo.
Dialogue: 0,1:23:56.63,1:23:59.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:23:56.75,1:23:59.23,Default,,0,0,0,,Nós vamos nos ver, Dona Alya.
Dialogue: 0,1:24:01.84,1:24:04.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:01.96,1:24:04.51,Default,,0,0,0,,Nós vamos acertar as contas...
Dialogue: 0,1:24:04.90,1:24:07.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:05.02,1:24:07.38,Default,,0,0,0,,Dona Alya, vai querer ovos?
Dialogue: 0,1:24:12.20,1:24:15.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:12.32,1:24:15.19,Default,,0,0,0,,Vou te servir um salgado quentinho.
Dialogue: 0,1:24:15.43,1:24:17.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:15.55,1:24:17.26,Default,,0,0,0,,Obrigada, agradeço o carinho.
Dialogue: 0,1:24:17.22,1:24:20.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:17.34,1:24:20.02,Default,,0,0,0,,Pakize, me dá um pedaço também, vamos ver se acabo com esse tormento.
Dialogue: 0,1:24:19.98,1:24:21.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:20.10,1:24:21.31,Default,,0,0,0,,Dou sim, meu querido.
Dialogue: 0,1:24:21.27,1:24:22.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:21.39,1:24:22.32,Default,,0,0,0,,Obrigado.
Dialogue: 0,1:24:22.28,1:24:23.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:22.40,1:24:23.57,Default,,0,0,0,,Bom apetite.
Dialogue: 0,1:24:23.53,1:24:28.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:24:23.65,1:24:28.47,Default,,0,0,0,,O doutor disse que são necessários alguns materiais para o Boran.
Dialogue: 0,1:25:01.40,1:25:03.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:01.52,1:25:03.69,Default,,0,0,0,,Eu sei, vou cuidar disso hoje.
Dialogue: 0,1:25:03.65,1:25:07.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:03.77,1:25:06.97,Default,,0,0,0,,Kaya, cuide disso você mesmo, meu filho.
Dialogue: 0,1:25:11.44,1:25:14.25,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:11.56,1:25:14.10,Default,,0,0,0,,Vá até o nosso hospital, pegue tudo o que for necessário e traga imediatamente.
Dialogue: 0,1:25:19.67,1:25:22.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:19.79,1:25:22.60,Default,,0,0,0,,Tá bom, eu pego, mãe, pode deixar.
Dialogue: 0,1:25:30.21,1:25:32.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:30.33,1:25:32.17,Default,,0,0,0,,Marcaram o casamento para o final do mês.
Dialogue: 0,1:25:33.57,1:25:37.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:33.69,1:25:37.34,Default,,0,0,0,,É isso aí. Com o meu irmão Boran nessa situação, não vamos ficar em festa.
Dialogue: 0,1:25:38.74,1:25:41.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:38.86,1:25:40.98,Default,,0,0,0,,Não me surpreende, de vocês se espera qualquer coisa.
Dialogue: 0,1:25:44.34,1:25:46.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:44.46,1:25:46.26,Default,,0,0,0,,Marcaram o dia.
Dialogue: 0,1:25:47.89,1:25:48.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:48.01,1:25:48.73,Default,,0,0,0,,Tomamos essa decisão.
Dialogue: 0,1:25:49.33,1:25:50.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:49.45,1:25:50.76,Default,,0,0,0,,Veja se não enrola.
Dialogue: 0,1:25:51.51,1:25:52.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:51.63,1:25:52.65,Default,,0,0,0,,Resolva esse assunto o quanto antes.
Dialogue: 0,1:25:53.45,1:26:01.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:25:53.57,1:26:01.07,Default,,0,0,0,,Mãe, e se o Boran não acordar até lá? Quando a İpek se mudar para a mansão e der de cara com o Boran, o que vai acontecer?
Dialogue: 0,1:26:02.38,1:26:06.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:26:02.50,1:26:06.13,Default,,0,0,0,,Até lá o meu filho já estará de pé! Ele vai se curar!
Dialogue: 0,1:26:06.09,1:26:13.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:26:06.21,1:26:13.71,Default,,0,0,0,,Mãe, a gente não tem como prever isso, Deus me perdoe! Vamos adiar, ou então nós passamos um tempo na mansão de Midyat, irmão.
Dialogue: 0,1:26:15.59,1:26:23.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:26:15.71,1:26:23.21,Default,,0,0,0,,Seria bem mais sensato assim. Olha, essa é uma ótima ideia! E quando o Boran se recuperar, ele volta para perto da gente...
Dialogue: 0,1:26:25.41,1:26:32.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:26:25.53,1:26:32.76,Default,,0,0,0,,Vocês voltam, e ficaremos todos juntos... Se Deus quiser, seremos aquela mesma família unida de antes.
Dialogue: 0,1:26:54.06,1:27:01.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:26:54.18,1:27:01.68,Default,,0,0,0,,Me passa o salgado aí, irmão, e o queijo também. A gente nem conseguiu falar sobre o assunto da Zerrin, né? Pois é, naquele outro dia...
Dialogue: 0,1:27:44.60,1:27:47.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:27:44.72,1:27:46.87,Default,,0,0,0,,Nossa conversa ficou pela metade.
Dialogue: 0,1:27:47.31,1:27:49.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:27:47.43,1:27:49.48,Default,,0,0,0,,Nós conversamos. Mas naquele dia você deu uma passada rápida no hospital e foi embora...
Dialogue: 0,1:27:49.44,1:27:51.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:27:49.56,1:27:51.65,Default,,0,0,0,,E quando você saiu, eu...
Dialogue: 0,1:27:51.61,1:27:54.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:27:51.73,1:27:54.49,Default,,0,0,0,,Eu, a Zerrin e a Nare nos sentamos e conversamos durante um bom tempo.
Dialogue: 0,1:27:54.45,1:27:57.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:27:54.57,1:27:57.60,Default,,0,0,0,,A Zerrin nos contou tudo. Em primeiro lugar...
Dialogue: 0,1:27:57.56,1:27:59.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:27:57.68,1:27:59.70,Default,,0,0,0,,Ela não quer de jeito nenhum que o Kaya saiba.
Dialogue: 0,1:28:00.09,1:28:02.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:00.21,1:28:01.85,Default,,0,0,0,,Ela disse: 'O Demir nunca vai me dar o divórcio'.
Dialogue: 0,1:28:02.41,1:28:06.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:02.53,1:28:06.43,Default,,0,0,0,,Por quê? Qual é o motivo? Ele se casou por vingança, mas...
Dialogue: 0,1:28:06.39,1:28:08.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:06.51,1:28:08.29,Default,,0,0,0,,Ela disse que agora as coisas mudaram.
Dialogue: 0,1:28:08.25,1:28:12.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:08.37,1:28:12.12,Default,,0,0,0,,Ela disse: 'Acho que ele começou a gostar de mim'.
Dialogue: 0,1:28:12.08,1:28:14.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:12.20,1:28:14.00,Default,,0,0,0,,O quê?!
Dialogue: 0,1:28:18.63,1:28:21.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:18.75,1:28:21.49,Default,,0,0,0,,É claro, a situação só ia piorar.
Dialogue: 0,1:28:23.11,1:28:24.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:23.23,1:28:24.69,Default,,0,0,0,,A Nare disse exatamente a mesma coisa.
Dialogue: 0,1:28:25.39,1:28:27.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:25.51,1:28:27.75,Default,,0,0,0,,Ele já perdeu a Şeda. Agora, para não perder a Zerrin, ele é capaz de qualquer loucura.
Dialogue: 0,1:28:27.71,1:28:30.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:27.83,1:28:29.93,Default,,0,0,0,,Ou seja, o Demir não vai conceder o divórcio de jeito nenhum.
Dialogue: 0,1:28:29.89,1:28:32.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:30.01,1:28:32.03,Default,,0,0,0,,Não importa o que você faça.
Dialogue: 0,1:28:31.99,1:28:34.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:32.11,1:28:34.37,Default,,0,0,0,,E contar isso para o Kaya agora seria uma loucura.
Dialogue: 0,1:28:34.33,1:28:36.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:34.45,1:28:36.56,Default,,0,0,0,,Só serviria para transtornar a cabeça dele.
Dialogue: 0,1:28:36.54,1:28:39.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:36.66,1:28:39.07,Default,,0,0,0,,Não adiantaria nada. O garoto está prestes a se casar.
Dialogue: 0,1:28:39.03,1:28:41.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:39.15,1:28:41.01,Default,,0,0,0,,Ele ia largar tudo e terminar com a İpek.
Dialogue: 0,1:28:40.99,1:28:43.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:41.11,1:28:43.44,Default,,0,0,0,,E aí a família da İpek viria com sangue nos olhos para cima de vocês.
Dialogue: 0,1:28:43.40,1:28:45.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:43.52,1:28:45.16,Default,,0,0,0,,Mesmo que você desse um jeito nisso...
Dialogue: 0,1:28:45.18,1:28:47.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:45.30,1:28:47.38,Default,,0,0,0,,Eles poderiam ficar juntos? O Kaya e a Zerrin conseguiriam ser felizes?
Dialogue: 0,1:28:47.34,1:28:50.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:47.46,1:28:50.47,Default,,0,0,0,,Não! Os dois sairiam completamente destruídos.
Dialogue: 0,1:28:50.43,1:28:54.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:50.55,1:28:53.95,Default,,0,0,0,,Por isso, é melhor a gente não contar nada.
Dialogue: 0,1:28:56.88,1:29:00.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:28:57.00,1:29:00.52,Default,,0,0,0,,Estou certa? Ou você acha que estou falando besteira, pelo amor de Deus?
Dialogue: 0,1:29:00.48,1:29:03.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:00.60,1:29:03.48,Default,,0,0,0,,Está certo. Não vamos contar nada ao Kaya.
Dialogue: 0,1:29:03.44,1:29:05.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:03.56,1:29:05.36,Default,,0,0,0,,Vamos esperar um pouco. Vamos ver o que acontece.
Dialogue: 0,1:29:05.32,1:29:09.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:05.44,1:29:08.90,Default,,0,0,0,,O que é que eu vou pensar? O que posso pensar?
Dialogue: 0,1:29:10.50,1:29:14.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:10.62,1:29:14.67,Default,,0,0,0,,Você já previu tudo isso com tanta precisão. Imagina também o que mais pode acontecer.
Dialogue: 0,1:29:14.92,1:29:19.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:15.04,1:29:19.08,Default,,0,0,0,,Eu já imagino perfeitamente o que você está pensando. Por isso mesmo estou falando. No que você está pensando afinal?
Dialogue: 0,1:29:19.34,1:29:22.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:19.46,1:29:22.58,Default,,0,0,0,,Irmão, estou indo para o hospital. Precisa de mais alguma coisa?
Dialogue: 0,1:29:23.36,1:29:26.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:23.48,1:29:26.19,Default,,0,0,0,,Até mais tarde, então. Vou para o hospital.
Dialogue: 0,1:29:31.23,1:29:31.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:31.35,1:29:31.83,Default,,0,0,0,,Deniz, meu filho...
Dialogue: 0,1:29:32.09,1:29:34.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:32.21,1:29:34.11,Default,,0,0,0,,Espera. Parem, eu não quero!
Dialogue: 0,1:29:36.77,1:29:40.67,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:36.89,1:29:40.52,Default,,0,0,0,,Meu amor, não faz assim com a mamãe, por favor.
Dialogue: 0,1:29:40.67,1:29:43.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:40.79,1:29:43.51,Default,,0,0,0,,Não! Enquanto vocês não fizerem as pazes, não cheguem perto de mim!
Dialogue: 0,1:29:45.46,1:29:47.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:45.58,1:29:46.94,Default,,0,0,0,,Não posso nem te dar um beijo?
Dialogue: 0,1:29:47.09,1:29:47.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:47.21,1:29:47.73,Default,,0,0,0,,Não pode.
Dialogue: 0,1:29:49.37,1:29:50.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:29:49.49,1:29:50.73,Default,,0,0,0,,Está bem.
Dialogue: 0,1:30:02.42,1:30:03.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:02.54,1:30:03.72,Default,,0,0,0,,Nem eu?
Dialogue: 0,1:30:03.92,1:30:05.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:04.04,1:30:05.29,Default,,0,0,0,,Sim, você também não!
Dialogue: 0,1:30:06.83,1:30:09.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:06.95,1:30:09.33,Default,,0,0,0,,Tudo bem, então. Eu já vou indo. Vamos lá.
Dialogue: 0,1:30:10.08,1:30:11.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:10.20,1:30:11.66,Default,,0,0,0,,Eles ficam aqui.
Dialogue: 0,1:30:11.84,1:30:14.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:11.96,1:30:14.26,Default,,0,0,0,,Vou ter uma conversa muito importante com eles.
Dialogue: 0,1:30:19.99,1:30:21.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:20.11,1:30:20.87,Default,,0,0,0,,Venham logo.
Dialogue: 0,1:30:21.56,1:30:22.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:21.68,1:30:22.05,Default,,0,0,0,,Venham.
Dialogue: 0,1:30:22.61,1:30:24.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:22.73,1:30:24.05,Default,,0,0,0,,Anda logo, ele está chamando você.
Dialogue: 0,1:30:24.05,1:30:25.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:24.17,1:30:25.27,Default,,0,0,0,,Venham logo!
Dialogue: 0,1:30:27.71,1:30:29.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:27.83,1:30:29.57,Default,,0,0,0,,O senhor já pode ir para a empresa.
Dialogue: 0,1:30:29.83,1:30:31.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:29.95,1:30:31.03,Default,,0,0,0,,Eles vão depois.
Dialogue: 0,1:30:31.09,1:30:32.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:31.21,1:30:32.59,Default,,0,0,0,,Desculpe aí, pequeno chefe, não percebi.
Dialogue: 0,1:30:32.87,1:30:34.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:32.99,1:30:33.97,Default,,0,0,0,,Venham vocês dois também.
Dialogue: 0,1:30:34.25,1:30:35.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:34.37,1:30:35.09,Default,,0,0,0,,O que será que ele quer falar?
Dialogue: 0,1:30:35.38,1:30:37.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:35.50,1:30:36.86,Default,,0,0,0,,Como vou saber o que vocês vão falar?
Dialogue: 0,1:30:36.82,1:30:37.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:36.94,1:30:37.38,Default,,0,0,0,,Ai, meu Deus do céu.
Dialogue: 0,1:30:38.48,1:30:40.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:38.60,1:30:40.25,Default,,0,0,0,,O garoto já está se preparando para assumir o comando, hein!
Dialogue: 0,1:30:41.62,1:30:43.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:41.74,1:30:43.77,Default,,0,0,0,,Depois me contem tudo.
Dialogue: 0,1:30:47.00,1:30:49.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:47.12,1:30:48.92,Default,,0,0,0,,O que manda?
Dialogue: 0,1:30:49.35,1:30:50.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:49.47,1:30:50.20,Default,,0,0,0,,Tenho o que fazer.
Dialogue: 0,1:30:54.79,1:30:57.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:30:54.91,1:30:57.78,Default,,0,0,0,,Somos todos ouvidos, pequeno chefe.
Dialogue: 0,1:31:02.67,1:31:04.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:02.79,1:31:04.31,Default,,0,0,0,,Muito bem: o que está acontecendo nesta mansão?
Dialogue: 0,1:31:04.27,1:31:07.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:04.39,1:31:07.34,Default,,0,0,0,,Pela minha vida, eu não sei de nada! Não está acontecendo nada, nada!
Dialogue: 0,1:31:07.30,1:31:10.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:07.42,1:31:10.36,Default,,0,0,0,,Mentira! Minha mãe e meu pai não olham na cara um do outro!
Dialogue: 0,1:31:10.32,1:31:13.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:10.44,1:31:13.40,Default,,0,0,0,,Olharam sim, eu mesmo vi hoje! Não tem nada disso!
Dialogue: 0,1:31:13.36,1:31:17.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:13.48,1:31:17.55,Default,,0,0,0,,Não me engane! A minha mãe e o meu pai estão brigados!
Dialogue: 0,1:31:17.51,1:31:19.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:17.63,1:31:19.55,Default,,0,0,0,,Meu anjinho, isso acontece às vezes.
Dialogue: 0,1:31:19.51,1:31:22.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:19.63,1:31:22.51,Default,,0,0,0,,Eu e o Muzaffer nos desentendemos de vez em quando também.
Dialogue: 0,1:31:22.47,1:31:24.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:22.59,1:31:24.51,Default,,0,0,0,,Nos desentendemos, é normal.
Dialogue: 0,1:31:24.47,1:31:27.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:24.59,1:31:27.51,Default,,0,0,0,,Não quero que briguem, quero que fiquem juntos como antes!
Dialogue: 0,1:31:27.47,1:31:31.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:27.59,1:31:30.92,Default,,0,0,0,,Temos que fazer alguma coisa para eles fazerem as pazes!
Dialogue: 0,1:31:30.88,1:31:35.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:31.00,1:31:35.84,Default,,0,0,0,,Meu querido Deniz, em briga de marido e mulher não se mete a colher, entendeu?
Dialogue: 0,1:31:35.80,1:31:37.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:35.92,1:31:36.96,Default,,0,0,0,,Tá bom?
Dialogue: 0,1:31:37.08,1:31:38.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:37.20,1:31:38.18,Default,,0,0,0,,Ele tem toda razão.
Dialogue: 0,1:31:38.35,1:31:41.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:38.47,1:31:41.08,Default,,0,0,0,,Vamos preparar um jantar romântico para eles!
Dialogue: 0,1:31:41.48,1:31:45.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:41.60,1:31:45.06,Default,,0,0,0,,Velas, bolo, guardanapo de coração e flores!
Dialogue: 0,1:31:48.37,1:31:49.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:48.49,1:31:49.65,Default,,0,0,0,,E uma comida deliciosa!
Dialogue: 0,1:31:49.97,1:31:52.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:50.09,1:31:52.53,Default,,0,0,0,,Então colocamos também um letreiro luminoso!
Dialogue: 0,1:31:52.89,1:31:54.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:53.01,1:31:54.53,Default,,0,0,0,,Um letreiro dizendo 'Festa da Reconciliação'!
Dialogue: 0,1:31:54.59,1:31:55.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:54.71,1:31:55.09,Default,,0,0,0,,Bem iluminado!
Dialogue: 0,1:31:55.30,1:31:56.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:55.42,1:31:56.73,Default,,0,0,0,,Sim! Vai ficar lindo demais!
Dialogue: 0,1:31:56.71,1:31:57.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:56.83,1:31:57.47,Default,,0,0,0,,Toca aqui!
Dialogue: 0,1:31:57.57,1:31:59.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:57.69,1:31:59.37,Default,,0,0,0,,Toca aqui, bate aí!
Dialogue: 0,1:31:59.33,1:32:01.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:31:59.45,1:32:01.77,Default,,0,0,0,,Eu vou te dar uma bolacha já, já, Kadir!
Dialogue: 0,1:32:02.73,1:32:04.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:02.85,1:32:04.75,Default,,0,0,0,,Meu querido, meu anjinho, me escuta...
Dialogue: 0,1:32:04.77,1:32:07.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:04.89,1:32:07.13,Default,,0,0,0,,A sua mãe e o seu pai estão trabalhando demais ultimamente.
Dialogue: 0,1:32:07.09,1:32:08.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:07.21,1:32:07.85,Default,,0,0,0,,Entendeu?
Dialogue: 0,1:32:08.20,1:32:15.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:08.32,1:32:15.17,Default,,0,0,0,,Será que a gente não poderia adiar esse jantar romântico para mais tarde, fazer em um outro momento?
Dialogue: 0,1:32:15.13,1:32:18.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:15.25,1:32:18.25,Default,,0,0,0,,Não! Se continuarem magoados, nunca vão fazer as pazes!
Dialogue: 0,1:32:18.73,1:32:20.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:18.85,1:32:20.45,Default,,0,0,0,,Juro que eu fico de mal com vocês todos!
Dialogue: 0,1:32:20.51,1:32:23.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:20.63,1:32:22.85,Default,,0,0,0,,Deniz, não fala assim! Não fica chateado, meu anjinho.
Dialogue: 0,1:32:23.01,1:32:24.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:23.13,1:32:23.97,Default,,0,0,0,,Então vamos fazer o seguinte.
Dialogue: 0,1:32:24.83,1:32:27.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:24.95,1:32:27.63,Default,,0,0,0,,Dá uma licencinha para a gente agora, pequeno chefe.
Dialogue: 0,1:32:27.63,1:32:30.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:27.75,1:32:30.31,Default,,0,0,0,,Nós do conselho vamos nos reunir para tomar uma decisão.
Dialogue: 0,1:32:30.27,1:32:32.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:30.39,1:32:31.85,Default,,0,0,0,,Depois a gente te chama. Pode ser?
Dialogue: 0,1:32:32.03,1:32:34.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:32.15,1:32:34.40,Default,,0,0,0,,Mas sejam rápidos, meu pai está esperando vocês.
Dialogue: 0,1:32:35.67,1:32:38.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:35.79,1:32:38.34,Default,,0,0,0,,Ele tem razão, tem toda razão.
Dialogue: 0,1:32:39.77,1:32:42.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:39.89,1:32:42.20,Default,,0,0,0,,Meu Deus, olha só a pose desse garoto andando!
Dialogue: 0,1:32:42.38,1:32:43.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:42.50,1:32:43.12,Default,,0,0,0,,É o Cihan todinho!
Dialogue: 0,1:32:43.27,1:32:44.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:43.39,1:32:44.37,Default,,0,0,0,,Um minipatrão!
Dialogue: 0,1:32:44.75,1:32:45.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:44.87,1:32:45.07,Default,,0,0,0,,Foi embora...
Dialogue: 0,1:32:45.40,1:32:46.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:45.52,1:32:45.93,Default,,0,0,0,,Sumiu...
Dialogue: 0,1:32:46.10,1:32:47.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:46.22,1:32:47.34,Default,,0,0,0,,Mas esperem aí, parem e pensem.
Dialogue: 0,1:32:47.54,1:32:48.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:47.66,1:32:48.32,Default,,0,0,0,,Olha só o que eu digo:
Dialogue: 0,1:32:48.78,1:32:51.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:48.90,1:32:51.78,Default,,0,0,0,,Se a gente montar essa mesa, a Dona Sadakat bota a gente na rua!
Dialogue: 0,1:32:51.94,1:32:53.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:52.06,1:32:52.86,Default,,0,0,0,,Bota mesmo!
Dialogue: 0,1:32:52.52,1:32:53.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:52.64,1:32:53.38,Default,,0,0,0,,Que botar na rua o quê!
Dialogue: 0,1:32:53.38,1:32:55.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:53.50,1:32:55.66,Default,,0,0,0,,Além de botar na rua, ela corta a gente em pedacinhos!
Dialogue: 0,1:32:56.11,1:32:57.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:56.23,1:32:57.28,Default,,0,0,0,,E agora, olha que encrenca!
Dialogue: 0,1:32:57.73,1:33:00.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:32:57.85,1:33:00.65,Default,,0,0,0,,Será que isso tem cabimento agora? Esse jantar romântico...
Dialogue: 0,1:33:00.61,1:33:02.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:00.73,1:33:02.37,Default,,0,0,0,,Com o Sr. Boran de cama desse jeito, tem cabimento uma coisa dessas?!
Dialogue: 0,1:33:02.51,1:33:05.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:02.63,1:33:05.64,Default,,0,0,0,,Mas a situação do Cihan e da Dona Alya já está um desastre.
Dialogue: 0,1:33:05.86,1:33:06.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:05.98,1:33:06.62,Default,,0,0,0,,Talvez faça bem para eles.
Dialogue: 0,1:33:07.54,1:33:11.13,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:07.66,1:33:10.98,Default,,0,0,0,,Olha lá, ele está esperando! Se a gente recusar, ele vai chorar sem parar!
Dialogue: 0,1:33:10.94,1:33:12.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:11.06,1:33:12.32,Default,,0,0,0,,E o que vamos fazer, então?
Dialogue: 0,1:33:12.66,1:33:14.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:12.78,1:33:14.41,Default,,0,0,0,,Olha, eu volto para o início da conversa:
Dialogue: 0,1:33:14.57,1:33:17.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:14.69,1:33:17.25,Default,,0,0,0,,A Dona Sadakat vai botar a gente na rua!
Dialogue: 0,1:33:17.21,1:33:19.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:17.33,1:33:19.38,Default,,0,0,0,,Não vai botar porque ela não vai ver!
Dialogue: 0,1:33:19.34,1:33:20.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:19.46,1:33:20.26,Default,,0,0,0,,Como não vai ver, cara?!
Dialogue: 0,1:33:20.16,1:33:21.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:20.28,1:33:21.51,Default,,0,0,0,,À noite eles vão para a oração do <i>Mevlüt</i>.
Dialogue: 0,1:33:21.47,1:33:22.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:21.59,1:33:22.63,Default,,0,0,0,,Com certeza eles vão sim!
Dialogue: 0,1:33:22.59,1:33:23.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:22.71,1:33:23.51,Default,,0,0,0,,É sério?!
Dialogue: 0,1:33:23.31,1:33:26.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:23.43,1:33:26.27,Default,,0,0,0,,A gente monta tudo rapidinho antes que percebam.
Dialogue: 0,1:33:26.23,1:33:27.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:26.35,1:33:27.39,Default,,0,0,0,,Olha, na minha cabeça ela já demitiu a gente...
Dialogue: 0,1:33:27.35,1:33:29.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:27.47,1:33:28.87,Default,,0,0,0,,Anda, disfarça logo, cara.
Dialogue: 0,1:33:28.83,1:33:31.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:28.95,1:33:30.88,Default,,0,0,0,,Muito bem, pequeno chefe!
Dialogue: 0,1:33:30.84,1:33:33.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:30.96,1:33:33.63,Default,,0,0,0,,Poderia vir até aqui um instante?
Dialogue: 0,1:33:33.59,1:33:35.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:33.71,1:33:35.74,Default,,0,0,0,,E aí, já se decidiram?
Dialogue: 0,1:33:37.52,1:33:39.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:37.64,1:33:39.82,Default,,0,0,0,,Pois bem, meu senhor, o nosso conselho decidiu!
Dialogue: 0,1:33:39.78,1:33:42.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:39.90,1:33:42.77,Default,,0,0,0,,Nós vamos montar uma mesa nota dez!
Dialogue: 0,1:33:44.02,1:33:46.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:44.14,1:33:45.94,Default,,0,0,0,,Que maravilha!
Dialogue: 0,1:33:46.19,1:33:47.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:46.31,1:33:47.75,Default,,0,0,0,,Você é um campeão!
Dialogue: 0,1:33:47.71,1:33:49.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:47.83,1:33:49.83,Default,,0,0,0,,Vamos preparar tudo com muito carinho para você, meu pequeno.
Dialogue: 0,1:33:49.79,1:33:52.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:49.91,1:33:52.33,Default,,0,0,0,,O bolo fica por nossa conta!
Dialogue: 0,1:33:53.92,1:34:01.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:33:54.04,1:34:01.20,Default,,0,0,0,,Patrão Cihan... Fomos obrigados, pela vida que a gente tem! Fomos forçados, o menino insistiu demais.
Dialogue: 0,1:34:06.09,1:34:13.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:06.21,1:34:13.71,Default,,0,0,0,,Claro, claro... Patrão, quer dizer, velas, guardanapos... guardanapo de coração, flores... Será que a gente não põe essas coisas?
Dialogue: 0,1:34:19.80,1:34:21.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:19.92,1:34:21.72,Default,,0,0,0,,Não colocamos?
Dialogue: 0,1:34:23.15,1:34:25.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:23.27,1:34:25.07,Default,,0,0,0,,Não colocamos.
Dialogue: 0,1:34:25.34,1:34:30.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:25.46,1:34:30.48,Default,,0,0,0,,Não colocamos... E bolo em formato de coração, também não colocamos?
Dialogue: 0,1:34:31.49,1:34:32.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:31.61,1:34:32.48,Default,,0,0,0,,Não colocamos, Kadir.
Dialogue: 0,1:34:32.56,1:34:33.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:32.68,1:34:33.28,Default,,0,0,0,,Nem isso colocamos.
Dialogue: 0,1:34:33.24,1:34:33.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:33.36,1:34:33.78,Default,,0,0,0,,Tá certo, nada disso.
Dialogue: 0,1:34:38.06,1:34:42.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:38.18,1:34:41.91,Default,,0,0,0,,Patrão Cihan, nós sabemos muito bem que é uma situação dificílima, muito difícil mesmo.
Dialogue: 0,1:34:41.87,1:34:45.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:41.99,1:34:45.07,Default,,0,0,0,,É uma situação muito difícil, mas ficamos com pena do menino.
Dialogue: 0,1:34:45.31,1:34:46.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:45.43,1:34:46.67,Default,,0,0,0,,Ficamos com pena, com muita pena.
Dialogue: 0,1:34:46.63,1:34:48.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:46.75,1:34:48.21,Default,,0,0,0,,Ele também é como um filho para você.
Dialogue: 0,1:34:48.29,1:34:49.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:48.41,1:34:49.69,Default,,0,0,0,,Ele é a nossa vida também.
Dialogue: 0,1:34:49.88,1:34:51.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:50.00,1:34:51.62,Default,,0,0,0,,Se ele quer alguma coisa, não tem jeito, a gente faz.
Dialogue: 0,1:34:51.68,1:34:52.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:51.80,1:34:52.04,Default,,0,0,0,,Tá bom.
Dialogue: 0,1:34:52.95,1:34:54.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:53.07,1:34:54.29,Default,,0,0,0,,Então vamos saindo nós dois.
Dialogue: 0,1:34:54.43,1:34:54.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:54.55,1:34:54.81,Default,,0,0,0,,Tá bem.
Dialogue: 0,1:34:54.99,1:34:55.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:55.11,1:34:55.67,Default,,0,0,0,,Anda logo.
Dialogue: 0,1:34:55.87,1:34:57.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:55.99,1:34:57.19,Default,,0,0,0,,É, anda logo, Kadir, vamos.
Dialogue: 0,1:34:57.41,1:35:01.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:34:57.53,1:35:01.38,Default,,0,0,0,,Olha só, Kadir, não fica dando muito palpite, não.
Dialogue: 0,1:35:02.14,1:35:03.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:02.26,1:35:03.73,Default,,0,0,0,,Vem, Kadir, anda, vem, vem.
Dialogue: 0,1:35:03.71,1:35:05.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:03.83,1:35:05.27,Default,,0,0,0,,Você se preocupa demais com essas coisas, cara.
Dialogue: 0,1:35:05.49,1:35:06.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:05.61,1:35:06.27,Default,,0,0,0,,Vem logo, cara!
Dialogue: 0,1:35:06.43,1:35:07.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:06.55,1:35:07.41,Default,,0,0,0,,Não empurra, só vem.
Dialogue: 0,1:35:07.99,1:35:09.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:08.11,1:35:08.93,Default,,0,0,0,,Há quantos anos estamos aqui...
Dialogue: 0,1:35:08.89,1:35:09.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:09.01,1:35:09.45,Default,,0,0,0,,Tá bom, vem.
Dialogue: 0,1:35:26.07,1:35:29.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:26.19,1:35:29.45,Default,,0,0,0,,Como vai? Está satisfeita com o hospital?
Dialogue: 0,1:35:39.75,1:35:41.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:39.87,1:35:41.39,Default,,0,0,0,,Fizemos bem em trazer você para cá, não é?
Dialogue: 0,1:35:43.40,1:35:44.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:43.52,1:35:44.32,Default,,0,0,0,,Sua mãe está bem.
Dialogue: 0,1:35:43.92,1:35:47.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:44.04,1:35:47.37,Default,,0,0,0,,Disseram a ela que os rins tinham falhado.
Dialogue: 0,1:35:49.54,1:35:52.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:49.66,1:35:51.89,Default,,0,0,0,,Começamos o tratamento dela bem a tempo.
Dialogue: 0,1:35:51.85,1:35:55.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:51.97,1:35:55.01,Default,,0,0,0,,Graças a Deus, senão ela já teria partido há muito tempo.
Dialogue: 0,1:35:57.16,1:36:00.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:35:57.28,1:36:00.41,Default,,0,0,0,,Agora é a sua vez de retribuir o favor.
Dialogue: 0,1:36:03.07,1:36:07.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:03.19,1:36:07.75,Default,,0,0,0,,Se fizer o que eu disser, o tratamento da sua mãe continuará.
Dialogue: 0,1:36:09.56,1:36:14.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:09.68,1:36:13.95,Default,,0,0,0,,Além disso, passo a casa onde moram para o seu nome, para viverem tranquilos.
Dialogue: 0,1:36:14.89,1:36:20.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:15.01,1:36:19.95,Default,,0,0,0,,Mas se não fizer, esqueça esse bom emprego e esqueça o tratamento da sua mãe.
Dialogue: 0,1:36:20.93,1:36:23.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:21.05,1:36:23.61,Default,,0,0,0,,Você sabe que esses remédios são difíceis de conseguir.
Dialogue: 0,1:36:23.57,1:36:25.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:23.69,1:36:25.49,Default,,0,0,0,,Agora me mostre.
Dialogue: 0,1:36:31.47,1:36:38.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:31.59,1:36:38.43,Default,,0,0,0,,Qual paciente vai colocar a Dona Alya em apuros, desmoralizá-la e mandá-la para a cadeia? Vamos!
Dialogue: 0,1:36:43.37,1:36:47.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:43.49,1:36:47.05,Default,,0,0,0,,Seringas, equipo de soro, cateteres, tubos de coleta de sangue e tudo mais.
Dialogue: 0,1:36:47.11,1:36:53.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:47.23,1:36:53.69,Default,,0,0,0,,Irmão, como vou decorar isso de cabeça? Deixa eu ir lá nos fundos procurar, pego tudo e te entrego num pacote, pode ser?
Dialogue: 0,1:36:54.07,1:36:55.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:54.19,1:36:55.49,Default,,0,0,0,,Então você não vai conseguir guardar na cabeça.
Dialogue: 0,1:36:55.57,1:36:56.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:55.69,1:36:56.69,Default,,0,0,0,,O celular fica comigo.
Dialogue: 0,1:36:57.21,1:36:58.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:57.33,1:36:58.28,Default,,0,0,0,,Tá bom, pega, mas anda rápido!
Dialogue: 0,1:36:58.24,1:36:59.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:58.36,1:36:59.64,Default,,0,0,0,,Certo, vai lá, quero só ver.
Dialogue: 0,1:36:59.60,1:37:07.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:36:59.72,1:37:07.22,Default,,0,0,0,,Então você está me dizendo que, se não houver coagulação, o sangramento continua e é uma cirurgia de risco, entendi direito?
Dialogue: 0,1:37:26.63,1:37:29.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:26.75,1:37:28.91,Default,,0,0,0,,Sim, e toda a culpa vai recair sobre a Dona Alya.
Dialogue: 0,1:37:29.20,1:37:31.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:29.32,1:37:30.88,Default,,0,0,0,,Mas você disse que é um risco pequeno, não é?
Dialogue: 0,1:37:31.29,1:37:33.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:31.41,1:37:33.13,Default,,0,0,0,,Mas se a paciente souber disso, será pior...
Dialogue: 0,1:37:33.09,1:37:34.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:33.21,1:37:34.51,Default,,0,0,0,,Isso não é assunto para você se preocupar.
Dialogue: 0,1:37:34.87,1:37:36.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:34.99,1:37:36.56,Default,,0,0,0,,Este é um hospital enorme.
Dialogue: 0,1:37:36.64,1:37:37.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:36.76,1:37:37.82,Default,,0,0,0,,Eles vão tomar as devidas providências.
Dialogue: 0,1:37:38.25,1:37:39.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:38.37,1:37:39.13,Default,,0,0,0,,Não se preocupe.
Dialogue: 0,1:37:39.13,1:37:41.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:39.25,1:37:41.77,Default,,0,0,0,,A única coisa com que você deve se preocupar é com a sua mãe.
Dialogue: 0,1:37:42.60,1:37:43.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:42.72,1:37:43.81,Default,,0,0,0,,Ouviu bem?
Dialogue: 0,1:37:44.35,1:37:45.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:44.47,1:37:45.81,Default,,0,0,0,,Pense na sua mãe, menina.
Dialogue: 0,1:37:46.06,1:37:47.10,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:46.18,1:37:46.95,Default,,0,0,0,,Cuide dela.
Dialogue: 0,1:37:47.40,1:37:48.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:47.52,1:37:48.36,Default,,0,0,0,,Deixe o resto comigo.
Dialogue: 0,1:37:48.36,1:37:49.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:48.48,1:37:49.44,Default,,0,0,0,,Vamos, faça a sua parte.
Dialogue: 0,1:37:49.83,1:37:50.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:49.95,1:37:50.80,Default,,0,0,0,,Faça o que tem que fazer.
Dialogue: 0,1:37:50.80,1:37:51.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:50.92,1:37:51.28,Default,,0,0,0,,Vamos.
Dialogue: 0,1:37:51.63,1:37:53.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:37:51.75,1:37:53.71,Default,,0,0,0,,Vamos, menina, você só tem que pensar na sua mãe.
Dialogue: 0,1:38:08.34,1:38:11.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:08.46,1:38:11.73,Default,,0,0,0,,O que houve? Por que a senhora está aqui?
Dialogue: 0,1:38:19.74,1:38:21.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:19.86,1:38:20.85,Default,,0,0,0,,E ainda pergunta?
Dialogue: 0,1:38:21.88,1:38:23.69,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:22.00,1:38:23.54,Default,,0,0,0,,Graças a você, minha pressão foi às alturas.
Dialogue: 0,1:38:24.22,1:38:25.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:24.34,1:38:25.46,Default,,0,0,0,,Vim me consultar com o médico.
Dialogue: 0,1:38:30.00,1:38:32.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:30.12,1:38:31.92,Default,,0,0,0,,Fez muito bem.
Dialogue: 0,1:38:34.62,1:38:36.25,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:34.74,1:38:36.10,Default,,0,0,0,,Entre.
Dialogue: 0,1:38:39.04,1:38:41.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:39.16,1:38:40.87,Default,,0,0,0,,Pode se sentar.
Dialogue: 0,1:38:43.25,1:38:45.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:43.37,1:38:45.53,Default,,0,0,0,,Pode verificar para mim?
Dialogue: 0,1:38:57.38,1:38:59.45,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:38:57.50,1:38:59.30,Default,,0,0,0,,Vamos sentar.
Dialogue: 0,1:39:26.70,1:39:31.79,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:26.82,1:39:31.64,Default,,0,0,0,,Os batimentos cardíacos estão normais e o desenvolvimento também.
Dialogue: 0,1:39:41.92,1:39:43.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:42.04,1:39:42.96,Default,,0,0,0,,Não se preocupe com nada.
Dialogue: 0,1:39:44.05,1:39:47.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:44.17,1:39:46.99,Default,,0,0,0,,O Cihan não contou para ninguém, não é, cunhada Alya?
Dialogue: 0,1:39:47.44,1:39:49.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:47.56,1:39:48.91,Default,,0,0,0,,Não contou, não se preocupe.
Dialogue: 0,1:39:49.21,1:39:51.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:49.33,1:39:50.85,Default,,0,0,0,,Ele não pode contar, por favor, convença ele!
Dialogue: 0,1:39:50.81,1:39:53.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:50.93,1:39:53.26,Default,,0,0,0,,Olha, o Demir está piorando a cada dia que passa.
Dialogue: 0,1:39:53.28,1:39:55.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:53.40,1:39:55.80,Default,,0,0,0,,Se continuar assim, eu não vou aguentar mais.
Dialogue: 0,1:39:56.23,1:39:57.24,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:56.35,1:39:57.09,Default,,0,0,0,,Não vou suportar.
Dialogue: 0,1:39:57.55,1:39:58.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:57.67,1:39:58.40,Default,,0,0,0,,Não faça isso.
Dialogue: 0,1:39:58.69,1:40:00.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:39:58.81,1:40:00.42,Default,,0,0,0,,Olhe, não faça mal ao seu bebê, não fique assim.
Dialogue: 0,1:40:00.38,1:40:01.69,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:00.50,1:40:01.54,Default,,0,0,0,,Não vai acontecer nada, tá bom?
Dialogue: 0,1:40:02.48,1:40:04.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:02.60,1:40:04.40,Default,,0,0,0,,Tá bem, vou indo.
Dialogue: 0,1:40:04.54,1:40:05.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:04.66,1:40:05.44,Default,,0,0,0,,Não aguento mais.
Dialogue: 0,1:40:05.54,1:40:06.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:05.66,1:40:06.63,Default,,0,0,0,,Deixe que eu te acompanho.
Dialogue: 0,1:40:07.19,1:40:09.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:07.31,1:40:09.11,Default,,0,0,0,,Kaya.
Dialogue: 0,1:40:18.26,1:40:20.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:18.38,1:40:20.18,Default,,0,0,0,,Olá, cunhada.
Dialogue: 0,1:40:22.59,1:40:23.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:22.71,1:40:23.28,Default,,0,0,0,,Olá.
Dialogue: 0,1:40:26.42,1:40:29.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:26.54,1:40:28.89,Default,,0,0,0,,Espero que esteja tudo bem.
Dialogue: 0,1:40:29.69,1:40:30.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:29.81,1:40:30.66,Default,,0,0,0,,Com o bebê.
Dialogue: 0,1:40:32.16,1:40:33.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:32.28,1:40:32.90,Default,,0,0,0,,Está tudo bem, tudo bem.
Dialogue: 0,1:40:33.32,1:40:34.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:33.44,1:40:34.24,Default,,0,0,0,,Tudo bem, tudo bem.
Dialogue: 0,1:40:34.95,1:40:36.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:35.07,1:40:36.46,Default,,0,0,0,,Que bom, graças a Deus.
Dialogue: 0,1:40:36.82,1:40:37.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:36.94,1:40:37.57,Default,,0,0,0,,Zerrin!
Dialogue: 0,1:40:39.06,1:40:41.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:39.18,1:40:41.11,Default,,0,0,0,,Por que você está gritando no hospital? O que é isso?
Dialogue: 0,1:40:41.27,1:40:42.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:41.39,1:40:42.19,Default,,0,0,0,,O que você está fazendo aqui?
Dialogue: 0,1:40:42.63,1:40:44.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:42.75,1:40:44.60,Default,,0,0,0,,O que você veio fazer aqui?
Dialogue: 0,1:40:45.14,1:40:46.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:45.26,1:40:46.08,Default,,0,0,0,,É porque ele está aqui, não é?
Dialogue: 0,1:40:46.28,1:40:47.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:46.40,1:40:47.20,Default,,0,0,0,,Anda!
Dialogue: 0,1:40:46.48,1:40:47.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:46.60,1:40:47.40,Default,,0,0,0,,Ficou maluco?
Dialogue: 0,1:40:47.16,1:40:48.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:47.28,1:40:48.08,Default,,0,0,0,,Anda, anda!
Dialogue: 0,1:40:47.52,1:40:48.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:47.64,1:40:48.26,Default,,0,0,0,,Anda, vamos!
Dialogue: 0,1:40:48.26,1:40:49.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:48.38,1:40:49.18,Default,,0,0,0,,Calma, calma.
Dialogue: 0,1:40:48.64,1:40:49.25,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:48.76,1:40:49.10,Default,,0,0,0,,Rapaz, solta ela!
Dialogue: 0,1:40:49.14,1:40:50.21,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:49.26,1:40:50.06,Default,,0,0,0,,Abaixe a voz!
Dialogue: 0,1:40:49.88,1:40:50.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:50.00,1:40:50.80,Default,,0,0,0,,Olha o que você está dizendo!
Dialogue: 0,1:40:50.64,1:40:51.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:50.76,1:40:51.76,Default,,0,0,0,,Eu acabo com você, seu desgraçado!
Dialogue: 0,1:40:51.72,1:40:52.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:51.84,1:40:52.82,Default,,0,0,0,,Entra na minha sala, entra!
Dialogue: 0,1:40:52.80,1:40:53.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:52.92,1:40:53.18,Default,,0,0,0,,Cunhada...
Dialogue: 0,1:40:53.50,1:40:55.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:53.62,1:40:54.96,Default,,0,0,0,,Rapaz, me escuta, entra na sala!
Dialogue: 0,1:40:56.96,1:40:59.03,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:40:57.08,1:40:58.88,Default,,0,0,0,,Kaya.
Dialogue: 0,1:41:01.45,1:41:04.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:01.57,1:41:03.92,Default,,0,0,0,,Por que você está gritando?
Dialogue: 0,1:41:05.93,1:41:11.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:06.05,1:41:11.55,Default,,0,0,0,,O Kaya tinha coisas para resolver, por isso veio ao hospital. E a Zerrin veio para uma consulta de rotina.
Dialogue: 0,1:41:11.61,1:41:13.30,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:11.73,1:41:13.15,Default,,0,0,0,,E acabaram se cruzando aqui.
Dialogue: 0,1:41:13.77,1:41:18.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:13.89,1:41:17.90,Default,,0,0,0,,Olha aqui, essa menina está grávida! Não a perturbe nem a maltrate. Solte o braço dela, solte!
Dialogue: 0,1:41:21.85,1:41:25.52,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:21.97,1:41:25.37,Default,,0,0,0,,Muito bem. Qualquer coisa, vá para o carro.
Dialogue: 0,1:41:27.85,1:41:29.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:27.97,1:41:29.77,Default,,0,0,0,,Paciência...
Dialogue: 0,1:41:35.31,1:41:37.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:35.43,1:41:37.59,Default,,0,0,0,,O que você está fazendo?
Dialogue: 0,1:41:49.22,1:41:51.12,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:49.34,1:41:50.97,Default,,0,0,0,,Foi só uma olhada.
Dialogue: 0,1:41:51.13,1:41:52.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:51.25,1:41:52.57,Default,,0,0,0,,Olhando prontuário de paciente?
Dialogue: 0,1:41:54.20,1:41:56.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:54.32,1:41:56.83,Default,,0,0,0,,O bebê já está no quinto mês, né?
Dialogue: 0,1:41:58.04,1:41:58.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:58.16,1:41:58.38,Default,,0,0,0,,É.
Dialogue: 0,1:41:59.32,1:42:02.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:41:59.44,1:42:02.22,Default,,0,0,0,,Mal se casaram e já encomendaram um filho, então.
Dialogue: 0,1:42:04.82,1:42:09.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:42:04.94,1:42:08.92,Default,,0,0,0,,Ela também sabe. Preciso ir para a enfermaria, Kaya.
Dialogue: 0,1:42:14.16,1:42:16.23,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:42:14.28,1:42:16.08,Default,,0,0,0,,Bom trabalho.
Dialogue: 0,1:42:19.34,1:42:20.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:42:19.46,1:42:20.80,Default,,0,0,0,,Bom trabalho para você também.
Dialogue: 0,1:42:20.76,1:42:28.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:42:20.88,1:42:28.38,Default,,0,0,0,,Entra logo ali! Eu vou enlouquecer, juro por Deus que vou enlouquecer! Responda! Por que o Kaya estava lá? Vocês contaram sobre o bebê, não é? Foram juntos à consulta! Deixe de loucura, ninguém falou nada, o Kaya não sabe de nada! Se você já tem o seu médico, por que foi procurar a Alya? Só para ficar perto daquele traste do Kaya! Chega, já chega! Não me pressione, estou dizendo que não tem nada disso! Você não pisa mais naquele hospital! A Dona Alya não vai mais te atender, você não vai! Fique quieta no seu canto! Pare, pare! O que está fazendo? Pare, calma...
Dialogue: 0,1:42:58.70,1:43:00.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:42:58.82,1:43:00.78,Default,,0,0,0,,Tá bom, calma, calma.
Dialogue: 0,1:43:00.87,1:43:02.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:00.99,1:43:02.79,Default,,0,0,0,,Onde você vai?
Dialogue: 0,1:43:08.50,1:43:10.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:08.62,1:43:09.86,Default,,0,0,0,,Não venha atrás de mim!
Dialogue: 0,1:43:09.82,1:43:13.48,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:09.94,1:43:13.34,Default,,0,0,0,,Você nem vai voltar para casa hoje à noite?
Dialogue: 0,1:43:13.68,1:43:16.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:13.80,1:43:16.81,Default,,0,0,0,,Essa garota ainda vai me enlouquecer!
Dialogue: 0,1:43:18.06,1:43:19.43,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:18.18,1:43:19.28,Default,,0,0,0,,Por Deus, ela vai me deixar louco!
Dialogue: 0,1:43:19.24,1:43:21.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:19.36,1:43:21.16,Default,,0,0,0,,Zerrin!
Dialogue: 0,1:43:27.10,1:43:29.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:27.22,1:43:29.25,Default,,0,0,0,,Você viu quem a levou?
Dialogue: 0,1:43:42.09,1:43:43.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:42.21,1:43:43.66,Default,,0,0,0,,Foi o Kaya que sequestrou?
Dialogue: 0,1:43:43.62,1:43:45.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:43.74,1:43:45.01,Default,,0,0,0,,Foi o Kaya?
Dialogue: 0,1:43:44.97,1:43:47.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:45.09,1:43:46.93,Default,,0,0,0,,Eu vou acabar com ele!
Dialogue: 0,1:43:46.89,1:43:48.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:47.01,1:43:48.18,Default,,0,0,0,,Eu vou destruí-lo!
Dialogue: 0,1:43:48.14,1:43:50.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:43:48.26,1:43:50.23,Default,,0,0,0,,Onde está esse carro?
Dialogue: 0,1:44:00.79,1:44:02.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:00.91,1:44:02.25,Default,,0,0,0,,Onde está esse carro?
Dialogue: 0,1:44:02.21,1:44:03.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:02.33,1:44:03.13,Default,,0,0,0,,Cadê?
Dialogue: 0,1:44:02.75,1:44:04.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:02.87,1:44:03.86,Default,,0,0,0,,Cadê?
Dialogue: 0,1:44:03.82,1:44:05.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:03.94,1:44:05.74,Default,,0,0,0,,Onde você está?
Dialogue: 0,1:44:07.51,1:44:09.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:07.63,1:44:09.43,Default,,0,0,0,,Seu desgraçado do Kaya!
Dialogue: 0,1:44:09.39,1:44:10.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:09.51,1:44:10.68,Default,,0,0,0,,Eu vou te matar!
Dialogue: 0,1:44:10.64,1:44:13.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:10.76,1:44:12.96,Default,,0,0,0,,Juro por Deus que vou te matar!
Dialogue: 0,1:44:16.86,1:44:19.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:16.98,1:44:19.27,Default,,0,0,0,,O que foi? Pare de gritar!
Dialogue: 0,1:44:20.89,1:44:23.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:21.01,1:44:23.12,Default,,0,0,0,,Ainda não se acalmou? Venha para a empresa...
Dialogue: 0,1:44:23.08,1:44:25.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:23.20,1:44:25.34,Default,,0,0,0,,Venha, tenho coisas para conversar. Que empresa,
Dialogue: 0,1:44:25.30,1:44:27.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:25.42,1:44:27.22,Default,,0,0,0,,Ecmel, que empresa?! Sequestraram a Zerrin!
Dialogue: 0,1:44:27.18,1:44:29.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:27.30,1:44:29.31,Default,,0,0,0,,Sequestraram a Zerrin! O quê?!
Dialogue: 0,1:44:30.36,1:44:33.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:30.48,1:44:32.86,Default,,0,0,0,,O que você está dizendo? Quem sequestrou?
Dialogue: 0,1:44:33.16,1:44:35.91,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:33.28,1:44:35.76,Default,,0,0,0,,Não sei! Pegaram ela na frente da faculdade, não vi o rosto dele.
Dialogue: 0,1:44:36.16,1:44:38.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:36.28,1:44:37.91,Default,,0,0,0,,Mas com certeza foi aquele cachorro do Kaya!
Dialogue: 0,1:44:38.39,1:44:41.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:38.51,1:44:41.45,Default,,0,0,0,,Tenho certeza de que foi ele! Şahin!
Dialogue: 0,1:44:57.30,1:45:00.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:44:57.42,1:44:59.87,Default,,0,0,0,,Şahin! O que está acontecendo de novo?
Dialogue: 0,1:45:00.20,1:45:02.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:00.32,1:45:02.17,Default,,0,0,0,,Sequestraram a Zerrin! O quê?!
Dialogue: 0,1:45:02.52,1:45:04.64,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:02.64,1:45:04.49,Default,,0,0,0,,O que está acontecendo? O Demir ligou.
Dialogue: 0,1:45:04.57,1:45:06.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:04.69,1:45:06.43,Default,,0,0,0,,Sequestraram a Zerrin! O que você está
Dialogue: 0,1:45:06.39,1:45:07.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:06.51,1:45:07.73,Default,,0,0,0,,dizendo, pai? Quem sequestrou?
Dialogue: 0,1:45:07.86,1:45:09.05,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:07.98,1:45:08.90,Default,,0,0,0,,Quem mais poderia ser?
Dialogue: 0,1:45:09.78,1:45:12.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:09.90,1:45:12.73,Default,,0,0,0,,Ninguém além daquele canalha do Kaya faria uma coisa dessas!
Dialogue: 0,1:45:12.75,1:45:15.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:12.87,1:45:15.51,Default,,0,0,0,,Que Deus arranque os seus olhos, Kaya!
Dialogue: 0,1:45:16.55,1:45:21.19,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:16.67,1:45:21.04,Default,,0,0,0,,Se eu não derrubar aquela mansão na cabeça deles, não me chamo Ecmel Albora!
Dialogue: 0,1:45:23.15,1:45:24.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:23.27,1:45:24.48,Default,,0,0,0,,O Demir também está a caminho.
Dialogue: 0,1:45:25.30,1:45:26.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:25.42,1:45:26.50,Default,,0,0,0,,Anda, vamos, Şahin!
Dialogue: 0,1:45:26.72,1:45:27.88,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:26.84,1:45:27.73,Default,,0,0,0,,Eu também vou!
Dialogue: 0,1:45:28.83,1:45:29.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:28.95,1:45:29.57,Default,,0,0,0,,Vamos, Nare!
Dialogue: 0,1:45:29.65,1:45:30.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:29.77,1:45:30.21,Default,,0,0,0,,Şahin!
Dialogue: 0,1:45:31.54,1:45:32.75,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:31.66,1:45:32.60,Default,,0,0,0,,Será possível uma coisa dessas?
Dialogue: 0,1:45:33.22,1:45:35.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:33.34,1:45:35.17,Default,,0,0,0,,Não sei, Nare, vamos ver, anda!
Dialogue: 0,1:45:35.27,1:45:36.78,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:35.39,1:45:36.63,Default,,0,0,0,,Espera, vou pegar o celular e já volto.
Dialogue: 0,1:45:36.69,1:45:38.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:36.81,1:45:38.13,Default,,0,0,0,,Tá bom, vou buscar o carro.
Dialogue: 0,1:45:41.84,1:45:42.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:41.96,1:45:42.66,Default,,0,0,0,,Nare?
Dialogue: 0,1:45:42.95,1:45:44.37,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:43.07,1:45:44.22,Default,,0,0,0,,Meu irmão, sequestraram a Zerrin!
Dialogue: 0,1:45:45.00,1:45:46.15,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:45.12,1:45:46.00,Default,,0,0,0,,O quê?!
Dialogue: 0,1:45:48.58,1:45:51.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:48.70,1:45:51.44,Default,,0,0,0,,Estão dizendo que ele sequestrou!
Dialogue: 0,1:45:52.35,1:45:53.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:52.47,1:45:53.27,Default,,0,0,0,,Ele está com você?
Dialogue: 0,1:45:52.95,1:45:58.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:53.07,1:45:58.11,Default,,0,0,0,,Irmão, o Ecmel, o Demir, estão todos indo para a mansão agora mesmo! Anda logo, por favor!
Dialogue: 0,1:45:58.07,1:45:59.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:58.19,1:45:58.99,Default,,0,0,0,,Desliga!
Dialogue: 0,1:45:58.82,1:46:00.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:45:58.94,1:46:00.74,Default,,0,0,0,,Cihan!
Dialogue: 0,1:46:20.35,1:46:21.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:20.47,1:46:21.27,Default,,0,0,0,,Alya!
Dialogue: 0,1:46:20.91,1:46:23.38,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:21.03,1:46:23.23,Default,,0,0,0,,O Kaya ia aí, ele foi ao hospital?
Dialogue: 0,1:46:23.19,1:46:26.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:23.31,1:46:26.19,Default,,0,0,0,,Ele veio, mas acabou de sair. O que houve? Aconteceu alguma coisa?
Dialogue: 0,1:46:26.15,1:46:28.45,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:26.27,1:46:28.30,Default,,0,0,0,,Sequestraram a Zerrin!
Dialogue: 0,1:46:28.86,1:46:29.99,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:28.98,1:46:29.84,Default,,0,0,0,,O quê?!
Dialogue: 0,1:46:29.80,1:46:33.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:29.92,1:46:33.44,Default,,0,0,0,,A Zerrin estava aqui, veio para uma consulta.
Dialogue: 0,1:46:34.52,1:46:36.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:34.64,1:46:36.40,Default,,0,0,0,,E o Kaya apareceu bem na mesma hora.
Dialogue: 0,1:46:36.36,1:46:41.26,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:36.48,1:46:41.11,Default,,0,0,0,,Depois ele viu o prontuário dela, olhou o ultrassom da Zerrin.
Dialogue: 0,1:46:41.29,1:46:44.40,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:41.41,1:46:44.25,Default,,0,0,0,,Fez umas perguntas desconfiadas, mas achei que ele não tivesse entendido nada.
Dialogue: 0,1:46:44.21,1:46:47.94,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:44.33,1:46:47.79,Default,,0,0,0,,Será que ele percebeu e a sequestrou, Cihan?
Dialogue: 0,1:46:47.82,1:46:51.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:47.94,1:46:51.72,Default,,0,0,0,,Não sei, não sei! Estou indo para a mansão agora.
Dialogue: 0,1:46:51.75,1:46:55.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:51.87,1:46:55.14,Default,,0,0,0,,O Ecmel, o Demir e quem mais puder vão invadir aquilo lá agora, tá me ouvindo?
Dialogue: 0,1:46:55.51,1:46:57.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:46:55.63,1:46:57.65,Default,,0,0,0,,O Deniz está na mansão! Desliga, desliga!
Dialogue: 0,1:47:01.67,1:47:03.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:01.79,1:47:03.82,Default,,0,0,0,,Coloque dessas também.
Dialogue: 0,1:47:04.92,1:47:05.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:05.04,1:47:05.44,Default,,0,0,0,,Dona Alya!
Dialogue: 0,1:47:05.66,1:47:07.93,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:05.78,1:47:07.78,Default,,0,0,0,,Pakize, leve o Deniz imediatamente para o quarto dele!
Dialogue: 0,1:47:07.86,1:47:09.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:07.98,1:47:09.46,Default,,0,0,0,,Não deixe ele sair de jeito nenhum, estou a caminho!
Dialogue: 0,1:47:09.84,1:47:12.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:09.96,1:47:11.93,Default,,0,0,0,,Sim, claro, Dona Alya!
Dialogue: 0,1:47:13.60,1:47:15.65,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:13.72,1:47:15.50,Default,,0,0,0,,Vamos lá, você vem comigo.
Dialogue: 0,1:47:15.46,1:47:17.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:15.58,1:47:17.72,Default,,0,0,0,,Vamos, querido, deixe isso aí, depois a gente escreve.
Dialogue: 0,1:47:17.86,1:47:19.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:17.98,1:47:18.96,Default,,0,0,0,,Depois, depois.
Dialogue: 0,1:47:19.52,1:47:21.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:19.64,1:47:21.66,Default,,0,0,0,,Tá bom, depois nós terminamos.
Dialogue: 0,1:47:21.82,1:47:22.89,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:21.94,1:47:22.74,Default,,0,0,0,,Depois a gente termina.
Dialogue: 0,1:47:22.52,1:47:23.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:22.64,1:47:23.26,Default,,0,0,0,,Tá bom, não fique assim.
Dialogue: 0,1:47:23.50,1:47:25.53,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:23.62,1:47:25.38,Default,,0,0,0,,Eu faço um novo para você.
Dialogue: 0,1:47:25.86,1:47:27.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:25.98,1:47:27.82,Default,,0,0,0,,Vamos fazer outro, não se preocupe.
Dialogue: 0,1:47:27.78,1:47:29.81,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:27.90,1:47:29.66,Default,,0,0,0,,Tá bom, tudo bem, vem.
Dialogue: 0,1:47:30.00,1:47:34.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:47:30.12,1:47:34.68,Default,,0,0,0,,Sadakat! Sadakat! Apareça! Saia daí! Onde você está? Sadakat!
Dialogue: 0,1:48:11.08,1:48:18.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:11.20,1:48:18.70,Default,,0,0,0,,Demônio! O que você está fazendo na minha casa? Deixaram as portas do inferno abertas, seu cão dos infernos? O que veio fazer aqui?
Dialogue: 0,1:48:18.74,1:48:26.51,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:18.86,1:48:26.36,Default,,0,0,0,,Como deixam isso entrar aqui? Seu cachorro, o que você quer? Veio latir no meu portão, alma penada? Diga, seu cão!
Dialogue: 0,1:48:29.10,1:48:32.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:29.22,1:48:32.20,Default,,0,0,0,,Onde está aquele chacal do Kaya? Mande ele aparecer!
Dialogue: 0,1:48:35.67,1:48:40.63,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:35.79,1:48:40.48,Default,,0,0,0,,Você não é ninguém para chamar o meu filho ou dar ordens a ele!
Dialogue: 0,1:48:43.55,1:48:45.50,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:43.67,1:48:45.35,Default,,0,0,0,,Quem você pensa que é, seu cão, para exigir a presença do meu filho?
Dialogue: 0,1:48:45.53,1:48:50.29,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:45.65,1:48:50.14,Default,,0,0,0,,Apenas eu, apenas Sadakat Albora dá ordens para os filhos virem até ela!
Dialogue: 0,1:48:53.47,1:48:55.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:53.59,1:48:55.47,Default,,0,0,0,,Espere, estou descendo, demônio!
Dialogue: 0,1:48:56.11,1:49:01.59,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:48:56.23,1:49:01.44,Default,,0,0,0,,Seu desalmado, demônio infame! Entrou no meio da minha casa para latir!
Dialogue: 0,1:49:03.82,1:49:05.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:03.94,1:49:05.40,Default,,0,0,0,,O que você tem a ver com a minha casa?
Dialogue: 0,1:49:05.36,1:49:07.69,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:05.48,1:49:07.54,Default,,0,0,0,,Mãe, precisamos ver o Kaya. O Kaya está aqui?
Dialogue: 0,1:49:07.52,1:49:09.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:07.64,1:49:09.80,Default,,0,0,0,,Deixa o Kaya de lado, pelo amor de Deus! O assunto é sério, mãe!
Dialogue: 0,1:49:09.98,1:49:12.77,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:10.10,1:49:12.62,Default,,0,0,0,,Pelo amor de Deus, cale a boca! O que você quer? O que veio fazer aqui?
Dialogue: 0,1:49:13.52,1:49:16.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:13.64,1:49:16.34,Default,,0,0,0,,Aquele canalha do Kaya sequestrou a minha filha!
Dialogue: 0,1:49:16.86,1:49:19.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:16.98,1:49:19.56,Default,,0,0,0,,Em vez de ficar escondido feito um rato, mande ele dar as caras!
Dialogue: 0,1:49:20.84,1:49:24.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:20.96,1:49:24.42,Default,,0,0,0,,O meu filho jamais se envolveria em uma coisa dessas!
Dialogue: 0,1:49:24.46,1:49:26.41,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:24.58,1:49:26.26,Default,,0,0,0,,Ele nunca cometeria uma baixeza dessas!
Dialogue: 0,1:49:26.46,1:49:27.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:26.58,1:49:27.40,Default,,0,0,0,,Olha só para você!
Dialogue: 0,1:49:28.10,1:49:30.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:28.22,1:49:30.68,Default,,0,0,0,,O seu filho está mais do que acostumado a fazer baixezas!
Dialogue: 0,1:49:31.37,1:49:32.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:31.49,1:49:32.13,Default,,0,0,0,,Já se esqueceu, não é?
Dialogue: 0,1:49:32.73,1:49:34.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:32.85,1:49:34.81,Default,,0,0,0,,Não foi ele quem sequestrou a minha filha no meio do nosso casamento?
Dialogue: 0,1:49:34.77,1:49:37.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:34.89,1:49:37.61,Default,,0,0,0,,Isso foi há muito tempo, já passou!
Dialogue: 0,1:49:37.77,1:49:40.36,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:37.89,1:49:40.21,Default,,0,0,0,,Muita água já rolou por debaixo dessa ponte!
Dialogue: 0,1:49:40.49,1:49:44.18,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:40.61,1:49:44.03,Default,,0,0,0,,A sua filha se casou e o meu filho está noivo!
Dialogue: 0,1:49:44.32,1:49:46.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:44.44,1:49:45.92,Default,,0,0,0,,Aliás, vocês têm provas? Alguém viu?
Dialogue: 0,1:49:45.88,1:49:49.04,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:46.00,1:49:48.89,Default,,0,0,0,,Olha só, ainda tem a cara de pau de pedir provas!
Dialogue: 0,1:49:49.41,1:49:51.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:49.53,1:49:51.59,Default,,0,0,0,,Você sabe muito bem, e eu também sei!
Dialogue: 0,1:49:51.79,1:49:52.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:51.91,1:49:52.71,Default,,0,0,0,,Foi ele quem fez isso!
Dialogue: 0,1:49:52.43,1:49:54.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:52.55,1:49:54.45,Default,,0,0,0,,Já chega! Nós não vimos se foi ele quem fez!
Dialogue: 0,1:49:54.55,1:49:56.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:54.67,1:49:56.83,Default,,0,0,0,,Só tem um jeito de saber: vamos falar cara a cara com o Kaya!
Dialogue: 0,1:49:56.99,1:50:00.84,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:49:57.11,1:50:00.69,Default,,0,0,0,,Olha só! Não tem provas, ninguém viu, e você vem aqui fazer acusações?
Dialogue: 0,1:50:00.65,1:50:02.34,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:50:00.77,1:50:02.19,Default,,0,0,0,,Suma daqui agora mesmo, suma!
Dialogue: 0,1:50:02.85,1:50:06.28,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:50:02.97,1:50:06.13,Default,,0,0,0,,Mande ele vir aqui! Ele vai prestar contas!
Dialogue: 0,1:50:06.09,1:50:11.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:50:06.21,1:50:11.16,Default,,0,0,0,,Quem é você, seu cão sarnento, para cobrar satisfação do meu filho?
Dialogue: 0,1:50:11.80,1:50:14.98,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:50:11.92,1:50:14.83,Default,,0,0,0,,Quem é você para exigir satisfações do meu filho?
Dialogue: 0,1:50:15.25,1:50:17.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:50:15.37,1:50:17.05,Default,,0,0,0,,Quem exige satisfações aqui somos nós!
Dialogue: 0,1:50:17.03,1:50:18.80,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,1:50:17.15,1:50:18.65,Default,,0,0,0,,Nós não devemos explicações a ninguém!
