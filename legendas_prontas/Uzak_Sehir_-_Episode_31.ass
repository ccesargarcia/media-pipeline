Dialogue: 1,0:31:57.83,0:32:01.03,Default,,0,0,0,,Que a paz esteja com você, senhor Mevru.
Dialogue: 0,0:32:23.47,0:32:25.46,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:23.59,0:32:25.31,Default,,0,0,0,,E com você. Vamos fazer uma checagem de identidade.
Dialogue: 0,0:32:25.27,0:32:27.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:25.39,0:32:27.27,Default,,0,0,0,,Certo, quer que eu junte os documentos e traga para você?
Dialogue: 0,0:32:27.23,0:32:27.92,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:27.35,0:32:27.77,Default,,0,0,0,,Estou esperando.
Dialogue: 0,0:32:27.79,0:32:28.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:27.91,0:32:28.07,Default,,0,0,0,,Certo.
Dialogue: 0,0:32:28.25,0:32:29.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:28.37,0:32:29.16,Default,,0,0,0,,Controle de identidade.
Dialogue: 0,0:32:29.31,0:32:31.11,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:29.43,0:32:30.96,Default,,0,0,0,,Irmão, é a polícia fazendo controle?
Dialogue: 0,0:32:31.42,0:32:32.71,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:31.54,0:32:32.56,Default,,0,0,0,,Controle de identidade.
Dialogue: 0,0:32:34.35,0:32:36.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:34.47,0:32:36.43,Default,,0,0,0,,Seus documentos estão em ordem?
Dialogue: 0,0:32:36.81,0:32:38.54,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:36.93,0:32:38.39,Default,,0,0,0,,Estão, não precisa se preocupar.
Dialogue: 0,0:32:38.95,0:32:41.08,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:39.07,0:32:40.93,Default,,0,0,0,,Olá, os documentos estão em ordem?
Dialogue: 0,0:32:40.93,0:32:41.42,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:41.05,0:32:41.27,Default,,0,0,0,,Sim.
Dialogue: 0,0:32:41.37,0:32:42.62,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:41.49,0:32:42.47,Default,,0,0,0,,Pelo que você viu hoje, estão.
Dialogue: 0,0:32:45.23,0:32:49.55,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:45.35,0:32:49.39,Default,,0,0,0,,Olá, gostaríamos de fazer uma checagem de identidade.
Dialogue: 0,0:32:50.75,0:32:51.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:50.87,0:32:51.05,Default,,0,0,0,,Pois não.
Dialogue: 0,0:32:51.87,0:32:57.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:51.99,0:32:56.99,Default,,0,0,0,,Acontece que sou médica e estou indo para um parto de urgência, seria possível ser bem rápida?
Dialogue: 0,0:32:57.17,0:32:58.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:57.29,0:32:58.32,Default,,0,0,0,,Vamos fazer o possível.
Dialogue: 0,0:32:58.65,0:32:59.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:32:58.77,0:32:59.18,Default,,0,0,0,,Obrigada.
Dialogue: 0,0:33:12.05,0:33:14.68,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:12.17,0:33:14.53,Default,,0,0,0,,Eles vão olhar isso, irmão?
Dialogue: 0,0:33:43.59,0:33:44.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:43.71,0:33:44.80,Default,,0,0,0,,Vão olhar.
Dialogue: 0,0:33:44.76,0:33:46.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:44.88,0:33:46.70,Default,,0,0,0,,E se olharem, o que tem? Os documentos não estão em ordem?
Dialogue: 0,0:33:46.66,0:33:49.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:33:46.78,0:33:49.59,Default,,0,0,0,,Que ótima notícia, seja bem-vinda.
Dialogue: 0,0:34:39.46,0:34:42.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:39.58,0:34:42.07,Default,,0,0,0,,Aconteceu alguma coisa com você?
Dialogue: 0,0:34:42.85,0:34:44.74,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:42.97,0:34:44.59,Default,,0,0,0,,Esse seu rosto abatido...
Dialogue: 0,0:34:46.63,0:34:51.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:46.75,0:34:51.51,Default,,0,0,0,,Há alguns problemas com o trabalho, coisas que chateiam a gente.
Dialogue: 0,0:34:51.85,0:34:54.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:51.97,0:34:54.45,Default,,0,0,0,,Não tem a ver com a Ruma, né?
Dialogue: 0,0:34:57.10,0:34:59.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:34:57.22,0:34:59.34,Default,,0,0,0,,Tem alguma coisa nos carros com a qual eu deveria me preocupar?
Dialogue: 0,0:35:02.41,0:35:05.95,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:02.53,0:35:05.80,Default,,0,0,0,,Como vocês estão? O que está acontecendo?
Dialogue: 0,0:35:10.52,0:35:13.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:10.64,0:35:12.87,Default,,0,0,0,,O que você está fazendo com isso?
Dialogue: 0,0:35:13.25,0:35:15.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:13.37,0:35:15.75,Default,,0,0,0,,Estou indo para o vilarejo fazer um parto.
Dialogue: 0,0:35:16.42,0:35:17.57,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:16.54,0:35:17.42,Default,,0,0,0,,Eles pegaram o meu documento.
Dialogue: 0,0:35:18.17,0:35:21.32,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:18.29,0:35:21.16,Default,,0,0,0,,Kadir, ela precisa ir para o parto.
Dialogue: 0,0:35:22.13,0:35:24.16,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:22.25,0:35:24.01,Default,,0,0,0,,Verifiquem o documento dela logo, é urgente.
Dialogue: 0,0:35:24.31,0:35:27.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:24.43,0:35:27.05,Default,,0,0,0,,Senhor policial, a senhora é médica, por favor, nos dê passagem.
Dialogue: 0,0:35:27.01,0:35:28.22,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:27.13,0:35:28.07,Default,,0,0,0,,Vamos revistar os veículos.
Dialogue: 0,0:35:28.50,0:35:30.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:28.62,0:35:30.57,Default,,0,0,0,,Comandante, é uma situação muito urgente.
Dialogue: 0,0:35:30.75,0:35:33.60,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:30.87,0:35:33.45,Default,,0,0,0,,A senhora é médica, está a caminho do hospital.
Dialogue: 0,0:35:33.41,0:35:37.90,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:33.53,0:35:37.75,Default,,0,0,0,,Eu preciso seguir viagem. É uma questão de vida ou morte, não dá para esperar.
Dialogue: 0,0:35:37.71,0:35:42.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:37.83,0:35:41.94,Default,,0,0,0,,Doutora Alya, Doutora Alya, a sua bagagem está pronta.
Dialogue: 0,0:35:45.45,0:35:47.82,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:45.57,0:35:47.66,Default,,0,0,0,,Tá bom, muito obrigada.
Dialogue: 0,0:35:51.69,0:35:53.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:51.81,0:35:53.61,Default,,0,0,0,,Tüyam, tô indo.
Dialogue: 0,0:35:55.97,0:35:57.14,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:56.09,0:35:56.99,Default,,0,0,0,,Foi.
Dialogue: 0,0:35:56.95,0:35:59.02,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:57.07,0:35:58.87,Default,,0,0,0,,Dá, me dá.
Dialogue: 0,0:35:59.37,0:36:00.86,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:35:59.49,0:36:00.71,Default,,0,0,0,,Deixe ir, né?
Dialogue: 0,0:36:00.67,0:36:02.17,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:00.79,0:36:02.02,Default,,0,0,0,,Eu tô bem, tô bem. Vá.
Dialogue: 0,0:36:01.98,0:36:03.85,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:02.10,0:36:03.70,Default,,0,0,0,,Vá com cuidado.
Dialogue: 0,0:36:03.66,0:36:05.73,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:03.78,0:36:05.58,Default,,0,0,0,,Nos vemos à noite.
Dialogue: 0,0:36:30.87,0:36:33.49,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:30.99,0:36:33.34,Default,,0,0,0,,Estou bem melhor que antes.
Dialogue: 0,0:36:40.17,0:36:42.31,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:40.29,0:36:42.16,Default,,0,0,0,,O tratamento dele continuava no Canadá.
Dialogue: 0,0:36:42.12,0:36:43.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:42.24,0:36:43.46,Default,,0,0,0,,Se o meu trabalho acabou, fique à vontade.
Dialogue: 0,0:36:43.42,0:36:45.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:43.54,0:36:44.92,Default,,0,0,0,,Por que estão levando para Midyat?
Dialogue: 0,0:36:44.88,0:36:46.96,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:45.00,0:36:46.81,Default,,0,0,0,,A esposa dele está aqui.
Dialogue: 0,0:36:46.77,0:36:49.76,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:46.89,0:36:49.61,Default,,0,0,0,,A partir de agora, o tratamento dele continuará aqui.
Dialogue: 0,0:36:49.57,0:36:51.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:49.69,0:36:51.20,Default,,0,0,0,,Entendi, melhoras.
Dialogue: 0,0:36:51.16,0:36:52.66,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:51.28,0:36:52.51,Default,,0,0,0,,Valeu.
Dialogue: 0,0:36:52.47,0:36:53.56,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:52.59,0:36:53.41,Default,,0,0,0,,Que Deus te abençoe, obrigado.
Dialogue: 0,0:36:53.37,0:36:54.44,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:53.49,0:36:54.29,Default,,0,0,0,,A revista acabou?
Dialogue: 0,0:36:54.17,0:36:55.06,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:54.29,0:36:54.91,Default,,0,0,0,,Terminei, eu também terminei.
Dialogue: 0,0:36:55.40,0:36:56.47,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:55.52,0:36:56.32,Default,,0,0,0,,Vamos.
Dialogue: 0,0:36:55.74,0:36:56.35,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:55.86,0:36:56.20,Default,,0,0,0,,Obrigado.
Dialogue: 0,0:36:56.20,0:36:57.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:56.32,0:36:57.12,Default,,0,0,0,,Bom trabalho.
Dialogue: 0,0:36:56.96,0:36:58.33,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:57.08,0:36:58.18,Default,,0,0,0,,Bom trabalho.
Dialogue: 0,0:36:58.14,0:36:58.87,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:58.26,0:36:58.72,Default,,0,0,0,,Isso, agora sim.
Dialogue: 0,0:36:58.98,0:37:00.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:36:59.10,0:37:00.12,Default,,0,0,0,,Quem é o advogado, não importa quem seja?
Dialogue: 0,0:37:00.14,0:37:00.61,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:00.26,0:37:00.46,Default,,0,0,0,,Tá bom.
Dialogue: 0,0:37:00.70,0:37:01.20,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:00.82,0:37:01.05,Default,,0,0,0,,Vamos.
Dialogue: 0,0:37:01.27,0:37:02.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:01.39,0:37:02.24,Default,,0,0,0,,Vamos, entrem no carro.
Dialogue: 0,0:37:02.20,0:37:03.27,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:02.32,0:37:03.12,Default,,0,0,0,,Vamos lá.
Dialogue: 0,0:37:02.42,0:37:02.97,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:02.54,0:37:02.82,Default,,0,0,0,,Vamos.
Dialogue: 0,0:37:02.86,0:37:03.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:02.98,0:37:03.24,Default,,0,0,0,,Anda.
Dialogue: 0,0:37:04.23,0:37:05.39,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:04.35,0:37:05.24,Default,,0,0,0,,Quem é, hein?
Dialogue: 0,0:37:06.63,0:37:08.70,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:06.75,0:37:08.55,Default,,0,0,0,,Tá bom, meu irmão.
Dialogue: 0,0:37:22.16,0:37:24.72,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:22.28,0:37:24.57,Default,,0,0,0,,Para mim, é como respirar.
Dialogue: 0,0:37:30.72,0:37:33.07,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:30.84,0:37:32.92,Default,,0,0,0,,Quero meu fôlego de você.
Dialogue: 0,0:37:32.88,0:37:34.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:33.00,0:37:33.94,Default,,0,0,0,,Eu fico sem saber o que fazer.
Dialogue: 0,0:37:35.40,0:37:37.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:35.52,0:37:36.85,Default,,0,0,0,,Eu perco a cabeça.
Dialogue: 0,0:37:37.11,0:37:38.01,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:37.23,0:37:37.86,Default,,0,0,0,,Perde.
Dialogue: 0,0:37:41.93,0:37:44.00,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:42.05,0:37:43.85,Default,,0,0,0,,Sorria.
Dialogue: 0,0:37:46.76,0:37:47.83,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:46.88,0:37:47.68,Default,,0,0,0,,Sorria, vamos.
Dialogue: 0,0:37:47.38,0:37:48.09,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
Dialogue: 1,0:37:47.50,0:37:47.94,Default,,0,0,0,,Andem, vamos.
Dialogue: 0,0:38:03.51,0:38:05.58,Box,,0,0,0,,{\pos(0,0)\p1}m 120 555 l 1160 555 1160 695 120 695{\p0}
